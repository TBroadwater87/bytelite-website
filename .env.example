# Environment variable NAMES used by this website. Values live only in the Vercel project settings.
# Never put a real value in this file or anywhere in this repository.

# Contact form delivery (server, request time)
SENDGRID_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Commerce (server at request time and pages at build time). Unset means disabled.
COMMERCE_PHASE=
FOUNDER_OFFER_PHASE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_PORTAL_URL=
STRIPE_AUTOMATIC_TAX_ENABLED=
STRIPE_PRICE_BYTELITE_MONTHLY_FOUNDER=
STRIPE_PRICE_BYTELITE_ANNUAL_FOUNDER=
STRIPE_PRICE_CORDEL_CONNECT_MONTHLY_FOUNDER=
STRIPE_PRICE_CORDEL_CONNECT_ANNUAL_FOUNDER=
STRIPE_PRICE_FOUNDER_SUPPORTER_PACK=

# Stripe return URL origin. Leave unset or use https://www.thebytelite.com exactly.
PUBLIC_SITE_URL=

# Local test runs only: path to the owner's private disclosure denylist (never committed).
BYTELITE_DISCLOSURE_DENYLIST=
