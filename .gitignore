# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.vercel

# archived files
.archive/

# Playwright test run artifacts
/playwright-report/
/test-results/

# UI-state screenshots written by tests/e2e/deep-kore-console-flow.spec.ts. They are run
# evidence, regenerated on demand, and this repository is not an asset archive. They sit
# outside test-results/ because Playwright empties that at the start of every run - which
# once deleted a clean run's screenshots when the live suite started afterwards.
/screenshots/

# transient QA-sweep run artifacts (regenerated each run, not RC evidence)
qa/preview-stdout.log
qa/preview-stderr.log
qa/qa-sweep-results.json

# local Cloudflare Pages/Workers dev tooling state (wrangler pages dev, etc.)
.wrangler/

# Cloudflare Pages LOCAL secrets - never commit. Production values live only as encrypted
# Pages secrets (dashboard / `wrangler pages secret put`), never in the repository.
.dev.vars
.dev.vars.*
