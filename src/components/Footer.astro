---
import { FOOTER_GROUPS } from '../data/navigation';
import { COMPANY_NAME, COMPANY_LOCATION, COMPANY_ONE_LINE } from '../data/company';

const copyrightYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-identity">
      <p class="footer-name">{COMPANY_NAME}</p>
      <p class="small-print">{COMPANY_ONE_LINE}</p>
      <p class="small-print">{COMPANY_LOCATION}</p>
    </div>
    {FOOTER_GROUPS.map((group) => (
      <nav class="footer-group" aria-label={`${group.label} links`}>
        <p class="footer-group-heading">{group.label}</p>
        <ul>
          {group.links.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap">
    <p class="small-print footer-base">&copy; {copyrightYear} {COMPANY_NAME}. Research statements on this site describe objectives and internal evidence unless a page says otherwise.</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--color-line); background: var(--color-surface-sunken); }
  .footer-grid {
    display: grid; gap: var(--space-6); padding-block: var(--space-7);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
  }
  .footer-identity { display: grid; gap: var(--space-2); align-content: start; grid-column: 1 / -1; max-width: 32rem; }
  @media (min-width: 64rem) {
    .footer-grid { grid-template-columns: 1.6fr repeat(4, 1fr); }
    .footer-identity { grid-column: auto; }
  }
  .footer-name { font-weight: 700; color: var(--color-ink); }
  .footer-group-heading { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-subtle); margin-bottom: var(--space-3); }
  .footer-group ul { list-style: none; display: grid; gap: var(--space-2); }
  .footer-group a { color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); }
  .footer-group a:hover { color: var(--color-ink); text-decoration: underline; }
  .footer-base { border-top: 1px solid var(--color-line); padding-block: var(--space-5); }
</style>
