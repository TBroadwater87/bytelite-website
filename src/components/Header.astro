---
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
function sectionActive(hrefs: string[]) {
  return hrefs.some(isActive);
}

interface NavChild {
  label: string;
  href: string;
}
interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const NAV: NavItem[] = [
  {
    label: 'Technologies',
    href: '/technologies',
    children: [
      { label: 'Technology Overview', href: '/technologies' },
      { label: 'ByteLite', href: '/technologies/bytelite' },
      { label: 'ByteSight', href: '/technologies/bytesight' },
      { label: 'Deep Kore', href: '/technologies/deep-kore' },
      { label: 'AIya', href: '/technologies/deep-kore/aiya' },
      { label: 'Genesis Goalkeeper', href: '/technologies/deep-kore/genesis-goalkeeper' },
      { label: 'ByteOracle', href: '/technologies/byteoracle' },
      { label: 'ByteFlow', href: '/technologies/byteflow' },
      { label: 'ByteCost', href: '/technologies/bytecost' },
    ],
  },
  {
    label: 'Architecture',
    href: '/architecture',
  },
  {
    label: 'Cordel Play',
    href: '/products/cordel-play',
    children: [
      { label: 'Overview', href: '/products/cordel-play' },
      { label: 'How It Plays', href: '/products/cordel-play/how-it-plays' },
      { label: 'Editions', href: '/products/cordel-play/editions' },
      { label: 'Components', href: '/products/cordel-play/components' },
      { label: 'Consent Architecture', href: '/products/cordel-play/consent-architecture' },
      { label: 'Development Status', href: '/products/cordel-play/development-status' },
      { label: 'Preorder', href: '/products/cordel-play/preorder' },
    ],
  },
  {
    label: 'Cordel Connect',
    href: '/products/cordel-connect',
    children: [
      { label: 'Overview', href: '/products/cordel-connect' },
      { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
      { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
      { label: 'Safety', href: '/products/cordel-connect/safety' },
      { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
      { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
      { label: 'Games & Shared Activities', href: '/products/cordel-connect/games-and-shared-activities' },
      { label: 'ByteOracle Horoscopes', href: '/products/cordel-connect/byteoracle-horoscopes' },
      { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
    ],
  },
  {
    label: 'Progress',
    href: '/progress',
    children: [
      { label: 'Current Status', href: '/progress' },
      { label: 'Validation Evidence', href: '/progress/validation-evidence' },
      { label: 'Development Timeline', href: '/progress/development-timeline' },
      { label: 'Changelog', href: '/progress/changelog' },
    ],
  },
  {
    label: 'Preorder',
    href: '/preorder',
    children: [
      { label: 'All Eligible Products', href: '/preorder' },
      { label: 'Founder Benefits', href: '/preorder/founder-benefits' },
      { label: 'Preorder Terms', href: '/preorder/terms' },
      { label: 'Order Status', href: '/preorder/status' },
    ],
  },
  {
    label: 'Company',
    href: '/company',
    children: [
      { label: 'About ByteLite LLC', href: '/company' },
