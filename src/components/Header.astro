---

<header class="site-header">
  <nav class="container nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="ByteLite LLC home">
      <img src="/bytelite-logo.png" alt="ByteLite LLC" width="32" height="32" />
      <span class="nav-logo-text">ByteLite LLC</span>
    </a>

    <div class="nav-links" id="navLinks">
      {NAV.map((item) => (
        item.children ? (
          <details class="nav-dropdown" data-nav-dropdown>
            <summary
              class:list={['nav-link', 'nav-summary', { active: sectionActive(item.children.map(c => c.href).concat(item.href)) }]}
              aria-haspopup="true"
            >
              {item.label}
              <svg class="nav-caret" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </summary>
            <div class="nav-dropdown-panel" role="menu">
              {item.children.map((child) => (
                <a role="menuitem" href={child.href} class:list={['nav-dropdown-link', { active: isActive(child.href) }]}>{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
        )
      ))}
    </div>

    <a href="/contact" class="nav-contact-cta">Contact</a>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6" class="line-top" />
        <line x1="3" y1="12" x2="21" y2="12" class="line-mid" />
        <line x1="3" y1="18" x2="21" y2="18" class="line-bot" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  links?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
    links.classList.remove('nav-open');
    toggle?.setAttribute('aria-expanded', 'false');
  }));

  const dropdowns = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown]'));

  function closeAll(except?: HTMLDetailsElement) {
    dropdowns.forEach((d) => {
      if (d !== except) d.open = false;
    });
  }

  dropdowns.forEach((d) => {
    d.addEventListener('toggle', () => {
      if (d.open) closeAll(d);
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    const insideAny = dropdowns.some((d) => d.contains(target));
    if (!insideAny) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      links?.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
.site-header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(7,9,15,.94);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #1a2235;
}
.nav-inner {
  display: flex; align-items: center; justify-content: space-between;
  height: 4rem; gap: 1.25rem;
}
.nav-logo {
  display: flex; align-items: center; gap: .625rem; flex-shrink: 0;
}
.nav-logo img { border-radius: .25rem; }
.nav-logo-text {
  font-size: .9375rem; font-weight: 600; color: #e4e7f2;
  letter-spacing: -.01em; white-space: nowrap;
}
.nav-logo:hover .nav-logo-text { color: #818cf8; }
.nav-links {
  display: flex; align-items: center; gap: .125rem;
  flex: 1; min-width: 0;
}
.nav-link {
  display: flex; align-items: center; gap: .3rem;
  padding: .5rem .75rem;
  font-size: .8125rem; font-weight: 450; color: #7b829e;
  border-radius: .375rem; transition: color .15s, background .15s;
  white-space: nowrap; cursor: pointer; list-style: none;
}
.nav-link::-webkit-details-marker { display: none; }
.nav-link:hover { color: #e4e7f2; background: rgba(255,255,255,.04); }
.nav-link.active { color: #e4e7f2; }
.nav-caret { flex-shrink: 0; opacity: .6; transition: transform .15s; }
details[open] > .nav-summary .nav-caret { transform: rotate(180deg); }

.nav-dropdown { position: relative; }
.nav-dropdown-panel {
  position: absolute; top: calc(100% + .5rem); left: 0;
  min-width: 240px; max-width: 320px;
  background: #0d1120; border: 1px solid #1a2235; border-radius: .625rem;
  padding: .5rem; box-shadow: 0 12px 32px rgba(0,0,0,.5);
  display: flex; flex-direction: column; gap: .125rem;
  max-height: 70vh; overflow-y: auto;
}
.nav-dropdown-link {
  display: block; padding: .5rem .625rem; border-radius: .375rem;
  font-size: .8125rem; color: #a0a8c0; white-space: normal;
}
.nav-dropdown-link:hover { background: rgba(99,102,241,.1); color: #e4e7f2; }
.nav-dropdown-link.active { color: #818cf8; background: rgba(99,102,241,.08); }

.nav-contact-cta {
  flex-shrink: 0;
  padding: .5rem 1rem; font-size: .8125rem; font-weight: 600;
  background: rgba(99,102,241,.12); color: #818cf8;
  border: 1px solid rgba(99,102,241,.22); border-radius: .375rem;
  transition: background .15s, color .15s;
}
.nav-contact-cta:hover { background: #6366f1; color: #fff; }

.nav-toggle {
  display: none; background: none; border: none;
  color: #7b829e; padding: .375rem; border-radius: .375rem; flex-shrink: 0;
}
.nav-toggle:hover { color: #e4e7f2; background: rgba(255,255,255,.05); }

@media (max-width: 1100px) {
  .nav-links { display: none; }
  .nav-toggle { display: flex; align-items: center; justify-content: center; }
  .nav-links.nav-open {
    display: flex; flex-direction: column; align-items: stretch; gap: .125rem;
    position: absolute; top: 4rem; left: 0; right: 0;
    background: #0d1120; border-bottom: 1px solid #1a2235;
    padding: .75rem 1rem; max-height: calc(100vh - 4rem); overflow-y: auto;
  }
  .nav-links.nav-open .nav-link { padding: .75rem 1rem; font-size: 1rem; border-radius: .5rem; }
  .nav-links.nav-open .nav-dropdown-panel { position: static; box-shadow: none; margin: .25rem 0 .5rem .75rem; }
}
</style>
