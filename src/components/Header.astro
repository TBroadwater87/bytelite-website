---
import { PRIMARY_LINKS, RESEARCH_MENU } from '../data/navigation';

export interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const normalizedCurrentPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');

function isCurrentSection(href: string): boolean {
  if (href === '/') return normalizedCurrentPath === '/';
  return normalizedCurrentPath === href || normalizedCurrentPath.startsWith(`${href}/`);
}

const researchSectionIsCurrent = normalizedCurrentPath.startsWith('/research');
---

<header class="site-header" data-site-header>
  <div class="wrap header-bar">
    <a href="/" class="brand" aria-label="ByteLite LLC home">
      <img src="/bytelite-mark-64.png" alt="" width="32" height="32" />
      <span class="brand-name">ByteLite <span class="brand-suffix">LLC</span></span>
    </a>

    <button
      type="button"
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
    >
      <span class="menu-toggle-label">Menu</span>
    </button>

    <nav id="site-navigation" class="site-navigation" aria-label="Primary" data-site-navigation>
      <ul class="navigation-list">
        <li class="navigation-item navigation-item-group">
          <div class="group-heading">
            <a
              href="/research"
              class:list={['navigation-link', { 'is-current': researchSectionIsCurrent }]}
              aria-current={normalizedCurrentPath === '/research' ? 'page' : undefined}
            >{RESEARCH_MENU.label}</a>
            <button
              type="button"
              class="group-toggle"
              aria-expanded="false"
              aria-controls="research-menu"
              data-group-toggle
            >
              <span class="visually-hidden">Show research pages</span>
              <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </button>
          </div>
          <ul id="research-menu" class="group-menu" data-group-menu>
            {RESEARCH_MENU.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="group-menu-link"
                  aria-current={normalizedCurrentPath === link.href ? 'page' : undefined}
                >
                  <span class="group-menu-title">{link.label}</span>
                  {link.description && <span class="group-menu-description">{link.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </li>
        {PRIMARY_LINKS.map((link) => (
          <li class="navigation-item">
            <a
              href={link.href}
              class:list={['navigation-link', { 'is-current': isCurrentSection(link.href) }]}
              aria-current={normalizedCurrentPath === link.href ? 'page' : undefined}
            >{link.label}</a>
          </li>
        ))}
        <li class="navigation-item navigation-item-contact">
          <a href="/contact" class="button button-primary contact-button" aria-current={normalizedCurrentPath === '/contact' ? 'page' : undefined}>Contact</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menuToggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navigation = header?.querySelector<HTMLElement>('[data-site-navigation]');
  const groupToggle = header?.querySelector<HTMLButtonElement>('[data-group-toggle]');
  const groupMenu = header?.querySelector<HTMLElement>('[data-group-menu]');
  const menuToggleLabel = menuToggle?.querySelector<HTMLElement>('.menu-toggle-label');

  function setExpanded(control: HTMLButtonElement | null | undefined, expanded: boolean) {
    control?.setAttribute('aria-expanded', String(expanded));
  }

  function closeResearchMenu() {
    setExpanded(groupToggle, false);
  }

  function closeMobileMenu() {
    setExpanded(menuToggle, false);
    if (menuToggleLabel) menuToggleLabel.textContent = 'Menu';
    closeResearchMenu();
  }

  if (header && menuToggle && navigation && groupToggle && groupMenu) {
    header.dataset.enhanced = 'true';

    menuToggle.addEventListener('click', () => {
      const willOpen = menuToggle.getAttribute('aria-expanded') !== 'true';
      setExpanded(menuToggle, willOpen);
      if (menuToggleLabel) menuToggleLabel.textContent = willOpen ? 'Close' : 'Menu';
    });

    groupToggle.addEventListener('click', () => {
      const willOpen = groupToggle.getAttribute('aria-expanded') !== 'true';
      setExpanded(groupToggle, willOpen);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (groupToggle.getAttribute('aria-expanded') === 'true') {
        closeResearchMenu();
        groupToggle.focus();
      } else if (menuToggle.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
        menuToggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!groupMenu.parentElement?.contains(event.target)) closeResearchMenu();
      if (!header.contains(event.target)) closeMobileMenu();
    });

    groupMenu.parentElement?.addEventListener('focusout', (event) => {
      const nextFocus = event.relatedTarget;
      if (nextFocus instanceof Node && groupMenu.parentElement?.contains(nextFocus)) return;
      closeResearchMenu();
    });
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: color-mix(in srgb, var(--color-canvas) 94%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--color-line);
  }
  .header-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); min-height: 4rem; }
  .brand { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--color-ink); text-decoration: none; flex-shrink: 0; }
  .brand img { border-radius: var(--radius-sm); }
  .brand-name { font-weight: 700; letter-spacing: -0.01em; }
  .brand-suffix { font-weight: 500; color: var(--color-ink-subtle); }

  .menu-toggle { display: none; }
  .navigation-list { display: flex; align-items: center; gap: var(--space-1); list-style: none; }
  .navigation-item { position: relative; }
  .navigation-link {
    display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--space-3);
    color: var(--color-ink-muted); text-decoration: none; font-size: var(--text-sm); font-weight: 500; border-radius: var(--radius-md);
  }
  .navigation-link:hover { color: var(--color-ink); background: var(--color-surface-sunken); }
  .navigation-link.is-current { color: var(--color-ink); box-shadow: inset 0 -2px 0 var(--color-ink); border-radius: 0; }
  .group-heading { display: flex; align-items: center; }
  .group-toggle {
    display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; margin-left: calc(-1 * var(--space-2));
    background: none; border: 0; color: var(--color-ink-muted); cursor: pointer; border-radius: var(--radius-md);
  }
  .group-toggle:hover { color: var(--color-ink); background: var(--color-surface-sunken); }
  .group-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .group-menu {
    list-style: none; display: none;
    position: absolute; top: calc(100% + var(--space-1)); left: 0; width: 22rem;
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-raised); padding: var(--space-2);
  }
  .group-heading:has(.group-toggle[aria-expanded='true']) + .group-menu { display: grid; }
  .group-menu-link { display: grid; gap: 0.1rem; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md); text-decoration: none; }
  .group-menu-link:hover { background: var(--color-surface-sunken); }
  .group-menu-link[aria-current='page'] { background: var(--color-surface-sunken); }
  .group-menu-title { color: var(--color-ink); font-weight: 600; font-size: var(--text-sm); }
  .group-menu-description { color: var(--color-ink-subtle); font-size: var(--text-xs); }
  .navigation-item-contact { margin-left: var(--space-2); }
  .contact-button { min-height: 2.5rem; }

  @media (max-width: 63.99rem) {
    .header-bar { flex-wrap: wrap; }
    .site-header[data-enhanced='true'] .menu-toggle {
      display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 var(--space-4);
      background: var(--color-surface); border: 1px solid var(--color-input-border); border-radius: var(--radius-md);
      font: inherit; font-weight: 600; font-size: var(--text-sm); color: var(--color-ink); cursor: pointer;
    }
    .site-navigation { width: 100%; }
    .site-header[data-enhanced='true'] .site-navigation { display: none; }
    .site-header[data-enhanced='true']:has(.menu-toggle[aria-expanded='true']) .site-navigation { display: block; }
    .site-header:has(.menu-toggle[aria-expanded='true']) { background: var(--color-canvas); backdrop-filter: none; }
    .site-header:has(.menu-toggle[aria-expanded='true']) .site-navigation { max-height: calc(100dvh - 4rem); overflow-y: auto; overscroll-behavior: contain; }
    .navigation-list { flex-direction: column; align-items: stretch; gap: 0; padding-bottom: var(--space-4); }
    .navigation-link { width: 100%; padding: 0 var(--space-2); font-size: var(--text-base); }
    .navigation-link.is-current { box-shadow: inset 3px 0 0 var(--color-ink); padding-left: var(--space-3); }
    .group-heading { justify-content: space-between; }
    .group-menu { position: static; width: auto; box-shadow: none; border: 0; padding: 0 0 var(--space-2) var(--space-3); background: transparent; }
    .site-header:not([data-enhanced='true']) .group-menu { display: grid; }
    .navigation-item-contact { margin: var(--space-3) 0 0; }
    .contact-button { width: 100%; }
  }
</style>
