---
// Primary navigation. Flat, no dropdowns, no project-family menus.
//
// Rebuild 2026-08-26: ByteLite stays first and the technology pages come before the products,
// because the site's job is still to explain ByteLite. The retired route families are not
// "unlinked" any more - their source is deleted and they 301 or return 410. Nothing here can
// point at a page that no longer exists.
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}

const NAV = [
  { label: 'How It Works', href: '/how-it-works' },
  { label: 'Validation', href: '/validation' },
  { label: 'Licensing', href: '/licensing' },
  // Deep Kore sits with the technology entries and ahead of Founder Access, because
  // CLAUDE.md section 1 puts the technology pages before the product pages in every
  // navigation surface. The footer already grouped it that way; this row did not.
  { label: 'Deep Kore', href: '/deep-kore' },
  { label: 'Founder Access', href: '/founder-access' },
  { label: 'About', href: '/about' },
];
---

<header class="site-header">
  <nav class="container nav-inner" aria-label="Primary">
    <a href="/" class="nav-logo" aria-label="ByteLite home">
      <img src="/bytelite-logo.png" alt="" width="30" height="30" />
      <span class="nav-logo-text">ByteLite</span>
    </a>

    <div class="nav-links" id="navLinks">
      {NAV.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
      ))}
    </div>

    <a href="/contact" class="nav-contact-cta">Contact</a>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navLinks">
      <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('navToggle');
  const links = document.getElementById('navLinks');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('nav-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
  links?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      links.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      links?.classList.remove('nav-open');
      toggle?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
.site-header {
  position: sticky; top: 0; z-index: 100;
  background: rgba(7,9,15,.94);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid #1a2235;
}
.nav-inner { display: flex; align-items: center; justify-content: space-between; height: 4rem; gap: 1.25rem; }
.nav-logo { display: flex; align-items: center; gap: .625rem; flex-shrink: 0; }
.nav-logo img { border-radius: .25rem; }
.nav-logo-text { font-size: 1rem; font-weight: 700; color: #e4e7f2; letter-spacing: -.01em; white-space: nowrap; }
.nav-logo:hover .nav-logo-text { color: #818cf8; }
.nav-links { display: flex; align-items: center; gap: .25rem; flex: 1; justify-content: center; }
.nav-link {
  padding: .5rem .875rem; font-size: .875rem; font-weight: 450; color: #7b829e;
  border-radius: .375rem; transition: color .15s, background .15s; white-space: nowrap;
}
.nav-link:hover, .nav-link:focus-visible { color: #e4e7f2; background: rgba(255,255,255,.04); }
.nav-link.active { color: #e4e7f2; }
.nav-contact-cta {
  flex-shrink: 0; padding: .5rem 1.125rem; font-size: .875rem; font-weight: 600;
  background: rgba(99,102,241,.12); color: #818cf8;
  border: 1px solid rgba(99,102,241,.22); border-radius: .375rem;
  transition: background .15s, color .15s;
}
.nav-contact-cta:hover, .nav-contact-cta:focus-visible { background: #6366f1; color: #fff; }
.nav-toggle { display: none; background: none; border: none; color: #7b829e; padding: .375rem; border-radius: .375rem; flex-shrink: 0; }
.nav-toggle:hover { color: #e4e7f2; background: rgba(255,255,255,.05); }

/* 960px, not 860px and not 720px. This number moves with the ITEM COUNT, because the row has to
   be allowed to collapse before it can overflow.

   Measured history: at five items ("Founder Access", added 2026-08-26) the row was 791px of
   content inside a 768px viewport - a 23px overflow in Chromium, Firefox and Mobile Chrome - and
   860px fixed it. "Deep Kore" makes six, so the threshold moves again. Do not lower it to "look
   more desktop": the no-horizontal-overflow test decides this number, not taste. */
@media (max-width: 960px) {
  .nav-links { display: none; }
  .nav-toggle { display: flex; align-items: center; justify-content: center; }
  .nav-links.nav-open {
    display: flex; flex-direction: column; align-items: stretch; gap: .125rem;
    position: absolute; top: 4rem; left: 0; right: 0;
    background: #0d1120; border-bottom: 1px solid #1a2235;
    padding: .75rem 1rem; max-height: calc(100vh - 4rem); overflow-y: auto;
  }
  .nav-links.nav-open .nav-link { padding: .75rem 1rem; font-size: 1rem; border-radius: .5rem; }
}
</style>
