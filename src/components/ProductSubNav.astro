---
export interface SubNavItem {
  label: string;
  href: string;
}
export interface Props {
  items: SubNavItem[];
}
const { items } = Astro.props;
const currentPath = Astro.url.pathname;
function isActive(href: string) {
  return currentPath === href || currentPath === href + '/';
}
---

<nav class="psn" aria-label="Section pages">
  <div class="container psn-inner">
    {items.map((item) => (
      <a href={item.href} class:list={['psn-link', { active: isActive(item.href) }]}>{item.label}</a>
    ))}
  </div>
</nav>

<style>
.psn { border-bottom: 1px solid #1a2235; background: #0a0d16; overflow-x: auto; }
.psn-inner { display: flex; gap: .25rem; padding-top: .625rem; padding-bottom: .625rem; }
.psn-link {
  flex-shrink: 0; padding: .5rem .875rem; font-size: .8125rem; font-weight: 500;
  color: #7b829e; border-radius: .375rem; white-space: nowrap;
}
.psn-link:hover { color: #e4e7f2; background: rgba(255,255,255,.04); }
.psn-link.active { color: #e4e7f2; background: rgba(99,102,241,.12); }
</style>
