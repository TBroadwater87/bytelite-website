---
import type { ProjectRecord } from '../data/projects';

export interface Props {
  project: ProjectRecord;
}

const { project } = Astro.props;
---

<!-- Current Capabilities -->
<section class="section section-alt">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow">Current Capabilities</p>
    <h2 style="margin-bottom:1.5rem;">What exists today.</h2>
    {project.currentCapabilities.length > 0 ? (
      <div class="pd-capability-list">
        {project.currentCapabilities.map((cap) => (
          <div class="pd-capability">
            <span class="pd-evidence-tag" data-level={cap.evidence}>{cap.evidence}</span>
            <p>{cap.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <p class="pd-empty">No public capability claims exist yet for {project.name}. This is a planned or early-concept layer — see End-Game Functionality Goals below for the target design.</p>
    )}
  </div>
</section>

<!-- In Development -->
<section class="section">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow">In Development</p>
    <h2 style="margin-bottom:1.5rem;">Active work.</h2>
    {project.inDevelopment.length > 0 ? (
      <ul class="pd-list">
        {project.inDevelopment.map((item) => <li>{item}</li>)}
      </ul>
    ) : (
      <p class="pd-empty">No active development is currently disclosed for {project.name}.</p>
    )}
  </div>
</section>

<!-- End-Game Functionality Goals -->
<section class="section section-alt">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow">End-Game Functionality Goals</p>
    <h2 style="margin-bottom:1rem;">The target architecture — not the current system.</h2>
    <p style="margin-bottom:1.5rem;font-size:.9375rem;color:#555e7a;">Everything below describes what {project.name} is designed to become. It is not a claim that this exists today.</p>
    <ul class="pd-list">
      {project.endGame.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<!-- Validation and Evidence -->
<section class="section">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow">Validation and Evidence</p>
    <h2 style="margin-bottom:1.5rem;">Proof posture.</h2>
    <div class="pd-validation-box">
      <ul class="pd-list">
        {project.validation.map((statement) => <li>{statement.text}</li>)}
      </ul>
    </div>
    {project.claimRestrictions.length > 0 && (
      <div class="pd-not-grid">
        <h3 class="pd-not-heading">What this is not.</h3>
        {project.claimRestrictions.map((item) => (
          <div class="pd-not-item"><span class="pd-not-x">&#10005;</span>{item}</div>
        ))}
      </div>
    )}
  </div>
</section>

<!-- Integration -->
{(project.integrationReceives.length > 0 || project.integrationProduces.length > 0 || project.integrationConsumedBy.length > 0) && (
  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Integration</p>
      <h2 style="margin-bottom:1.5rem;">How it connects.</h2>
      <div class="pd-integration-grid">
        <div class="pd-integration-col">
          <h3>Receives</h3>
          {project.integrationReceives.length > 0 ? (
            <ul class="pd-list-sm">{project.integrationReceives.map((i) => <li>{i}</li>)}</ul>
          ) : <p class="pd-empty-sm">None disclosed.</p>}
        </div>
        <div class="pd-integration-col">
          <h3>Produces</h3>
          {project.integrationProduces.length > 0 ? (
            <ul class="pd-list-sm">{project.integrationProduces.map((i) => <li>{i}</li>)}</ul>
          ) : <p class="pd-empty-sm">None disclosed.</p>}
        </div>
        <div class="pd-integration-col">
          <h3>Consumed by</h3>
          {project.integrationConsumedBy.length > 0 ? (
            <ul class="pd-list-sm">{project.integrationConsumedBy.map((i) => <li>{i}</li>)}</ul>
          ) : <p class="pd-empty-sm">None disclosed.</p>}
        </div>
      </div>
    </div>
  </section>
)}

<!-- Availability -->
<section class="section">
  <div class="container" style="max-width:820px;">
    <p class="eyebrow">Availability and Commercial Access</p>
    <div class="pd-availability-box">
      <span class="pd-availability-value">{project.availability}</span>
      <span class="pd-availability-updated">Last reviewed: {project.lastValidated}</span>
    </div>
  </div>
</section>

<style>
.pd-capability-list { display: flex; flex-direction: column; gap: 1rem; }
.pd-capability { display: flex; gap: 1rem; align-items: baseline; flex-wrap: wrap; }
/* overflow-wrap: some capability text contains long unbreakable runs (e.g. a slash-separated
   lifecycle list) that otherwise force horizontal scroll at narrow widths. */
.pd-capability p { font-size: 1rem; color: #c4c8f0; margin: 0; flex: 1; min-width: 200px; overflow-wrap: anywhere; }
.pd-evidence-tag {
  font-size: .6875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
  padding: .25rem .625rem; border-radius: .375rem; flex-shrink: 0;
  background: rgba(52,211,153,.1); color: #34d399; border: 1px solid rgba(52,211,153,.22);
}
.pd-empty, .pd-empty-sm { color: #555e7a; font-size: .9375rem; font-style: italic; }
.pd-empty-sm { font-size: .8125rem; }
.pd-list { display: flex; flex-direction: column; gap: .75rem; list-style: none; padding: 0; margin: 0; }
.pd-list li { position: relative; padding-left: 1.5rem; font-size: 1rem; color: #a0a8c0; line-height: 1.7; overflow-wrap: anywhere; }
.pd-list li::before { content: "\2192"; position: absolute; left: 0; color: #6366f1; }
.pd-list-sm { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
.pd-list-sm li { font-size: .875rem; color: #a0a8c0; line-height: 1.6; }
.pd-validation-box { background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.75rem; margin-bottom: 1.75rem; }
.pd-not-grid { display: flex; flex-direction: column; gap: .625rem; }
.pd-not-heading { font-size: 1.125rem; color: #e4e7f2; margin-bottom: .875rem; }
.pd-not-item { display: flex; gap: .75rem; align-items: flex-start; font-size: .9375rem; color: #7b829e; line-height: 1.6; }
.pd-not-x { color: #f87171; flex-shrink: 0; margin-top: .05rem; }
.pd-integration-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 700px) { .pd-integration-grid { grid-template-columns: 1fr; } }
.pd-integration-col { background: #07090f; border: 1px solid #1a2235; border-radius: .625rem; padding: 1.25rem; }
.pd-integration-col h3 { font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6366f1; margin-bottom: .75rem; }
.pd-availability-box {
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .75rem;
  background: linear-gradient(135deg, rgba(99,102,241,.08) 0%, rgba(167,139,250,.05) 100%);
  border: 1px solid rgba(99,102,241,.25); border-radius: .75rem; padding: 1.5rem 1.75rem;
}
.pd-availability-value { font-size: 1.125rem; font-weight: 700; color: #c4c8f0; }
.pd-availability-updated { font-size: .8125rem; color: #555e7a; }
</style>
