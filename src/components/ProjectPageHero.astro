---
import StatusBadge from './StatusBadge.astro';
import type { ProjectRecord } from '../data/projects';

export interface Props {
  project: ProjectRecord;
  displayName?: string;
}

const { project, displayName } = Astro.props;
---

<section class="pph-hero" style={`--accent:${project.accentColor}`}>
  <div class="container">
    <p class="eyebrow">{project.category}</p>
    <h1>{displayName ?? project.name}</h1>
    <p class="pph-hero-sub">{project.shortDescription}</p>
    <div class="pph-hero-badges">
      <StatusBadge status={project.status} />
      <span class="pph-hero-avail">{project.availability}</span>
    </div>
  </div>
</section>

<style>
.pph-hero { padding: 4.5rem 0 3.5rem; border-top: 3px solid var(--accent); }
.pph-hero h1 { max-width: 680px; }
.pph-hero-sub { max-width: 640px; margin-top: 1rem; font-size: 1.0625rem; color: #a0a8c0; line-height: 1.75; }
.pph-hero-badges { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; }
.pph-hero-avail { font-size: .8125rem; color: #555e7a; }
</style>
