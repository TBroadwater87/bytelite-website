---
// Renders the current holiday/season Cordel Connect banner for a given character type
// (AIya solo, Aion solo, or the duo), computed at build time as the initial (no-JS-safe)
// image, then re-verified client-side against the visitor's own local date on mount - so a
// page built weeks ago still shows the right holiday today, and a visitor in a different
// timezone near a window boundary still sees the correct one.
import { getActiveBanner, type CharacterType } from '../data/seasonal';

interface Props {
  type?: CharacterType;
  class?: string;
  style?: string;
  loading?: 'eager' | 'lazy';
}

const { type = 'duo', class: className, style, loading = 'lazy' } = Astro.props;
const initial = getActiveBanner(type);
---

<img
  src={initial.imagePath}
  alt={initial.alt}
  data-seasonal-banner
  data-seasonal-type={type}
  class={className}
  style={style}
  loading={loading}
/>

<script>
  import { getActiveBanner, type CharacterType } from '../data/seasonal';

  document.querySelectorAll<HTMLImageElement>('[data-seasonal-banner]').forEach((img) => {
    const type = (img.dataset.seasonalType as CharacterType) || 'duo';
    const active = getActiveBanner(type);
    const resolved = new URL(active.imagePath, window.location.origin).pathname;
    if (!img.src.endsWith(resolved)) {
      img.src = active.imagePath;
      img.alt = active.alt;
    }
  });
</script>
