---
import type { ProjectStatus } from '../data/projects';

export interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;

// Canonical status vocabulary (August 1, 2026). "Preorder", "Paused", and
// "Completed" were dropped from ProjectStatus: unused by any current
// ProjectRecord, retained nowhere else in the codebase. Concept always renders
// muted gray (badge-none) regardless of category, per the canonical model.
const CLASS_MAP: Record<ProjectStatus, string> = {
  Concept: 'badge-none',
  'Functional Prototype': 'badge-planned',
  'Advanced Prototype': 'badge-planned',
  'Integrated Prototype': 'badge-planned',
  'Internal Validation': 'badge-research',
  'Private Alpha': 'badge-private',
  'Pilot Preparation': 'badge-prelaunch',
  'Private Pilot': 'badge-private',
  'Public Beta': 'badge-beta',
  Production: 'badge-active',
};

const cls = CLASS_MAP[status];
---

<span class:list={['badge', cls]}>{status}</span>
