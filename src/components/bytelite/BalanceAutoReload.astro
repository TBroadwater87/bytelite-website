---
// CORE VISUAL 07 - planned billing UX.
//
// PLANNED, not operational. No payment collection exists. The card is explicitly badged so it
// cannot be mistaken for a live account screen.
import { BALANCE_EXAMPLE } from '../../data/bytelite';

const money = (n: number) => '$' + n.toFixed(2);
const b = BALANCE_EXAMPLE;

const LOOP = [
  'Usage',
  'Verified savings measured',
  'ByteLite share deducted',
  'Balance checked',
  'Above minimum: continue. Below minimum: auto-reload.',
];
---

<figure class="bal" aria-labelledby="bal-caption">
  <p class="bal-planned"><span class="bal-dot" aria-hidden="true"></span>Planned billing model &mdash; not operational</p>

  <div class="bal-card">
    <p class="bal-card-title">ByteLite balance</p>
    <dl class="bal-rows">
      <div class="bal-row"><dt>Current balance</dt><dd class="bal-strong">{money(b.currentBalance)}</dd></div>
      <div class="bal-row"><dt>Minimum balance</dt><dd>{money(b.minimumBalance)}</dd></div>
      <div class="bal-row"><dt>Auto reload</dt><dd>{money(b.autoReload)}</dd></div>
    </dl>
    <p class="bal-period">Current period</p>
    <dl class="bal-rows">
      <div class="bal-row"><dt>Verified savings</dt><dd>{money(b.periodVerifiedSavings)}</dd></div>
      <div class="bal-row"><dt>Customer retains</dt><dd class="bal-good">{money(b.periodCustomerRetains)}</dd></div>
      <div class="bal-row"><dt>ByteLite fee</dt><dd>{money(b.periodByteLiteFee)}</dd></div>
    </dl>
  </div>

  <ol class="bal-loop">
    {LOOP.map((step, i) => (
      <li class="bal-step">
        <span class="bal-step-n" aria-hidden="true">{i + 1}</span>
        <span>{step}</span>
      </li>
    ))}
  </ol>

  <figcaption id="bal-caption" class="bal-caption">
    The intended model is a prepaid balance with a configurable minimum and auto-reload, where the
    ByteLite fee is taken from verified savings. Enterprise accounts would use invoice billing.
    None of this is live, and no payment method is collected anywhere on this site.
  </figcaption>
</figure>

<style>
.bal { margin: 0; background: #0d1120; border: 1px solid #1a2235; border-radius: .875rem; padding: 1.75rem; }
.bal-planned {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: #fbbf24; background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.3);
  border-radius: 9999px; padding: .25rem .75rem; margin-bottom: 1.25rem;
}
.bal-dot { width: .4rem; height: .4rem; border-radius: 50%; background: #fbbf24; flex-shrink: 0; }

.bal-card { background: #07090f; border: 1px solid #2a3350; border-radius: .625rem; padding: 1.25rem; }
.bal-card-title {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #818cf8; margin-bottom: .875rem;
}
.bal-rows { margin: 0; }
.bal-row { display: flex; justify-content: space-between; gap: 1rem; padding: .35rem 0; }
.bal-row dt { font-size: .875rem; color: #7b829e; }
.bal-row dd { margin: 0; font-family: ui-monospace, 'Courier New', monospace; font-size: .9375rem; color: #a0a8c0; }
.bal-strong { color: #e4e7f2 !important; font-size: 1.125rem !important; font-weight: 700; }
.bal-good { color: #34d399 !important; }
.bal-period {
  margin: 1rem 0 .5rem; padding-top: .875rem; border-top: 1px solid #1a2235;
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #7b829e;
}

.bal-loop { list-style: none; margin: 1.25rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .5rem; }
.bal-step {
  display: flex; align-items: baseline; gap: .75rem;
  font-size: .875rem; color: #a0a8c0; line-height: 1.6;
}
.bal-step-n {
  flex-shrink: 0; width: 1.375rem; height: 1.375rem; border-radius: 50%;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: .6875rem; font-weight: 700; color: #818cf8;
  background: rgba(99,102,241,.12); border: 1px solid rgba(99,102,241,.28);
}
.bal-caption {
  margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid #1a2235;
  font-size: .875rem; color: #7b829e; line-height: 1.7;
}
@media (max-width: 600px) { .bal { padding: 1.25rem; } }
</style>
