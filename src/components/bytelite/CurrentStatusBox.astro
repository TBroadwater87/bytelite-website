---
// CURRENT STATUS BOX - the honest "where we actually are" panel.
//
// Two columns, never one: what the repository evidence currently supports, and what the
// architecture still requires. State is carried by the column heading and by the marker's text
// alternative, so a reader who cannot distinguish the two colours still gets the distinction.
import {
  CURRENT_STAGE_HEADLINE,
  CURRENTLY,
  STILL_REQUIRED,
  BYTELITE_STATUS,
} from '../../data/bytelite';
---

<section class="cs" aria-labelledby="cs-heading">
  <header class="cs-head">
    <p class="cs-eyebrow">Current stage</p>
    <h2 id="cs-heading" class="cs-headline">{CURRENT_STAGE_HEADLINE}</h2>
    <p class="cs-status">Canonical project status: <strong>{BYTELITE_STATUS}</strong>. Everything below is internal to ByteLite LLC and has not been independently verified.</p>
  </header>

  <div class="cs-cols">
    <div class="cs-col cs-col-now">
      <h3 class="cs-col-head">Currently</h3>
      <ul class="cs-list">
        {CURRENTLY.map((item) => (
          <li>
            <span class="cs-mark cs-mark-done" aria-hidden="true"></span>
            <span class="cs-sr">In place:</span>
            <span class="cs-text">{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="cs-col cs-col-open">
      <h3 class="cs-col-head">Still required</h3>
      <ul class="cs-list">
        {STILL_REQUIRED.map((item) => (
          <li>
            <span class="cs-mark cs-mark-open" aria-hidden="true"></span>
            <span class="cs-sr">Not yet:</span>
            <span class="cs-text">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
.cs {
  background: #0d1120;
  border: 1px solid #1a2235;
  border-radius: .875rem;
  padding: 1.75rem;
}
.cs-eyebrow {
  font-size: .6875rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  color: #6366f1; margin-bottom: .5rem;
}
.cs-headline { font-size: 1.25rem; line-height: 1.3; color: #e4e7f2; margin: 0 0 .75rem; }
.cs-status { font-size: .875rem; color: #7b829e; line-height: 1.7; margin: 0; }
.cs-status strong { color: #a78bfa; }

.cs-cols {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
  margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid #1a2235;
}
@media (max-width: 720px) { .cs-cols { grid-template-columns: 1fr; gap: 1.5rem; } }

.cs-col-head {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  margin: 0 0 .875rem;
}
.cs-col-now .cs-col-head { color: #34d399; }
.cs-col-open .cs-col-head { color: #fbbf24; }

.cs-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: .625rem; }
.cs-list li { display: flex; align-items: flex-start; gap: .625rem; }
.cs-text { font-size: .875rem; color: #a0a8c0; line-height: 1.6; }

.cs-mark { flex-shrink: 0; width: .875rem; height: .875rem; margin-top: .2rem; border-radius: 50%; position: relative; }
.cs-mark-done { background: rgba(52,211,153,.14); border: 1px solid #34d399; }
.cs-mark-done::after {
  content: ""; position: absolute; left: .27rem; top: .1rem;
  width: .22rem; height: .45rem; border: solid #34d399; border-width: 0 1.5px 1.5px 0;
  transform: rotate(45deg);
}
.cs-mark-open { background: transparent; border: 1px solid #6b6030; }

/* Text alternative for the marker, available to assistive technology only. */
.cs-sr {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

@media (max-width: 600px) { .cs { padding: 1.25rem; } }
</style>
