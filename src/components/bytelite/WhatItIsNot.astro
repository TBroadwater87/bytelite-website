---
// GRAPHIC 6 - what ByteLite is not.
//
// A boundary, not an inventory of excluded techniques. Each card states a refusal; none states
// what ByteLite does instead. "ByteLite does not use X because it uses Y" would narrow the
// private design space, so no card is allowed to take that shape.
import { IS_NOT } from '../../data/bytelite';
---

<ul class="isnot" aria-label="What ByteLite is not">
  {IS_NOT.map((card) => (
    <li class="isnot-card">
      <span class="isnot-mark" aria-hidden="true"></span>
      <h3 class="isnot-head">{card.headline}</h3>
      <p class="isnot-body">{card.body}</p>
    </li>
  ))}
</ul>

<style>
.isnot {
  list-style: none; margin: 0; padding: 0;
  display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1rem;
}
.isnot-card {
  position: relative;
  background: #0d1120; border: 1px solid #1a2235; border-left: 3px solid #f87171;
  border-radius: .625rem; padding: 1.25rem 1.25rem 1.25rem 1.125rem;
}
.isnot-mark {
  display: block; width: 1rem; height: 1rem; margin-bottom: .625rem; position: relative;
}
.isnot-mark::before, .isnot-mark::after {
  content: ""; position: absolute; top: .45rem; left: 0; width: 1rem; height: 1.5px; background: #f87171;
}
.isnot-mark::before { transform: rotate(45deg); }
.isnot-mark::after { transform: rotate(-45deg); }
.isnot-head { font-size: .9375rem; color: #e4e7f2; margin: 0 0 .5rem; line-height: 1.35; }
.isnot-body { font-size: .8125rem; color: #7b829e; line-height: 1.65; margin: 0; }

@media (max-width: 480px) { .isnot { grid-template-columns: 1fr; } }
</style>
