---
// Current vs experimental vs research hypothesis, rendered from the canonical research data.
//
// Deliberately NOT a wide <table> in a horizontal scroller: on narrow viewports the three columns
// restack as labeled blocks inside one card per area, so nothing scrolls sideways. Every cell
// carries its own column label in text at all widths - visually hidden while the decorative
// header row is on screen - so the meaning never depends on position or on colour alone.
import { MATURITY_ROWS } from '../../data/research';

const COLUMN_TITLES = {
  implemented: 'Implemented / under validation',
  experimental: 'Experimental',
  hypothesis: 'Research hypothesis',
} as const;
---

<div class="mt-wrap">
  <div class="mt-head" aria-hidden="true">
    <span class="mt-head-area">Area</span>
    <span class="mt-head-cell mt-head-implemented">{COLUMN_TITLES.implemented}</span>
    <span class="mt-head-cell mt-head-experimental">{COLUMN_TITLES.experimental}</span>
    <span class="mt-head-cell mt-head-hypothesis">{COLUMN_TITLES.hypothesis}</span>
  </div>

  {MATURITY_ROWS.map((row) => (
    <div class="mt-row">
      <h3 class="mt-area">{row.area}</h3>

      <div class="mt-cell mt-cell-implemented">
        <span class="mt-cell-label">{COLUMN_TITLES.implemented}</span>
        {row.implemented ? (
          <p>{row.implemented}</p>
        ) : (
          <p class="mt-none">Nothing implemented. This area exists only as a hypothesis today.</p>
        )}
        {row.projects.length > 0 && (
          <p class="mt-source">
            Canonical status:
            {row.projects.map((project) => (
              <a href={project.routes[0]}>{project.name}</a>
            ))}
          </p>
        )}
      </div>

      <div class="mt-cell mt-cell-experimental">
        <span class="mt-cell-label">{COLUMN_TITLES.experimental}</span>
        {row.experimental ? <p>{row.experimental}</p> : <p class="mt-none">No experimental work in progress.</p>}
      </div>

      <div class="mt-cell mt-cell-hypothesis">
        <span class="mt-cell-label">{COLUMN_TITLES.hypothesis}</span>
        <p>{row.hypothesis}</p>
      </div>
    </div>
  ))}
</div>

<p class="mt-footnote">
  Only the first column describes anything that exists. The second describes work that is active
  and unproven. The third states a question the research is asking, and is not a capability claim
  of any kind. For project-level truth, read
  <a href="/progress">Current Status</a> and <a href="/progress/validation-evidence">Validation Evidence</a>.
</p>

<style>
.mt-wrap {
  border: 1px solid #1a2235;
  border-radius: .875rem;
  overflow: hidden;
  background: #0d1120;
}

.mt-head {
  display: grid;
  grid-template-columns: 1fr 1.4fr 1.2fr 1.4fr;
  gap: 1.25rem;
  padding: 1rem 1.5rem;
  background: #111828;
  border-bottom: 1px solid #1a2235;
}
.mt-head-area, .mt-head-cell {
  font-size: .6875rem;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
}
.mt-head-area { color: #4a5068; }
.mt-head-implemented { color: #34d399; }
.mt-head-experimental { color: #fbbf24; }
.mt-head-hypothesis { color: #a78bfa; }

.mt-row {
  display: grid;
  grid-template-columns: 1fr 1.4fr 1.2fr 1.4fr;
  gap: 1.25rem;
  padding: 1.5rem;
  border-bottom: 1px solid #1a2235;
}
.mt-row:last-of-type { border-bottom: none; }

.mt-area {
  font-size: .9375rem;
  font-weight: 600;
  color: #e4e7f2;
  margin: 0;
  line-height: 1.45;
}
.mt-cell p { font-size: .875rem; color: #a0a8c0; line-height: 1.65; margin: 0; }
.mt-cell p.mt-none { color: #555e7a; font-style: italic; }
.mt-cell p.mt-source { margin-top: .625rem; font-size: .75rem; color: #555e7a; }
.mt-source a { color: #818cf8; margin-left: .375rem; }
.mt-source a:hover, .mt-source a:focus-visible { color: #a5b4fc; }

/* Present for assistive technology at every width; shown on screen once the decorative
   header row is dropped. */
.mt-cell-label {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  clip-path: inset(50%);
  white-space: nowrap;
}

@media (max-width: 900px) {
  .mt-head { display: none; }
  .mt-row { grid-template-columns: 1fr; gap: 1rem; }
  .mt-cell {
    border-left: 2px solid #1a2235;
    padding-left: .875rem;
  }
  .mt-cell-implemented { border-left-color: #34d399; }
  .mt-cell-experimental { border-left-color: #fbbf24; }
  .mt-cell-hypothesis { border-left-color: #a78bfa; }
  .mt-cell-label {
    position: static;
    width: auto; height: auto;
    margin: 0 0 .375rem;
    overflow: visible;
    clip: auto;
    clip-path: none;
    display: block;
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    white-space: normal;
  }
  .mt-cell-implemented .mt-cell-label { color: #34d399; }
  .mt-cell-experimental .mt-cell-label { color: #fbbf24; }
  .mt-cell-hypothesis .mt-cell-label { color: #a78bfa; }
}

.mt-footnote {
  margin-top: 1.25rem;
  font-size: .875rem;
  color: #7b829e;
  line-height: 1.7;
}
.mt-footnote a { color: #818cf8; }
.mt-footnote a:hover, .mt-footnote a:focus-visible { color: #a5b4fc; }

@media print {
  .mt-wrap { background: none; }
  .mt-head { background: none; }
  .mt-row { break-inside: avoid; }
  .mt-cell p, .mt-area { color: #000; }
}
</style>
