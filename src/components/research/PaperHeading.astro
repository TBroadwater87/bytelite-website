---
// A numbered section heading for the research paper. Section id, number, and title all come from
// the paper's single SECTION map, so the table of contents and the anchors it links to cannot
// drift apart.
export interface PaperSection {
  id: string;
  number: number;
  title: string;
}

export interface Props {
  section: PaperSection;
}

const { section } = Astro.props;
---

<h2 id={section.id} class="ph-heading">
  <span class="ph-number" aria-hidden="true">{String(section.number).padStart(2, '0')}</span>
  <span class="ph-title">{section.title}</span>
</h2>

<style>
.ph-heading {
  display: flex;
  align-items: baseline;
  gap: .875rem;
  font-size: clamp(1.25rem, 2.2vw, 1.625rem);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -.015em;
  color: #e4e7f2;
  scroll-margin-top: 5.5rem;
  margin-bottom: 1.25rem;
  padding-bottom: .75rem;
  border-bottom: 1px solid #1a2235;
}
.ph-number {
  flex-shrink: 0;
  font-family: ui-monospace, 'Courier New', monospace;
  font-size: .8125rem;
  font-weight: 700;
  color: #6366f1;
}
.ph-title { min-width: 0; }

@media print {
  .ph-heading { color: #000; border-bottom-color: #999; break-after: avoid; }
  .ph-number { color: #333; }
}
</style>
