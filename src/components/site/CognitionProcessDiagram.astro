---
import ClassifiedFigure from './ClassifiedFigure.astro';
import StatusBadge from './StatusBadge.astro';
import type { EvidenceStatus } from '../../data/evidence-status';

interface IntendedOutcome {
  title: string;
  intent: string;
  today: string;
  status: EvidenceStatus;
}

const INTENDED_OUTCOMES: readonly IntendedOutcome[] = [
  {
    title: 'A question or task is received',
    intent: 'The request is handled under governance from the start.',
    today: 'Governed request handling passes internal tests. Complete governance has not been demonstrated.',
    status: 'internally-tested',
  },
  {
    title: 'The concepts and relationships involved are determined',
    intent: 'The system works out what the request is about.',
    today: 'Not yet demonstrated.',
    status: 'not-yet-demonstrated',
  },
  {
    title: 'Established knowledge is consulted',
    intent: 'Justified relationships are distinguished from missing or ambiguous ones.',
    today: 'Not yet demonstrated.',
    status: 'not-yet-demonstrated',
  },
  {
    title: 'What is still needed is identified',
    intent: 'The system states which additional knowledge the task requires.',
    today: 'Basic "I do not know" reporting exists. Precise reports are not yet demonstrated.',
    status: 'not-yet-demonstrated',
  },
  {
    title: 'A governed response is produced',
    intent: 'The response is supported by established evidence.',
    today: 'Not yet demonstrated end to end.',
    status: 'not-yet-demonstrated',
  },
];
---

<ClassifiedFigure
  classification="Conceptual illustration"
  caption="The intended outcome of each stage, in plain language. It does not describe how any stage works, and it is not a screenshot of a working capability."
>
  <ol class="process">
    {INTENDED_OUTCOMES.map((outcome, index) => (
      <li class="process-step">
        <span class="process-number" aria-hidden="true">{index + 1}</span>
        <div class="process-body">
          <h3 class="process-title">{outcome.title}</h3>
          <p>{outcome.intent}</p>
          <p class="process-today"><StatusBadge status={outcome.status} /> <span>{outcome.today}</span></p>
        </div>
      </li>
    ))}
  </ol>
</ClassifiedFigure>

<style>
  .process { list-style: none; display: grid; gap: 0; }
  .process-step { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: var(--space-4); position: relative; padding-bottom: var(--space-5); }
  .process-step:last-child { padding-bottom: 0; }
  .process-step:not(:last-child)::before {
    content: ''; position: absolute; left: calc(1.125rem - 1px); top: 2.25rem; bottom: 0; width: 2px; background: var(--color-line);
  }
  .process-number {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 50%;
    border: 1px solid var(--color-line-strong); background: var(--color-canvas);
    font-family: var(--font-mono); font-weight: 700; color: var(--color-ink);
  }
  .process-body { display: grid; gap: var(--space-2); padding-top: 0.35rem; }
  .process-title { font-size: var(--text-base); font-family: var(--font-text); }
  .process-today { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: baseline; font-size: var(--text-sm); }
</style>
