---
import ClassifiedFigure from './ClassifiedFigure.astro';
import StatusBadge from './StatusBadge.astro';
import type { EvidenceStatus } from '../../data/evidence-status';

interface IntendedOutcome {
  title: string;
  intent: string;
  status: EvidenceStatus;
}

const INTENDED_OUTCOMES: readonly IntendedOutcome[] = [
  { title: 'Receive', intent: 'The request enters a governed path.', status: 'internally-tested' },
  { title: 'Understand', intent: 'Work out the concepts and how they relate.', status: 'implemented-unverified' },
  { title: 'Consult', intent: 'Match them against established knowledge.', status: 'not-yet-demonstrated' },
  { title: 'Find gaps', intent: 'State exactly what knowledge is missing.', status: 'not-yet-demonstrated' },
  { title: 'Answer', intent: 'Respond only with what the evidence supports.', status: 'not-yet-demonstrated' },
];
---

<ClassifiedFigure
  classification="Conceptual illustration"
  caption="The intended path of every request, with where each stage stands today. It shows outcomes, not how any stage works."
>
  <ol class="process">
    {INTENDED_OUTCOMES.map((outcome, index) => (
      <li class="process-step">
        <span class="process-number" aria-hidden="true">{index + 1}</span>
        <h3 class="process-title">{outcome.title}</h3>
        <p class="process-intent">{outcome.intent}</p>
        <StatusBadge status={outcome.status} />
      </li>
    ))}
  </ol>
</ClassifiedFigure>

<style>
  .process { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); counter-reset: none; }
  .process-step { display: grid; gap: var(--space-2); align-content: start; justify-items: start; padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-canvas); }
  .process-number { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-ink); color: var(--color-canvas); font-family: var(--font-mono); font-weight: 700; font-size: var(--text-sm); }
  .process-title { font-size: var(--text-lg); }
  .process-intent { font-size: var(--text-sm); }
</style>
