---
import StatusBadge from './StatusBadge.astro';
import StageTrack from './StageTrack.astro';
import { EVIDENCE_SCOPE_LABEL } from '../../data/evidence-status';
import type { PublicMilestone } from '../../data/milestones';

export interface Props {
  milestone: PublicMilestone;
  headingLevel?: 'h3' | 'h4';
}

const { milestone, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="milestone" id={milestone.id} data-program={milestone.programId} data-status={milestone.status}>
  <header class="milestone-header">
    <Heading class="milestone-title">{milestone.title}</Heading>
    <StatusBadge status={milestone.status} />
  </header>
  <p>{milestone.explanation}</p>
  <StageTrack status={milestone.status} label={`${milestone.title} stage`} />
  <div class="milestone-columns">
    <div>
      <p class="milestone-label">Demonstrated</p>
      <ul class={milestone.evidenceScope === 'none' ? 'fact-list fact-list-plain' : 'fact-list fact-list-yes'}>
        {milestone.demonstrated.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div>
      <p class="milestone-label">Not demonstrated</p>
      <ul class="fact-list fact-list-no">
        {milestone.notDemonstrated.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
  <dl class="milestone-facts">
    <div><dt>Next observable result</dt><dd>{milestone.nextObservableResult}</dd></div>
    <div><dt>Evidence</dt><dd>{EVIDENCE_SCOPE_LABEL[milestone.evidenceScope]}</dd></div>
    {milestone.limitations.length > 0 && (
      <div><dt>Limitations</dt><dd>{milestone.limitations.join(' ')}</dd></div>
    )}
    <div><dt>Last reviewed</dt><dd><time datetime={milestone.lastReviewed}>{milestone.lastReviewed}</time></dd></div>
  </dl>
</article>

<style>
  .milestone {
    display: grid; gap: var(--space-4); padding: var(--space-5);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg);
  }
  .milestone-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
  .milestone-title { font-size: var(--text-lg); font-family: var(--font-text); font-weight: 600; }
  .milestone-columns { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .milestone-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-subtle); margin-bottom: var(--space-2); }
  .milestone-facts { display: grid; gap: var(--space-2) var(--space-5); margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--color-line); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); font-size: var(--text-sm); }
  .milestone-facts dt { font-weight: 600; color: var(--color-ink); }
  .milestone-facts dd { margin: 0; color: var(--color-ink-muted); }
</style>
