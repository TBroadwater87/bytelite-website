---
export interface Props {
  eyebrow: string;
  heading: string;
  lede?: string;
}

const { eyebrow, heading, lede } = Astro.props;
---

<section class="page-intro">
  <div class="wrap">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-intro { padding-block: var(--space-8) var(--space-7); border-bottom: 1px solid var(--color-line); }
  .page-intro .wrap { display: grid; gap: var(--space-4); }
  .page-intro h1 { max-width: 22ch; }
  @media (max-width: 47.99rem) { .page-intro { padding-block: var(--space-7) var(--space-6); } }
</style>
