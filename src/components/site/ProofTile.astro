---
import type { EstablishedCapability } from '../../data/established-capabilities';

export interface Props {
  capability: EstablishedCapability;
}

const { capability } = Astro.props;
---

<li class="proof-tile">
  <p class="proof-figure">{capability.figure}</p>
  <p class="proof-figure-unit">{capability.figureUnit}</p>
  <h3 class="proof-headline">{capability.headline}</h3>
  <p class="proof-statement">{capability.statement}</p>
  <p class="proof-scope">{capability.scope}</p>
</li>

<style>
  .proof-tile {
    display: grid; gap: var(--space-2); align-content: start; padding: var(--space-5);
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg);
  }
  .proof-figure { font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem); white-space: nowrap; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--color-ink); font-variant-numeric: tabular-nums; }
  .proof-figure-unit { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--tone-tested-ink); }
  .proof-headline { font-size: var(--text-base); margin-top: var(--space-2); }
  .proof-statement { font-size: var(--text-sm); }
  .proof-scope { font-size: var(--text-xs); color: var(--color-ink-subtle); }
</style>
