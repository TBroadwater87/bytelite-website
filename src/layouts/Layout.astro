---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import {
  COMPANY_NAME,
  COMPANY_LOCALITY,
  COMPANY_REGION,
  COMPANY_COUNTRY,
  LEGAL_FORMATION_YEAR,
  SITE_ORIGIN,
} from '../data/company';

export interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  socialImage?: SocialImage;
}

interface SocialImage {
  path: string;
  widthPx: number;
  heightPx: number;
}

const DEFAULT_SOCIAL_IMAGE: SocialImage = { path: '/og-default.jpg', widthPx: 1200, heightPx: 630 };
const LIGHT_CANVAS_THEME_COLOR = '#fafaf8';
const DARK_CANVAS_THEME_COLOR = '#0f1013';

const { title, description, path, noindex = false, socialImage = DEFAULT_SOCIAL_IMAGE } = Astro.props;

const canonicalUrl = path === '/' ? `${SITE_ORIGIN}/` : `${SITE_ORIGIN}${path.replace(/\/$/, '')}`;
const socialImageUrl = new URL(socialImage.path, SITE_ORIGIN).href;

const organizationStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: COMPANY_NAME,
  url: `${SITE_ORIGIN}/`,
  logo: `${SITE_ORIGIN}/bytelite-mark-256.png`,
  foundingDate: LEGAL_FORMATION_YEAR,
  address: {
    '@type': 'PostalAddress',
    addressLocality: COMPANY_LOCALITY,
    addressRegion: COMPANY_REGION,
    addressCountry: COMPANY_COUNTRY,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content={String(socialImage.widthPx)} />
    <meta property="og:image:height" content={String(socialImage.heightPx)} />
    <meta property="og:site_name" content={COMPANY_NAME} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <link rel="icon" href="/bytelite-mark-64.png" type="image/png" sizes="64x64" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={LIGHT_CANVAS_THEME_COLOR} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={DARK_CANVAS_THEME_COLOR} media="(prefers-color-scheme: dark)" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationStructuredData)} />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
