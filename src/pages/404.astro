---
import Layout from '../layouts/Layout.astro';
import { COMPANY_NAME } from '../data/company';
---

<Layout
  title={`Page not found | ${COMPANY_NAME}`}
  description="The requested page does not exist on the ByteLite LLC website."
  path="/404"
  noindex={true}
>
  <section class="not-found">
    <div class="wrap wrap-narrow prose">
      <p class="eyebrow">Error 404</p>
      <h1>This page does not exist.</h1>
      <p>It may have moved when the website was reorganised. These pages are the best places to start:</p>
      <ul class="fact-list fact-list-plain">
        <li><a href="/">Home</a></li>
        <li><a href="/research">Research</a></li>
        <li><a href="/research/milestones">Research milestones</a></li>
        <li><a href="/products">Products</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .not-found { padding-block: var(--space-9); }
</style>
