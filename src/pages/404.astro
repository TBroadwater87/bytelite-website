---
import Layout from '../layouts/Layout.astro';
---

{/* noindex, and no canonical of its own. Vercel serves this body with a 404 status, which is
    already enough for a crawler - but the page is also reachable at /404/ as an ordinary 200, and
    at that URL a self-canonical would invite indexing a dead end. */}
<Layout
  title="Page Not Found"
  description="Page not found. Return to the ByteLite LLC homepage."
  noindex={true}
>
  <section class="error-page">
    <div class="container">
      <h1>404</h1>
      <p>Page not found</p>
      <a href="/" class="btn btn-primary">Back to Home</a>
    </div>
  </section>
</Layout>

<style>
  .error-page {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .error-page h1 {
    font-size: 6rem;
    background: var(--gradient-accent);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .error-page p {
    font-size: 1.5rem;
    color: var(--color-text-muted);
    margin: 1rem 0 2rem;
  }
</style>

