---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import {
  COMPANY_NAME,
  COMPANY_LOCATION,
  COMPANY_STRUCTURE,
  FOUNDER_NAME,
  RESEARCH_BEGAN_YEAR,
  LEGAL_FORMATION_YEAR,
  RESEARCH_AND_FORMATION_SENTENCE,
} from '../data/company';
import { RESEARCH_PROGRAMS } from '../data/research-programs';
---

<Layout
  title={`About | ${COMPANY_NAME}`}
  description="ByteLite LLC is a founder-led, independent computing research and development company in Helena, Montana, working on data representation, machine cognition and related products."
  path="/about"
>
  <PageIntro
    eyebrow="Company"
    heading={COMPANY_NAME}
    lede={`An independent, founder-led computing research and development company in ${COMPANY_LOCATION}. ${RESEARCH_AND_FORMATION_SENTENCE}`}
  />

  <section class="section" aria-labelledby="work-heading">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">The work</p>
        <h2 id="work-heading">Research first, products second.</h2>
        <p>
          {COMPANY_NAME} began with research into deterministic, lossless data representation, the
          original ByteLite program. Its work now spans several connected areas:
        </p>
        <ul class="fact-list fact-list-plain">
          {RESEARCH_PROGRAMS.map((program) => (
            <li><a href={program.href}>{program.name}</a>: {program.summary}</li>
          ))}
          <li><a href="/products">Consumer products</a>, developed separately from the research and described with their real availability.</li>
        </ul>
      </div>
      <div class="prose">
        <p class="eyebrow">How claims are made</p>
        <h2>Proof before claim.</h2>
        <p>
          A result is stated only at the strength its evidence supports. Internal tests are called
          internal tests. Objectives are called objectives. Nothing on this website has been
          independently verified, and the site says so wherever it matters.
        </p>
        <p>
          Every research milestone status comes from a single milestone record, and it changes only
          through an approved evidence update. The definitions are on the
          <a href="/research/milestones#status-definitions">milestones page</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="facts-heading">
    <div class="wrap">
      <h2 id="facts-heading" class="visually-hidden">Company facts</h2>
      <dl class="company-facts">
        <div><dt>Company</dt><dd>{COMPANY_NAME}</dd></div>
        <div><dt>Location</dt><dd>{COMPANY_LOCATION}</dd></div>
        <div><dt>Structure</dt><dd>{COMPANY_STRUCTURE}</dd></div>
        <div><dt>Founder</dt><dd>{FOUNDER_NAME}</dd></div>
        <div><dt>Research began</dt><dd>{RESEARCH_BEGAN_YEAR}</dd></div>
        <div><dt>LLC formed</dt><dd>{LEGAL_FORMATION_YEAR}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-heading">
    <div class="wrap wrap-narrow">
      <h2 id="founder-heading" class="visually-hidden">A note from the founder</h2>
      <blockquote class="founder">
        <p class="eyebrow">A note from {FOUNDER_NAME}</p>
        <p>
          I am Tash Broadwater. I am building ByteLite in Helena, Montana. There is no hidden
          engineering department and no marketing team allowed to turn an unfinished result into a
          finished claim. I am responsible for what this site says, and I can be asked about it
          directly.
        </p>
        <p>If a result fails, it stays failed until the code proves otherwise.</p>
        <footer>{FOUNDER_NAME}, founder, {COMPANY_NAME}</footer>
      </blockquote>
      <div class="button-row founder-actions">
        <a class="button button-primary" href="/contact">Contact {COMPANY_NAME}</a>
        <a class="button button-secondary" href="/validation">How evidence is classified</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .company-facts { display: grid; gap: var(--space-4); margin: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .company-facts dt { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-subtle); }
  .company-facts dd { margin: var(--space-1) 0 0; color: var(--color-ink); font-weight: 600; }
  .founder { margin: 0; display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-line); border-left: 4px solid var(--color-ink); border-radius: var(--radius-lg); }
  .founder p:not(.eyebrow) { font-family: var(--font-display); font-size: var(--text-lg); color: var(--color-ink); line-height: 1.5; }
  .founder footer { font-size: var(--text-sm); color: var(--color-ink-subtle); }
  .founder-actions { margin-top: var(--space-5); }
</style>
