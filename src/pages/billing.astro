---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { CUSTOMER_PORTAL_URL } from '../data/commerce';
import { COMPANY_NAME } from '../data/company';

const customerPortalConfigured = CUSTOMER_PORTAL_URL.length > 0;
---

<Layout
  title={`Billing | ${COMPANY_NAME}`}
  description="Manage billing for a ByteLite LLC subscription through Stripe's hosted customer portal."
  path="/billing"
  noindex={true}
>
  <PageIntro eyebrow="Billing" heading="Billing." />

  <section class="section">
    <div class="wrap wrap-narrow prose">
      {customerPortalConfigured ? (
        <>
          <p>
            Payment methods, invoices and cancellation are handled in Stripe's hosted customer
            portal. Stripe asks for the email address used at checkout and sends a sign-in link to
            it, which is how it confirms the account is yours.
          </p>
          <div class="button-row">
            <a href={CUSTOMER_PORTAL_URL} class="button button-primary" rel="noopener">Open the Stripe customer portal</a>
          </div>
        </>
      ) : (
        <p>
          There is no billing to manage. No subscription can be started on this website and nothing
          has been charged, so the billing portal is not configured. If you believe {COMPANY_NAME} has
          billed you, <a href="/contact">contact the company</a>.
        </p>
      )}
      <h2>Cancelling.</h2>
      <p>
        If subscriptions are ever offered, cancellation will be a single action in the Stripe portal,
        with no retention steps.
      </p>
    </div>
  </section>
</Layout>
