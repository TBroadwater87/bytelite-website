---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import { COMPANY_NAME } from '../../data/company';
---

<Layout
  title={`Checkout cancelled | ${COMPANY_NAME}`}
  description="This ByteLite LLC checkout was not completed and nothing was created."
  path="/checkout/cancel"
  noindex={true}
>
  <PageIntro
    eyebrow="Checkout"
    heading="Nothing happened."
    lede="Checkout was left before it completed. No payment was taken, no payment method was stored, and no subscription or reservation was created."
  />
  <section class="section">
    <div class="wrap wrap-narrow prose">
      <div class="button-row">
        <a href="/founder-access" class="button button-secondary">Back to founder access</a>
        <a href="/contact" class="button button-secondary">Report a problem</a>
      </div>
    </div>
  </section>
</Layout>
