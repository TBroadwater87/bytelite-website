---
import Layout from '../../layouts/Layout.astro';
import { COMPANY_NAME } from '../../data/company';
---

<Layout
  title={`Checkout status | ${COMPANY_NAME}`}
  description="Confirmation page for a ByteLite LLC checkout. It confirms nothing until the payment provider does."
  path="/checkout/success"
  noindex={true}
>
  <section class="page-intro-plain">
    <div class="wrap wrap-narrow prose">
      <p class="eyebrow">Checkout</p>
      <h1 id="checkout-heading">Checking your order&hellip;</h1>
      <p class="lede" id="checkout-body" role="status" aria-live="polite">One moment while this is confirmed with the payment provider.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow prose">
      <div id="checkout-detail" hidden>
        <dl class="checkout-facts">
          <div><dt>Item</dt><dd id="checkout-plan">&mdash;</dd></div>
          <div><dt>Type</dt><dd id="checkout-kind">&mdash;</dd></div>
        </dl>
      </div>
      <div id="checkout-reward" hidden>
        <h2>Your Founder Supporter Pack.</h2>
        <p>The payment was confirmed with Stripe on the server. {COMPANY_NAME} will contact you about delivery of the reward items.</p>
      </div>
      <div id="checkout-failure" hidden>
        <h2>If you believe you were charged</h2>
        <p>
          Nothing has been unlocked. If you
          believe you were charged, <a href="/contact">contact {COMPANY_NAME}</a> with the date and time.
          Never send card details.
        </p>
      </div>
      <div class="button-row">
        <a href="/founder-access" class="button button-secondary">Founder access</a>
        <a href="/contact" class="button button-secondary">Contact</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const checkoutSessionId = new URLSearchParams(window.location.search).get('session_id') ?? '';
  const heading = document.getElementById('checkout-heading');
  const body = document.getElementById('checkout-body');
  const detail = document.getElementById('checkout-detail');
  const reward = document.getElementById('checkout-reward');
  const failure = document.getElementById('checkout-failure');

  function showFailure(message: string) {
    if (heading) heading.textContent = 'Not confirmed.';
    if (body) body.textContent = message;
    if (failure) failure.hidden = false;
  }

  async function verifyCheckoutSession() {
    if (!checkoutSessionId) {
      showFailure('This page was opened without a checkout reference, so there is nothing to confirm.');
      return;
    }
    try {
      const response = await fetch(`/api/checkout-session?session_id=${encodeURIComponent(checkoutSessionId)}`);
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.confirmed) {
        showFailure('This checkout could not be confirmed.');
        return;
      }
      const isReservation = result.kind === 'reservation';
      const isSubscription = result.mode === 'subscription';
      if (heading) heading.textContent = isReservation ? 'Reservation recorded.' : isSubscription ? 'Subscription started.' : 'Payment received.';
      if (body) {
        body.textContent = isReservation
          ? 'Nothing was charged, and this is not a subscription. You will be shown the exact price and terms before anything is ever charged, and you will have to confirm it yourself.'
          : isSubscription
            ? 'Your subscription is confirmed. Billing and cancellation are managed in the Stripe customer portal.'
            : 'Your purchase is confirmed.';
      }
      const planElement = document.getElementById('checkout-plan');
      const kindElement = document.getElementById('checkout-kind');
      if (planElement) planElement.textContent = result.planLabel ?? 'Not recorded';
      if (kindElement) kindElement.textContent = isReservation ? 'Founder reservation, no charge now' : isSubscription ? 'Recurring subscription' : 'One-time purchase';
      if (detail) detail.hidden = false;
      if (result.supporterPackUnlocked && reward) reward.hidden = false;
    } catch {
      showFailure('This order could not be confirmed right now.');
    }
  }

  verifyCheckoutSession();
</script>

<style>
  .page-intro-plain { padding-block: var(--space-8) var(--space-6); border-bottom: 1px solid var(--color-line); }
  .checkout-facts { display: grid; gap: var(--space-3) var(--space-6); margin: 0; padding: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .checkout-facts dt { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; color: var(--color-ink-subtle); }
  .checkout-facts dd { margin: var(--space-1) 0 0; color: var(--color-ink); }
</style>
