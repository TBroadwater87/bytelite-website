---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'About', href: '/company' },
  { label: 'Founder', href: '/company/founder' },
  { label: 'Partnerships', href: '/company/partnerships' },
  { label: 'Investors', href: '/company/investors' },
  { label: 'Contact', href: '/contact' },
  { label: 'Legal', href: '/company/legal' },
];
---

<Layout
  title="Founder | ByteLite LLC"
  description="Tash Broadwater founded ByteLite LLC in Helena, Montana in 2024."
  keywords="ByteLite LLC founder, Tash Broadwater"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Company', href: '/company' }, { label: 'Founder' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="fo-hero">
    <div class="container fo-hero-layout">
      <div class="fo-hero-text">
        <p class="eyebrow">Founder</p>
        <h1>Tash Broadwater</h1>
        <p class="fo-p">
          Tash Broadwater founded ByteLite LLC in 2024 in Helena, Montana, as a solo-founder LLC
          building deterministic technology infrastructure alongside the Cordel consumer
          products.
        </p>
        <p class="fo-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
          Additional founder biography details beyond what's stated here are not yet published on
          this site.
        </p>
      </div>
      <div class="fo-badge-wrap">
        <img src="/company/founder-tash-bytelite-badge.webp" alt="Personal ByteLite founder mark for Tash Broadwater: a leaf-and-infinity emblem with the wordmark TASH BYTELITE" width="480" height="480" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <div class="fo-stats">
        <div class="fo-stat"><span class="fo-stat-num">2024</span><span class="fo-stat-label">Founded</span></div>
        <div class="fo-stat"><span class="fo-stat-num">Helena, MT</span><span class="fo-stat-label">Based</span></div>
        <div class="fo-stat"><span class="fo-stat-num">Solo</span><span class="fo-stat-label">Founder-led</span></div>
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/contact?type=general" class="btn btn-primary">Contact the Founder</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.fo-hero { padding: 4.5rem 0 3.5rem; }
.fo-hero-layout { display: flex; align-items: center; gap: 3rem; max-width: 900px; }
.fo-hero-text { flex: 1; min-width: 280px; }
.fo-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.fo-badge-wrap { flex-shrink: 0; width: 180px; }
.fo-badge-wrap img { width: 100%; height: auto; border-radius: 50%; border: 1px solid #1a2235; }
.fo-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; text-align: center; }
.fo-stat { display: flex; flex-direction: column; gap: .375rem; padding: 1.25rem; border: 1px solid #1a2235; border-radius: .75rem; }
.fo-stat-num { font-size: 1.375rem; font-weight: 700; color: #e4e7f2; }
.fo-stat-label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: #7b829e; }
@media (max-width: 700px) {
  .fo-hero-layout { flex-direction: column-reverse; align-items: flex-start; }
  .fo-badge-wrap { width: 120px; }
  .fo-stats { grid-template-columns: 1fr; }
}
</style>
