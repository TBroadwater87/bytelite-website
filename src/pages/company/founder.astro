---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { RESEARCH_ROUTES } from '../../data/research';
import { TECHNOLOGY_COUNT_WORD } from '../../data/projects';
import {
  COMPANY_NAME,
  COMPANY_LOCATION,
  COMPANY_REGION_NAME,
  COMPANY_STRUCTURE,
  FOUNDER_NAME,
  RESEARCH_BEGAN_YEAR,
  LEGAL_FORMATION_YEAR,
} from '../../data/company';

const SUBNAV = [
  { label: 'About', href: '/company' },
  { label: 'Founder', href: '/company/founder' },
  { label: 'Partnerships', href: '/company/partnerships' },
  { label: 'Investors', href: '/company/investors' },
  { label: 'Contact', href: '/contact' },
  { label: 'Legal', href: '/company/legal' },
];

const OPERATING_PRINCIPLES = [
  {
    title: 'Evidence before claim',
    body: 'A capability is described publicly once it has been tested, and described with the limits of that test attached. Every status on this site is rendered from one canonical record so it cannot drift between pages.',
  },
  {
    title: 'Failures stay published',
    body: 'Known failures and gaps are kept on the public pages rather than removed once they become inconvenient. A documented visual-detection failure is on the ByteSight page right now.',
  },
  {
    title: 'Determinism as a testable property',
    body: 'Where the work claims to be deterministic, that means byte-identical output across runs, checked rather than assumed. One real non-determinism defect was found this way and fixed.',
  },
  {
    title: 'Ambition and discipline kept separate',
    body: 'Research goals are stated plainly and labeled as goals. They are never allowed to migrate into the columns that describe what exists.',
  },
];
---

<Layout
  noindex={true}
  title="Founder | ByteLite LLC"
  description={`${FOUNDER_NAME} leads ${COMPANY_NAME} from ${COMPANY_LOCATION}. The research work began in ${RESEARCH_BEGAN_YEAR}; ${COMPANY_NAME} was formed in ${LEGAL_FORMATION_YEAR}.`}
  keywords="ByteLite LLC founder, Tash Broadwater, solo founder, deterministic systems research"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Company', href: '/company' }, { label: 'Founder' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="fo-hero">
    <div class="container fo-hero-layout">
      <div class="fo-hero-text">
        <p class="eyebrow">Founder</p>
        <h1>{FOUNDER_NAME}</h1>
        <p class="fo-p">
          {FOUNDER_NAME} leads {COMPANY_NAME} from {COMPANY_LOCATION}, as a {COMPANY_STRUCTURE.toLowerCase()}.
          The research work began in {RESEARCH_BEGAN_YEAR}, before any legal entity existed;
          {' '}{COMPANY_NAME} was formed in {LEGAL_FORMATION_YEAR}.
        </p>
        <p class="fo-p">
          The company is founder-led in the literal sense: there is no external human research or
          engineering team. Every technical claim on this site is published under the
          responsibility of the founder who performed or directed the work, and can be asked about
          directly.
        </p>
      </div>
      <div class="fo-badge-wrap">
        <img src="/company/founder-tash-bytelite-badge.webp" alt="Personal ByteLite founder mark for Tash Broadwater: a leaf-and-infinity emblem with the wordmark TASH BYTELITE" width="480" height="480" loading="eager" />
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container fo-body">
      <p class="eyebrow">Origin</p>
      <h2 style="margin-bottom:1.25rem;">Why these projects exist together.</h2>
      <p class="fo-p">
        The projects did not begin as a portfolio. They began as practical software problems, and
        they converged on a recurring engineering question:
      </p>
      <div class="fo-quote">
        <p>
          If a system is expected to preserve identity, reason explicitly, and explain its
          decisions, what underlying representation and governance architecture does that actually
          require?
        </p>
      </div>
      <p class="fo-p">
        Answering that honestly turned out to be harder than any of the original problems. It
        pushed the work downward, into how information is represented in the first place, and then
        outward, into what happens when that representation has to survive contact with pictures,
        with reasoning, with permission, and with real people using a real product.
      </p>
      <p class="fo-p">
        The {TECHNOLOGY_COUNT_WORD} technologies on this site are what that expansion produced.
        They were not planned as a stack in advance and then filled in. Each one exists because
        the previous answer raised a question the previous layer could not hold, and the
        architecture that connects them was recognized after the fact rather than designed up
        front.
      </p>
      <p class="fo-p">
        The Cordel products are part of that, not a detour from it. Human context forces consent,
        refusal, ambiguity, preference, and safety into concrete product surfaces, which is a far
        less forgiving test of a governance model than any internal example would have been.
      </p>
      <p class="fo-p">
        The <a href={RESEARCH_ROUTES.thesis}>public research thesis</a> is the current attempt to
        state that connection precisely: what is being asked, what would count as evidence, and
        what would show the whole approach to be wrong.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container fo-body">
      <p class="eyebrow">How the Work Is Run</p>
      <h2 style="margin-bottom:1.75rem;">Four operating commitments.</h2>
      <div class="fo-principles">
        {OPERATING_PRINCIPLES.map((principle) => (
          <div class="fo-principle">
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container fo-body">
      <div class="fo-stats">
        <div class="fo-stat"><span class="fo-stat-num">{RESEARCH_BEGAN_YEAR}</span><span class="fo-stat-label">Research began</span></div>
        <div class="fo-stat"><span class="fo-stat-num">{LEGAL_FORMATION_YEAR}</span><span class="fo-stat-label">{COMPANY_NAME} formed</span></div>
        <div class="fo-stat"><span class="fo-stat-num">{COMPANY_REGION_NAME}</span><span class="fo-stat-label">Based in {COMPANY_LOCATION}</span></div>
        <div class="fo-stat"><span class="fo-stat-num">Solo</span><span class="fo-stat-label">Founder-led</span></div>
      </div>
      <p class="fo-note">
        Biography details beyond what is stated here are not published on this site.
      </p>
      <div class="fo-links">
        <a href={RESEARCH_ROUTES.thesis} class="btn btn-outline btn-sm">Research Thesis</a>
        <a href="/architecture" class="btn btn-outline btn-sm">Architecture</a>
        <a href="/progress" class="btn btn-outline btn-sm">Current Status</a>
        <a href="/contact?type=general" class="btn btn-primary btn-sm">Contact the Founder</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.fo-hero { padding: 4.5rem 0 3.5rem; }
.fo-hero-layout { display: flex; align-items: center; gap: 3rem; max-width: 900px; }
.fo-hero-text { flex: 1; min-width: 280px; }
.fo-body { max-width: 820px; }
.fo-p { font-size: 1.0625rem; line-height: 1.85; color: #a0a8c0; margin-bottom: 1.125rem; }
.fo-p:last-child { margin-bottom: 0; }
.fo-p a { color: #818cf8; }
.fo-p a:hover, .fo-p a:focus-visible { color: #a5b4fc; }
.fo-badge-wrap { flex-shrink: 0; width: 180px; }
.fo-badge-wrap img { width: 100%; height: auto; border-radius: 50%; border: 1px solid #1a2235; }

.fo-quote {
  margin: 1.5rem 0;
  padding: 1.5rem 1.75rem;
  background: linear-gradient(135deg, rgba(99,102,241,.08) 0%, rgba(167,139,250,.05) 100%);
  border: 1px solid rgba(99,102,241,.25);
  border-radius: .75rem;
}
.fo-quote p { font-size: 1.0625rem; color: #c4c8f0; line-height: 1.75; font-style: italic; margin: 0; }

.fo-principles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
@media (max-width: 760px) { .fo-principles { grid-template-columns: 1fr; } }
.fo-principle {
  background: #0d1120; border: 1px solid #1a2235; border-left: 3px solid #6366f1;
  border-radius: .75rem; padding: 1.5rem;
}
.fo-principle h3 { font-size: 1rem; color: #e4e7f2; margin-bottom: .5rem; }
.fo-principle p { font-size: .9375rem; color: #7b829e; line-height: 1.7; margin: 0; }

.fo-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: center; }
@media (max-width: 800px) { .fo-stats { grid-template-columns: 1fr 1fr; } }
@media (max-width: 460px) { .fo-stats { grid-template-columns: 1fr; } }
.fo-stat { display: flex; flex-direction: column; gap: .375rem; padding: 1.25rem; border: 1px solid #1a2235; border-radius: .75rem; }
.fo-stat-num { font-size: 1.375rem; font-weight: 700; color: #e4e7f2; }
.fo-stat-label { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: #7b829e; line-height: 1.4; }
.fo-note { margin-top: 1.5rem; font-size: .9375rem; color: #555e7a; }
.fo-links { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.75rem; }

@media (max-width: 700px) {
  .fo-hero-layout { flex-direction: column-reverse; align-items: flex-start; }
  .fo-badge-wrap { width: 120px; }
}
</style>
