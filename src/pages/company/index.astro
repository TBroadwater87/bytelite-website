---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { RESEARCH_ROUTES } from '../../data/research';
import {
  COMPANY_NAME,
  COMPANY_LOCATION,
  COMPANY_STRUCTURE,
  FOUNDER_NAME,
  RESEARCH_BEGAN_YEAR,
  LEGAL_FORMATION_YEAR,
} from '../../data/company';

const SUBNAV = [
  { label: 'About', href: '/company' },
  { label: 'Founder', href: '/company/founder' },
  { label: 'Partnerships', href: '/company/partnerships' },
  { label: 'Investors', href: '/company/investors' },
  { label: 'Contact', href: '/contact' },
  { label: 'Legal', href: '/company/legal' },
];
---

<Layout
  noindex={true}
  title="About ByteLite LLC"
  description="ByteLite LLC is a founder-led research and product company in Helena, Montana investigating deterministic structure. The research began in 2024; the LLC was formed in 2025."
  keywords="About ByteLite LLC, Helena Montana, founder-led, Tash Broadwater, deterministic structure research"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Company' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="about-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>ByteLite LLC</h1>
      <p class="about-sub">A founder-led company building deterministic technology infrastructure and privacy-first public products from Helena, Montana.</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container" style="text-align:center;">
      <img src="/about/montana-lineart.png" alt="Montana line-art illustration" style="width:100%;max-width:360px;display:block;height:auto;margin:0 auto;border-radius:10px;" loading="lazy" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container about-grid">
      <div class="about-text">
        <p class="eyebrow">The Company</p>
        <h2>One founder. A layered technology stack. Clear status.</h2>
        <p style="margin-top:1.25rem;font-size:1.0625rem;line-height:1.8;">
          {COMPANY_NAME} is a founder-led research and product company investigating deterministic
          structure across digital information, visual evidence, reasoning, governance, and human
          interaction. The research work began in {RESEARCH_BEGAN_YEAR}; {COMPANY_NAME} itself was
          formed in {LEGAL_FORMATION_YEAR} by {FOUNDER_NAME} in {COMPANY_LOCATION}.
        </p>
        <p style="margin-top:1rem;font-size:1.0625rem;line-height:1.8;">
          Cordel Play and Cordel Connect are the company's public-facing products, and they are
          part of the research rather than a detour from it. Human context forces consent,
          compatibility, refusal, preference, and real-world safety into concrete product surfaces
          that a governance model has to actually survive.
        </p>
        <p style="margin-top:1rem;font-size:1.0625rem;line-height:1.8;">
          {COMPANY_NAME} is proof-gated: product claims are made only when they can be defended.
          The <a href={RESEARCH_ROUTES.landing} style="color:#818cf8;">Research</a> pages explain
          the larger thesis, <a href="/architecture" style="color:#818cf8;">the Architecture</a>
          explains the system design and claim boundaries, and
          <a href="/progress" style="color:#818cf8;">Progress</a> carries the canonical current
          status.
        </p>
      </div>
      <div class="about-cards">
        <div class="card about-info-card"><div class="about-info-label">Research began</div><div class="about-info-value">{RESEARCH_BEGAN_YEAR}</div></div>
        <div class="card about-info-card"><div class="about-info-label">LLC formed</div><div class="about-info-value">{LEGAL_FORMATION_YEAR}</div></div>
        <div class="card about-info-card"><div class="about-info-label">Location</div><div class="about-info-value">{COMPANY_LOCATION}</div></div>
        <div class="card about-info-card"><div class="about-info-label">Structure</div><div class="about-info-value">{COMPANY_STRUCTURE}</div></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px;text-align:center;">
      <div style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center;">
        <a href={RESEARCH_ROUTES.landing} class="btn btn-outline">Read the Research</a>
        <a href="/technologies" class="btn btn-outline">Explore the Technologies</a>
        <a href="/architecture" class="btn btn-outline">The Architecture</a>
        <a href="/company/founder" class="btn btn-outline">Meet the Founder</a>
        <a href="/progress" class="btn btn-outline">Current Status</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.about-hero { padding: 4.5rem 0 4rem; }
.about-hero h1 { max-width: 480px; }
.about-sub { max-width: 560px; margin-top: 1rem; font-size: 1.0625rem; color: #7b829e; line-height: 1.75; }
.about-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 4rem; align-items: start; }
@media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
.about-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.about-info-card { padding: 1.25rem; }
.about-info-label { font-size: .75rem; color: #4a5068; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .375rem; }
.about-info-value { font-size: 1rem; font-weight: 500; color: #e4e7f2; line-height: 1.4; }
</style>
