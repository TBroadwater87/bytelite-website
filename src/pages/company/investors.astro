---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { RESEARCH_ROUTES } from '../../data/research';
import { ALL_PROJECTS, TECHNOLOGY_COUNT_WORD } from '../../data/projects';
import { COMPANY_NAME, COMPANY_STRUCTURE } from '../../data/company';

const SUBNAV = [
  { label: 'About', href: '/company' },
  { label: 'Founder', href: '/company/founder' },
  { label: 'Partnerships', href: '/company/partnerships' },
  { label: 'Investors', href: '/company/investors' },
  { label: 'Contact', href: '/contact' },
  { label: 'Legal', href: '/company/legal' },
];

const EVIDENCE_LINKS = [
  {
    href: RESEARCH_ROUTES.thesis,
    title: 'Research Thesis',
    body: 'What the research is asking, what would count as evidence, and what would falsify it.',
  },
  {
    href: '/progress',
    title: 'Current Status',
    body: `Canonical status for all ${ALL_PROJECTS.length} public projects, rendered from one record.`,
  },
  {
    href: '/progress/validation-evidence',
    title: 'Validation Evidence',
    body: 'What has been tested, what failed, and where independent verification is absent.',
  },
  {
    href: '/architecture',
    title: 'Architecture',
    body: 'How the layers compose, and the governance model that constrains all of them.',
  },
  {
    href: '/architecture/proof-and-claim-posture',
    title: 'Proof and Claim Posture',
    body: 'The claim ladder from Concept to Product, and what is explicitly not claimed.',
  },
];

const NOT_CLAIMED = [
  'A finished artificial general intelligence.',
  'Production compression infrastructure, or a compression product of any kind.',
  'Solved computer vision or reliable object recognition.',
  'An autonomous system, or readiness for one.',
  'Independent third-party verification of any result on this site.',
  'Revenue, traction, or user numbers &mdash; none are published, because none would survive the claim standard used everywhere else here.',
];
---

<Layout
  title="Investors | ByteLite LLC"
  description="A public investor overview of ByteLite LLC: one deterministic-structure research program, what exists today, the proof posture, the IP boundary, and what is explicitly not being claimed."
  keywords="ByteLite LLC investors, investment inquiry, deterministic structure research, diligence"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Company', href: '/company' }, { label: 'Investors' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="iv-hero">
    <div class="container iv-body">
      <p class="eyebrow">Investors</p>
      <h1>Founder-led. No overclaiming for a raise.</h1>
      <p class="iv-p">
        {COMPANY_NAME} is a {COMPANY_STRUCTURE.toLowerCase()}. Investor conversations are welcome,
        and every claim made in one is held to the same proof-gated standard as this public site.
        Nothing on the pages below is softened because the reader might be writing a check.
      </p>
      <p class="iv-note">
        This page is an overview, not an offer. No valuation, round, terms, or fundraising target
        is stated here or implied by it.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container iv-body">
      <p class="eyebrow">The Thesis</p>
      <h2>One research program, not a portfolio of side projects.</h2>
      <p class="iv-p">
        {COMPANY_NAME} is investigating whether explicit deterministic relationships can be
        progressively reduced into smaller verified structures, and whether those structures can
        support increasingly economical reasoning, prediction, and simulation.
      </p>
      <p class="iv-p">
        The {TECHNOLOGY_COUNT_WORD} technologies and the Cordel products are implementation layers
        and application surfaces of that one question. The full argument, including what would
        falsify it, is in
        <a href={RESEARCH_ROUTES.thesis}>Deterministic Structural Cognition</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container iv-body">
      <p class="eyebrow">What Exists</p>
      <h2>Read the evidence first.</h2>
      <p class="iv-p">
        The honest version of "what exists" is not a paragraph on this page. It is the canonical
        status record, which every other page on this site renders from.
      </p>
      <div class="iv-grid">
        {EVIDENCE_LINKS.map((link) => (
          <a href={link.href} class="iv-card">
            <h3>{link.title}</h3>
            <p>{link.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container iv-body">
      <p class="eyebrow">Why the Stack Exists</p>
      <h2>Five functional roles, one research question.</h2>
      <div class="iv-stack">
        <div class="iv-stack-item"><h3>Digital structure</h3><p>The measurable proof surface. Exact reconstruction is binary, so a claim here can be broken by one counterexample.</p></div>
        <div class="iv-stack-item"><h3>Visual structure</h3><p>The same question asked where the input is not already discrete, and where a wrong answer is easy for a person to see.</p></div>
        <div class="iv-stack-item"><h3>Reasoning</h3><p>Where a shorter verified rule would actually pay off, and where "shorter" must never quietly mean "different."</p></div>
        <div class="iv-stack-item"><h3>Governance</h3><p>The constraint that makes the rest deployable. Reasoning is not permission, and discovery is not authority to act.</p></div>
        <div class="iv-stack-item"><h3>Public application</h3><p>Cordel Play and Cordel Connect, where consent, refusal, and safety stop being examples and become product requirements.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container iv-body">
      <p class="eyebrow">Proof Posture</p>
      <h2>Evidence before claim, including when it costs us.</h2>
      <p class="iv-p">
        Status is rendered from a single canonical record so it cannot drift between pages. Known
        failures stay published: a documented visual-detection failure on close-up portrait photos
        is on the ByteSight page right now, and the absence of any independent verification is
        stated on every technology page rather than omitted.
      </p>
      <p class="iv-p">
        The intent is not modesty. It is that a claim which survives this standard is worth more in
        diligence than five that do not.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container iv-body">
      <p class="eyebrow">IP Boundary</p>
      <h2>Public architecture, private implementation.</h2>
      <p class="iv-p">
        The public pages explain objectives, architecture, validation principles, and system
        relationships. Construction mechanisms, encoding laws, internal mappings, algorithms, and
        implementation-specific transformation logic are not published, and publication of the
        research thesis does not change that boundary or grant any license.
      </p>
      <p class="iv-p">
        For a one-person research company, those methods are the substantive asset. The public
        material is deliberately built so that a competent reviewer can evaluate the claims without
        being handed the mechanism.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container iv-body">
      <p class="eyebrow">Commercial Surfaces</p>
      <h2>Where revenue could come from, stated as could.</h2>
      <div class="iv-surface-grid">
        <div class="iv-surface">
          <h3>Cordel Play</h3>
          <p>A consent-forward adult board game with complete product design and manufacturing in preparation. Founder reservations are open and carry no charge. No retail release date has been announced.</p>
          <a href="/products/cordel-play">Cordel Play &rarr;</a>
        </div>
        <div class="iv-surface">
          <h3>Cordel Connect</h3>
          <p>A privacy-first compatibility application in private Android test builds, not on any public app store. Its Restaurant Partner Program is in pilot preparation with a test-mode checkout.</p>
          <a href="/products/cordel-connect">Cordel Connect &rarr;</a>
        </div>
        <div class="iv-surface">
          <h3>Future technology licensing</h3>
          <p>A possible direction, not an available one. No technology on this site is offered for license today, and no licensing revenue exists. Inquiries are recorded rather than fulfilled.</p>
          <a href="/company/partnerships">Partnership categories &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container iv-body">
      <p class="eyebrow">What Is Not Being Claimed</p>
      <h2>The list an investor should hold us to.</h2>
      <ul class="iv-not-list">
        {NOT_CLAIMED.map((item) => <li set:html={item} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container iv-body">
      <p class="eyebrow">Diligence</p>
      <h2>Where the public boundary ends.</h2>
      <p class="iv-p">
        Serious investor conversations can proceed beyond the public boundary under appropriate
        private diligence arrangements. What that involves is discussed case by case rather than
        promised in advance on a web page.
      </p>
      <p class="iv-p">
        The most useful first step is to read the evidence pages above and arrive with specific
        questions about specific claims. Questions that identify a weak claim are more welcome than
        questions that do not.
      </p>
      <div class="iv-cta-row">
        <a href="/contact?type=investor" class="btn btn-primary">Submit Investor Inquiry</a>
        <a href={RESEARCH_ROUTES.thesis} class="btn btn-outline">Research Thesis</a>
        <a href="/progress/validation-evidence" class="btn btn-outline">Validation Evidence</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.iv-hero { padding: 4.5rem 0 3.5rem; }
.iv-body { max-width: 820px; }
.iv-body h2 { margin-bottom: 1.25rem; }
.iv-p { font-size: 1.0625rem; line-height: 1.85; color: #a0a8c0; margin-bottom: 1.125rem; }
.iv-p:last-child { margin-bottom: 0; }
.iv-p a { color: #818cf8; }
.iv-p a:hover, .iv-p a:focus-visible { color: #a5b4fc; }
.iv-note { margin-top: 1.25rem; font-size: .9375rem; color: #555e7a; line-height: 1.7; }

.iv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
.iv-card {
  display: block; padding: 1.375rem;
  background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem;
  transition: border-color .2s, transform .2s;
}
.iv-card:hover, .iv-card:focus-visible { border-color: #6366f1; transform: translateY(-2px); }
.iv-card:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }
.iv-card h3 { font-size: .9375rem; margin-bottom: .375rem; color: #e4e7f2; }
.iv-card p { font-size: .8125rem; color: #7b829e; margin: 0; line-height: 1.65; }

.iv-stack { display: flex; flex-direction: column; gap: 1rem; }
.iv-stack-item {
  background: #07090f; border: 1px solid #1a2235; border-left: 3px solid #6366f1;
  border-radius: .75rem; padding: 1.25rem 1.5rem;
}
.iv-stack-item h3 { font-size: 1rem; color: #e4e7f2; margin-bottom: .375rem; }
.iv-stack-item p { font-size: .9375rem; color: #7b829e; line-height: 1.7; margin: 0; }

.iv-surface-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.25rem; }
.iv-surface { background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.5rem; }
.iv-surface h3 { font-size: 1rem; color: #e4e7f2; margin-bottom: .5rem; }
.iv-surface p { font-size: .875rem; color: #7b829e; line-height: 1.7; margin-bottom: .875rem; }
.iv-surface a { font-size: .875rem; font-weight: 500; color: #818cf8; }
.iv-surface a:hover, .iv-surface a:focus-visible { color: #a5b4fc; }

.iv-not-list {
  list-style: none; padding: 1.75rem; margin: 0;
  background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem;
  display: flex; flex-direction: column; gap: .875rem;
}
.iv-not-list li { position: relative; padding-left: 1.75rem; font-size: .9375rem; color: #7b829e; line-height: 1.7; }
.iv-not-list li::before { content: "\00D7"; position: absolute; left: .25rem; top: 0; color: #f87171; font-weight: 700; }

.iv-cta-row { display: flex; gap: .875rem; flex-wrap: wrap; margin-top: 1.75rem; }
</style>
