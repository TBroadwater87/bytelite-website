---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'About', href: '/company' },
  { label: 'Founder', href: '/company/founder' },
  { label: 'Partnerships', href: '/company/partnerships' },
  { label: 'Investors', href: '/company/investors' },
  { label: 'Contact', href: '/contact' },
  { label: 'Legal', href: '/company/legal' },
];
---

<Layout
  title="Legal | ByteLite LLC"
  description="Legal pages for ByteLite LLC: terms of use, privacy policy, preorder terms, and responsible disclosure."
  keywords="ByteLite LLC legal, terms, privacy policy"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Company', href: '/company' }, { label: 'Legal' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="lg-hero">
    <div class="container" style="max-width:760px;">
      <p class="eyebrow">Legal</p>
      <h1>Legal Pages</h1>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <div class="lg-list">
        <a href="/terms" class="card lg-item">
          <span class="lg-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2h9l5 5v15H6z"/><path d="M15 2v5h5M9 13h6M9 17h6"/></svg></span>
          <span><h2>Terms of Use</h2><p>Governs use of this website.</p></span>
        </a>
        <a href="/privacy" class="card lg-item">
          <span class="lg-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 018 0v4"/></svg></span>
          <span><h2>Privacy Policy</h2><p>What this website collects and what it never does.</p></span>
        </a>
        <a href="/preorder/terms" class="card lg-item">
          <span class="lg-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="18" cy="18" r="1.6"/></svg></span>
          <span><h2>Preorder Terms</h2><p>Founder reservation and preorder terms.</p></span>
        </a>
        <a href="/responsible-disclosure" class="card lg-item">
          <span class="lg-icon" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M12 8v5M12 16h.01"/></svg></span>
          <span><h2>Responsible Disclosure</h2><p>How to report a security vulnerability.</p></span>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.lg-hero { padding: 4.5rem 0 3.5rem; }
.lg-list { display: flex; flex-direction: column; gap: 1rem; }
.lg-item { display: flex; align-items: flex-start; gap: 1rem; }
.lg-icon { display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.5rem; border-radius: .625rem; background: rgba(129,140,248,.12); color: #818cf8; flex-shrink: 0; }
.lg-item h2 { font-size: clamp(1.1rem, 2.2vw, 1.5rem); font-weight: 600; color: #818cf8; margin-bottom: .375rem; }
.lg-item p { font-size: .875rem; color: #7b829e; margin: 0; }
</style>
