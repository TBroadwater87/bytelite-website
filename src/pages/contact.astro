---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { COMPANY_NAME, COMPANY_LOCATION } from '../data/company';

const INQUIRY_OPTIONS = [
  { value: 'general', label: 'General inquiry or product question' },
  { value: 'validation-partnership', label: 'Independent evaluation proposal' },
  { value: 'technology-partnership', label: 'Research or technology partnership' },
  { value: 'licensing', label: 'Licensing' },
  { value: 'investor', label: 'Business or investor inquiry' },
  { value: 'privacy-request', label: 'Privacy request' },
] as const;
---

<Layout
  title={`Contact | ${COMPANY_NAME}`}
  description="Contact ByteLite LLC about independent evaluation, research partnerships, licensing, business inquiries or privacy requests."
  path="/contact"
>
  <PageIntro
    eyebrow="Contact"
    heading={`Contact ${COMPANY_NAME}.`}
    lede="Messages reach the company directly. Evidence that something on this site is wrong is as welcome as any other message."
  />

  <section class="section">
    <div class="wrap contact-layout">
      <form class="form-grid contact-form" id="contact-form" novalidate>
        <p class="small-print">Fields marked <span class="required-mark" aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>
        <div class="form-field">
          <label for="contact-name">Name <span class="required-mark" aria-hidden="true">*</span></label>
          <input type="text" id="contact-name" name="name" required maxlength="200" autocomplete="name" />
        </div>
        <div class="form-field">
          <label for="contact-email">Email <span class="required-mark" aria-hidden="true">*</span></label>
          <input type="email" id="contact-email" name="email" required maxlength="200" autocomplete="email" />
        </div>
        <div class="form-field">
          <label for="contact-inquiry-type">Inquiry type <span class="required-mark" aria-hidden="true">*</span></label>
          <select id="contact-inquiry-type" name="inquiryType" required aria-describedby="contact-inquiry-hint">
            <option value="">Choose an inquiry type</option>
            {INQUIRY_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
          <p class="form-hint" id="contact-inquiry-hint" data-inquiry-hint></p>
        </div>
        <div class="form-field" id="contact-organization-field" hidden>
          <label for="contact-organization">Organization <span class="form-hint">(optional)</span></label>
          <input type="text" id="contact-organization" name="organization" maxlength="200" autocomplete="organization" disabled />
        </div>
        <div class="form-field">
          <label for="contact-message">Message <span class="required-mark" aria-hidden="true">*</span></label>
          <textarea id="contact-message" name="message" required maxlength="5000" rows="7"></textarea>
        </div>
        <label class="form-checkbox">
          <input type="checkbox" id="contact-consent" name="consent" required />
          <span>I agree that {COMPANY_NAME} may reply to me by email about this message. <span class="required-mark" aria-hidden="true">*</span></span>
        </label>
        <p class="small-print">
          Sending a message does not create any agreement, partnership or investment opportunity, and no
          payment is collected here. How messages are handled is described in the
          <a href="/privacy">privacy policy</a>.
        </p>
        <button type="submit" class="button button-primary">Send message</button>
        <p class="form-status" id="contact-status" role="status" aria-live="polite"></p>
      </form>

      <aside class="contact-aside" aria-label="About contacting the company">
        <div class="panel">
          <h2 class="aside-heading">What to expect</h2>
          <p>{COMPANY_NAME} is a small, founder-led company. Messages are read and answered personally, and response times vary.</p>
        </div>
        <div class="panel">
          <h2 class="aside-heading">Independent evaluation</h2>
          <p>Name the specific claim you want to test. Evaluations never require disclosure of proprietary methods.</p>
        </div>
        <div class="panel">
          <h2 class="aside-heading">Security reports</h2>
          <p>See the <a href="/responsible-disclosure">responsible disclosure policy</a>.</p>
        </div>
        <div class="panel">
          <h2 class="aside-heading">Location</h2>
          <p>{COMPANY_NAME}<br />{COMPANY_LOCATION}</p>
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const INQUIRY_DETAILS: Record<string, { hint: string; asksForOrganization: boolean }> = {
    general: { hint: '', asksForOrganization: false },
    'validation-partnership': { hint: 'Say which published claim you would like to evaluate and how.', asksForOrganization: true },
    'technology-partnership': { hint: 'Describe the collaboration you have in mind.', asksForOrganization: true },
    licensing: { hint: 'Nothing is available to license today. Describe the workload you have in mind.', asksForOrganization: true },
    investor: { hint: 'General inquiries only. This website does not offer or sell securities.', asksForOrganization: true },
    'privacy-request': { hint: 'Say whether you want to access, correct or delete information.', asksForOrganization: false },
  };

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const inquirySelect = document.getElementById('contact-inquiry-type') as HTMLSelectElement | null;
  const inquiryHint = document.querySelector<HTMLElement>('[data-inquiry-hint]');
  const organizationField = document.getElementById('contact-organization-field');
  const organizationInput = document.getElementById('contact-organization') as HTMLInputElement | null;
  const statusMessage = document.getElementById('contact-status');
  const NOT_SENT_MESSAGE = 'Your message was not sent. Nothing was stored, so please try again.';

  function applyInquiryType(inquiryType: string) {
    const details = INQUIRY_DETAILS[inquiryType];
    if (inquiryHint) inquiryHint.textContent = details?.hint ?? '';
    const showOrganization = details?.asksForOrganization ?? false;
    if (organizationField) organizationField.hidden = !showOrganization;
    if (organizationInput) {
      organizationInput.disabled = !showOrganization;
      if (!showOrganization) organizationInput.value = '';
    }
  }

  const requestedInquiryType = new URLSearchParams(window.location.search).get('type');
  if (inquirySelect && requestedInquiryType && INQUIRY_DETAILS[requestedInquiryType]) {
    inquirySelect.value = requestedInquiryType;
  }
  applyInquiryType(inquirySelect?.value ?? '');
  inquirySelect?.addEventListener('change', () => applyInquiryType(inquirySelect.value));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    const formData = new FormData(form);
    const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    if (statusMessage) statusMessage.textContent = 'Sending...';
    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: formData.get('name'),
          email: formData.get('email'),
          inquiryType: formData.get('inquiryType'),
          message: formData.get('message'),
          organization: formData.get('organization') || '',
        }),
      });
      const result = await response.json().catch(() => ({}));
      if (response.status === 404) throw new Error(NOT_SENT_MESSAGE);
      if (!response.ok) throw new Error(result.error || NOT_SENT_MESSAGE);
      if (statusMessage) statusMessage.textContent = 'Message sent. This confirms it was sent, not that any request has been accepted.';
      form.reset();
      applyInquiryType('');
    } catch (error) {
      if (statusMessage) statusMessage.textContent = error instanceof Error ? error.message : NOT_SENT_MESSAGE;
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>

<style>
  .contact-layout { display: grid; gap: var(--space-7); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 60rem) { .contact-layout { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); } }
  .contact-form { max-width: 40rem; }
  .contact-aside { display: grid; gap: var(--space-4); align-content: start; }
  .contact-aside .panel { display: grid; gap: var(--space-2); }
  .aside-heading { font-family: var(--font-text); font-size: var(--text-base); font-weight: 600; }
</style>
