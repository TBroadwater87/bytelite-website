---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import ClassifiedFigure from '../components/site/ClassifiedFigure.astro';
import { consumerProduct, PRODUCT_AVAILABILITY_LABEL } from '../data/products';
import { COMPANY_NAME } from '../data/company';

const product = consumerProduct('party-game');
---

<Layout
  title={`${product.displayName} | ${COMPANY_NAME}`}
  description={`${product.displayName} is a consent-first adult board game from ${COMPANY_NAME}, at prototype stage. It has not been manufactured, and no price, shipping date or preorder exists.`}
  path="/cordel-play"
>
  <PageIntro eyebrow={`${product.category} · 18+`} heading={product.displayName} lede={product.oneLine}>
    <p class="audience-notice">This is an adult product, intended for people aged 18 or over.</p>
    <p><span class="status-badge tone-neutral">{PRODUCT_AVAILABILITY_LABEL[product.availability]}</span></p>
  </PageIntro>

  <section class="section" aria-labelledby="components-heading">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="components-heading">Component designs.</h2>
        <p class="lede">
          These images are renderings of component designs. Nothing has been manufactured, so there
          is no photograph of a real unit.
        </p>
      </div>
      <div class="figures">
        <ClassifiedFigure classification="Product concept rendering" caption="Card deck backs for six escalation tiers and a Decree deck. Players choose how far the evening goes.">
          <img
            src="/cordel/cordel-play-tier-deck-backs-final.webp"
            alt="Seven card backs, left to right: Initiate, Connect, Seduce, Stimulate, Edge, Climax and Decree."
            width="1400" height="268" loading="lazy" decoding="async"
          />
        </ClassifiedFigure>
        <div class="consent-cup-figure"><ClassifiedFigure classification="Product concept rendering" caption="The consent cup: consent as a physical component of the game rather than a rule to remember.">
          <img
            src="/cordel/cordel-play-consent-cup-final.webp"
            alt="A black lidded cup with a viewing dome, shown beside a cutaway view of the tokens inside."
            width="1000" height="750" loading="lazy" decoding="async"
            class="consent-cup"
          />
        </ClassifiedFigure></div>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="status-heading">
    <div class="wrap split">
      <div class="prose">
        <h2 id="status-heading">Where it stands.</h2>
        <p>{product.availabilityDetail}</p>
        <h3>Exists today</h3>
        <ul class="fact-list fact-list-yes">{product.whatExistsToday.map((item) => <li>{item}</li>)}</ul>
        <h3>Does not exist yet</h3>
        <ul class="fact-list fact-list-no">{product.whatDoesNotExist.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="prose">
        <h2>Why it cannot be bought here.</h2>
        <p>
          {product.displayName} is planned as a physical product in a box. It is not a subscription and
          will not be sold as one.
        </p>
        <p>
          {COMPANY_NAME} is not taking paid preorders. Under the United States Federal Trade
          Commission's Mail, Internet, or Telephone Order Merchandise Rule, a seller that takes payment
          must have a reasonable basis to ship within the stated time, or within 30 days if no time is
          stated, and must have a process for obtaining consent to delays or issuing refunds. No shipping date, price or
          refund process has been approved, so nothing can honestly be charged.
        </p>
        <div class="button-row">
          <a class="button button-secondary" href="/founder-access">Founder access status</a>
          <a class="button button-secondary" href="/contact">Ask about it</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .audience-notice { font-weight: 700; color: var(--color-ink); }
  .figures { display: grid; gap: var(--space-6); }
  .consent-cup { max-width: 100%; margin-inline: auto; }
  .consent-cup-figure { max-width: 36rem; }
</style>
