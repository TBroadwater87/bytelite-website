---
/**
 * The canonical public page for Deep Kore.
 *
 * PUBLIC SCOPE. Deep Kore, AIya, Genesis Goalkeeper and Revelation Vanguard are named
 * here by owner instruction, and only here. They remain off every other public route,
 * which `public-scope-vocabulary.spec.ts` asserts route by route. See CLAUDE.md
 * section 1 rule 3 and section 19.
 *
 * IP BOUNDARY. This page says WHAT the system does and never HOW. It names the two
 * governance layers because a visitor being governed is entitled to know it; it states
 * nothing about the rules either applies. All copy comes from src/data/deep-kore.ts so
 * a page edit cannot quietly widen what is published.
 *
 * THE CHAT CONTROL IS ALWAYS RENDERED, and the SERVER decides whether a session can be
 * created. Gating the control on a build-time variable would make the built HTML claim
 * something the runtime might contradict, which is precisely the class of confident
 * nonsense CLAUDE.md section 7 rule 10 exists to prevent. The server is the authority;
 * this page reports what it says.
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ChatConsole from '../components/deep-kore/ChatConsole.tsx';
import {
  DEEP_KORE_NAME,
  PUBLIC_IDENTITY,
  LEAD,
  LEAD_SUB,
  PUBLIC_INTRO,
  PUBLIC_STATUS,
  PUBLIC_STATUS_HEADLINE,
  WHAT_IT_IS,
  WHAT_IT_IS_NOT,
  GOVERNANCE,
  LIMITS,
  CONSENT_SURFACES,
  PRIVACY,
  PRIVACY_DISCLOSURE,
  PRIVACY_HEADLINE,
} from '../data/deep-kore';

// A Turnstile SITE key is public by design - it is not a credential and it appears in
// the delivered page either way. The matching SECRET stays server-side and is read at
// request time by the gateway. When no site key is configured the widget is not
// rendered AND the server refuses anonymous sessions, which is the correct pairing:
// the visible control and the server-side rule fail together, never separately.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<Layout
  title="Deep Kore | ByteLite LLC"
  description="Deep Kore is ByteLite LLC's deterministic structural cognition system. Talk with it directly. Every response passes a governance gate before it is emitted, and the conversation is not kept."
  keywords="Deep Kore, ByteLite LLC, deterministic cognition, governed conversation, structural reasoning"
  canonical="https://www.thebytelite.com/deep-kore/"
>
  <Header slot="header" />

  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">{DEEP_KORE_NAME} &middot; Live session</p>
      <h1>{LEAD}</h1>
      <p class="hero-sub">{LEAD_SUB}</p>
      <p class="hero-intro">{PUBLIC_INTRO}</p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container narrow">
      {turnstileSiteKey && (
        <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
      )}
      <ChatConsole client:load turnstileSiteKey={turnstileSiteKey} />

      <p class="console-note">
        This is the live system, not a demonstration. Responses are produced by {DEEP_KORE_NAME}
        and passed through unchanged. If it cannot be reached, this page says so rather than
        answering from anywhere else.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <!--
    THE STATUS BLOCK, and there is exactly one of it. Qualification is centralised here
    rather than repeated under every section - the same rule the homepage follows. See
    CLAUDE.md section 17.
  -->
  <section class="section-sm">
    <div class="container narrow">
      <h2>{PUBLIC_STATUS_HEADLINE}</h2>
      <ul class="plain status-list">
        {PUBLIC_STATUS.map((line) => <li>{line}</li>)}
      </ul>
      <p class="body-note">
        For ByteLite's own claim ladder and what has and has not been proved, see
        <a href="/validation">validation</a>.
      </p>
    </div>
  </section>

  <hr class="divider" />

  <section class="section">
    <div class="container narrow">
      <h2>{PRIVACY_HEADLINE}</h2>
      <!--
        The owner-approved disclosure, rendered verbatim from src/data/deep-kore.ts and
        reproduced word for word on /privacy. Never paraphrase it here: a promise made
        on the page and a policy recording it must not differ.
      -->
      <p class="disclosure">{PRIVACY_DISCLOSURE}</p>
      <ul class="plain">
        {PRIVACY.map((line) => <li>{line}</li>)}
      </ul>

      <!--
        The two consent surfaces, described before a visitor meets either control. Each
        states what the decision does and what it does not do; neither is bundled with
        the other, and neither is bundled with any other agreement on this site.
      -->
      <div class="consents">
        {CONSENT_SURFACES.map((c) => (
          <article class="card consent-card">
            <h3>{c.heading}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>

      <p class="body-note">
        The complete policy, including what the hosting and security providers see, is the
        <a href="/privacy">privacy policy</a>. The
        <a href="/terms">terms of service</a> cover the conditions this conversation is
        offered under.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2>How a turn is governed.</h2>

      <div class="gov">
        <article class="card gov-card">
          <h3>{GOVERNANCE.genesis.name}</h3>
          <p>{GOVERNANCE.genesis.says}</p>
        </article>
        <article class="card gov-card">
          <h3>{GOVERNANCE.vanguard.name}</h3>
          <p>{GOVERNANCE.vanguard.says}</p>
        </article>
      </div>

      <p class="body-note">{GOVERNANCE.stamp}</p>

      <!--
        Deliberately absent: what either layer actually evaluates. Naming a governance
        boundary tells a visitor they are governed. Publishing its rules tells everyone
        how to route around them.
      -->
      <p class="body-note">
        ByteLite LLC does not publish what either layer evaluates. Knowing that a boundary
        exists is a visitor's business; the rules that hold it are not.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="two">
        <div>
          <h2>What it is.</h2>
          <ul class="plain">
            {WHAT_IT_IS.map((line) => <li>{line}</li>)}
          </ul>
        </div>
        <div>
          <h2>What it is not.</h2>
          <ul class="plain notlist">
            {WHAT_IT_IS_NOT.map((line) => <li>{line}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2>What to expect from {PUBLIC_IDENTITY}.</h2>
      <ul class="plain">
        {LIMITS.map((line) => <li>{line}</li>)}
      </ul>
      <p class="body-note">
        {DEEP_KORE_NAME} is a separate system from ByteLite, the compression architecture this
        site otherwise describes. Neither one's state says anything about the other's. For
        ByteLite's own claim status, see <a href="/validation">validation</a>.
      </p>
      <p class="body-note">
        For anything that needs a person - licensing, billing, support, or a question about
        ByteLite LLC - use the <a href="/contact">contact form</a>. {PUBLIC_IDENTITY} cannot
        reach anyone at the company on your behalf.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.page-hero { padding: 4rem 0 2rem; }
.container.narrow { max-width: 820px; }
.hero-sub { font-size: 1.0625rem; margin-top: 1rem; }

.console-note { font-size: .875rem; color: #7b829e; margin-top: 1rem; }
.hero-intro { margin-top: 1rem; font-size: .9375rem; color: #7b829e; }

.status-list li { color: #e4e7f2; }

.consents { display: grid; gap: 1.25rem; margin-top: 2rem; }
@media (min-width: 720px) { .consents { grid-template-columns: 1fr 1fr; } }
.consent-card h3 { color: #e4e7f2; margin-bottom: .625rem; font-size: 1.0625rem; }
.consent-card p { font-size: .9375rem; }

.plain { list-style: none; display: grid; gap: .75rem; margin-top: 1.25rem; }
.plain li {
  position: relative; padding-left: 1.25rem; color: #a0a8c0; line-height: 1.65;
}
.plain li::before {
  content: ''; position: absolute; left: 0; top: .6em;
  width: .375rem; height: .375rem; border-radius: 9999px; background: #6366f1;
}
.notlist li::before { background: #7b829e; }

.two { display: grid; gap: 2.5rem; }
@media (min-width: 720px) { .two { grid-template-columns: 1fr 1fr; gap: 3rem; } }

.gov { display: grid; gap: 1.25rem; margin-top: 1.5rem; }
@media (min-width: 720px) { .gov { grid-template-columns: 1fr 1fr; } }
.gov-card h3 { color: #e4e7f2; margin-bottom: .625rem; }
.gov-card p { font-size: .9375rem; }

.disclosure {
  margin-top: 1.25rem; font-size: .9375rem; line-height: 1.75; color: #a0a8c0;
  background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.25rem 1.5rem;
}
.body-note { margin-top: 1.5rem; font-size: .9375rem; }
.body-note a { color: #818cf8; text-decoration: underline; text-underline-offset: 2px; }

h2 + .plain { margin-top: 1rem; }
</style>

<style is:global>
/* ---------------------------------------------------------------------------
   The chat console.

   Everything here is sized in relative units and every horizontal container can
   shrink, because the console has to be usable at 320px - the transcript and the
   composer are the two things on this site most likely to force a horizontal
   scrollbar, and a chat you cannot type into on a phone is not a chat.
   --------------------------------------------------------------------------- */
.dk-console {
  background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem;
  padding: 1.25rem; display: grid; gap: 1rem;
}
@media (min-width: 720px) { .dk-console { padding: 1.75rem; } }

.dk-bar {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
  gap: .75rem; padding-bottom: 1rem; border-bottom: 1px solid #1a2235;
}
.dk-bar-state { font-size: .875rem; margin: 0; min-width: 0; flex: 1 1 14rem; }
.dk-bar-state strong { color: #e4e7f2; font-weight: 600; }

.dk-transcript {
  display: grid; gap: 1.25rem; align-content: start;
  min-height: 12rem; max-height: 30rem; overflow-y: auto;
  /* A scrollable region must be reachable and readable by keyboard, so it is
     focusable and shows the focus ring rather than suppressing it. */
  border-radius: .5rem;
}
.dk-transcript:focus-visible { outline: 2px solid #6366f1; outline-offset: 3px; }

.dk-empty { font-size: .875rem; color: #555e7a; }

.dk-turn { display: grid; gap: .375rem; min-width: 0; }
.dk-who {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #7b829e; margin: 0;
}
.dk-turn-engine .dk-who { color: #818cf8; }
.dk-text {
  color: #e4e7f2; margin: 0; white-space: pre-wrap;
  /* A long unbroken token from either side must wrap rather than widen the page. */
  overflow-wrap: anywhere;
}
.dk-turn-visitor .dk-text { color: #a0a8c0; }

.dk-stamp { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem; margin: .25rem 0 0; }
.dk-stamp-label {
  font-size: .625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #34d399;
}
.dk-stamp code {
  font-family: ui-monospace, 'Courier New', monospace; font-size: .6875rem;
  color: #7b829e; overflow-wrap: anywhere; min-width: 0;
}

.dk-status { font-size: .875rem; color: #818cf8; margin: 0; min-height: 1.25rem; display: flex; gap: .75rem; align-items: center; flex-wrap: wrap; }
.dk-stop {
  background: none; border: none; padding: 0; color: #7b829e; font-size: .8125rem;
  text-decoration: underline; text-underline-offset: 2px;
}
.dk-stop:hover, .dk-stop:focus-visible { color: #e4e7f2; }

/* A transport failure is styled as a distinct alert, never as a turn. It sits outside
   the transcript so it can never be read as something the system said. */
.dk-failure {
  margin: 0; font-size: .875rem; color: #f87171;
  background: rgba(248,113,113,.08); border: 1px solid rgba(248,113,113,.22);
  border-radius: .5rem; padding: .75rem 1rem;
  display: grid; gap: .625rem; justify-items: start;
}
.dk-failure p { margin: 0; color: inherit; font-size: inherit; }
.dk-retry { flex: 0 0 auto; }

/* ---------------------------------------------------------------------------
   "Why this response?"

   A disclosure, closed by default. The governance record is a technical artifact:
   a visitor reading a conversation should not have a stamp under every sentence,
   and one who wants it should not have to ask anyone for it.
   --------------------------------------------------------------------------- */
.dk-why { margin-top: .25rem; min-width: 0; }
.dk-why > summary {
  display: inline-flex; align-items: center; gap: .375rem; cursor: pointer;
  font-size: .75rem; color: #7b829e; width: fit-content;
  border-radius: .25rem; padding: .125rem .25rem; margin-left: -.25rem;
  list-style: none;
}
.dk-why > summary::-webkit-details-marker { display: none; }
.dk-why > summary::before {
  content: '+'; font-family: ui-monospace, 'Courier New', monospace; color: #6366f1;
}
.dk-why[open] > summary::before { content: '-'; }
.dk-why > summary:hover { color: #e4e7f2; }
.dk-why > summary:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }

.dk-why-body {
  display: grid; gap: .5rem; margin-top: .625rem; padding: .75rem .875rem;
  background: #07090f; border: 1px solid #1a2235; border-radius: .5rem; min-width: 0;
}
/* The gate outcome is carried by WORDS. The marker is reinforcement, and it differs in
   shape as well as colour so it is not the only thing distinguishing the two states. */
.dk-why-gate {
  margin: 0; font-size: .8125rem; display: flex; align-items: baseline; gap: .5rem;
}
.dk-why-gate::before { font-weight: 700; }
.dk-why-gate[data-dk-gate='passed'] { color: #34d399; }
.dk-why-gate[data-dk-gate='passed']::before { content: 'OK'; font-size: .625rem; letter-spacing: .08em; }
.dk-why-gate[data-dk-gate='not-passed'] { color: #f87171; }
.dk-why-gate[data-dk-gate='not-passed']::before { content: 'NO'; font-size: .625rem; letter-spacing: .08em; }
.dk-why-note { margin: 0; font-size: .75rem; color: #555e7a; line-height: 1.6; }

.dk-composer { display: grid; gap: .625rem; }
.dk-composer-label {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #7b829e;
}
.dk-input {
  width: 100%; max-width: 100%; resize: vertical;
  background: #07090f; color: #e4e7f2; border: 1px solid #1a2235; border-radius: .5rem;
  padding: .75rem; font-family: inherit; font-size: .9375rem; line-height: 1.6;
}
.dk-input:focus-visible { outline: 2px solid #6366f1; outline-offset: 1px; border-color: #6366f1; }
.dk-input:disabled { opacity: .5; cursor: not-allowed; }

.dk-composer-actions {
  display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .75rem;
}
.dk-hint { font-size: .75rem; color: #555e7a; }
.dk-console .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }

.dk-turnstile { margin-top: .25rem; }

/* ---------------------------------------------------------------------------
   The two decision surfaces: a TAV permission request, and an unknown-concept
   teaching offer.

   They share one visual treatment deliberately. Both are the interface ASKING
   something rather than saying something, both block the composer while they are
   open, and both are answered by a deliberate press - so they must read as the
   same KIND of thing, distinguishable by their words rather than by their colour.
   Nothing here is signalled by colour alone.

   The region is focusable (`tabIndex={-1}` in the component) because focus is moved
   to it when it appears; the ring has to be visible when that happens, or the move
   is invisible to the person it was made for.
   --------------------------------------------------------------------------- */
.dk-ask {
  display: grid; gap: .875rem; min-width: 0;
  background: #0a0e1a; border: 1px solid #2b3550; border-left: 3px solid #6366f1;
  border-radius: .5rem; padding: 1.125rem;
}
@media (min-width: 720px) { .dk-ask { padding: 1.375rem 1.5rem; } }
.dk-ask:focus-visible { outline: 2px solid #6366f1; outline-offset: 3px; }
.dk-ask h3 { color: #e4e7f2; font-size: 1.0625rem; margin: 0; }
.dk-ask p { font-size: .875rem; margin: 0; }

.dk-ask-field {
  display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem;
  background: #07090f; border: 1px solid #1a2235; border-radius: .375rem;
  padding: .625rem .75rem; min-width: 0;
}
.dk-ask-field-label {
  font-size: .625rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #7b829e; flex: 0 0 auto;
}
.dk-ask-field code, .dk-ask-field span:last-child {
  font-size: .8125rem; color: #e4e7f2; overflow-wrap: anywhere; min-width: 0;
}
.dk-ask-field code { font-family: ui-monospace, 'Courier New', monospace; }
.dk-ask-note { font-size: .8125rem; color: #7b829e; }

.dk-ask-actions { display: flex; flex-wrap: wrap; gap: .625rem; }
/* At 320px each control gets its own full-width row rather than a squeezed pair. */
@media (max-width: 380px) { .dk-ask-actions .btn { width: 100%; justify-content: center; } }

/* The private-value composer. It is visually separated from the decision controls so
   that entering a value and answering the question never read as one action. */
.dk-private {
  display: grid; gap: .5rem; min-width: 0;
  border-top: 1px solid #1a2235; padding-top: .875rem;
}
.dk-private-label {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #7b829e;
}
.dk-private-input {
  width: 100%; max-width: 100%;
  background: #07090f; color: #e4e7f2; border: 1px solid #1a2235; border-radius: .5rem;
  padding: .625rem .75rem; font-family: inherit; font-size: .9375rem;
}
.dk-private-input:focus-visible { outline: 2px solid #6366f1; outline-offset: 1px; border-color: #6366f1; }
.dk-private-hint { font-size: .75rem; color: #555e7a; }
.dk-private-actions { display: flex; flex-wrap: wrap; gap: .625rem; }
@media (max-width: 380px) { .dk-private-actions .btn { width: 100%; justify-content: center; } }
/* Held state is carried by WORDS, with the dot as reinforcement only. */
.dk-private-held {
  font-size: .75rem; color: #34d399; display: flex; align-items: center; gap: .375rem;
}
.dk-private-held::before {
  content: ''; width: .375rem; height: .375rem; border-radius: 9999px;
  background: currentColor; flex: 0 0 auto;
}

/* A notice records what just happened - a decision taken, a value removed, a candidate
   declined. It is neither a response nor a failure, so it looks like neither, and it
   sits outside the transcript like both. */
.dk-notice {
  margin: 0; font-size: .8125rem; color: #a0a8c0;
  background: rgba(99,102,241,.07); border: 1px solid rgba(99,102,241,.22);
  border-radius: .5rem; padding: .625rem .875rem;
}

/* Why a disabled composer is disabled. Always rendered when it is, never colour alone. */
.dk-composer-why { margin: 0; font-size: .75rem; color: #7b829e; }

/* No motion is used to convey state anywhere in this console - "Working..." is text,
   not an animation - so there is nothing for a reduced-motion preference to remove.
   This only stops the shared button transitions from running. */
@media (prefers-reduced-motion: reduce) {
  .dk-console *, .dk-console *::before, .dk-console *::after {
    transition-duration: .01ms !important; animation-duration: .01ms !important;
  }
}
</style>
