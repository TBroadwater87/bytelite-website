---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import {
  FOUNDER_CARDS,
  cardIsActionable,
  actionLabelFor,
  actionableStateFor,
  FOUNDER_BENEFIT_PRICE,
  FOUNDER_BENEFIT_ENTITLEMENT,
  FOUNDER_ENTITLEMENT_UNDEFINED_NOTE,
} from '../data/commerce';
import { COMPANY_NAME } from '../data/company';

const founderCards = FOUNDER_CARDS.map((card) => ({ ...card, actionable: cardIsActionable(card) }));
const anyCardActionable = founderCards.some((card) => card.actionable);
---

<Layout
  title={`Founder Access | ${COMPANY_NAME}`}
  description="The planned founder benefit for ByteLite LLC products. Founder reservations are not open, and nothing is charged."
  path="/founder-access"
>
  <PageIntro
    eyebrow="Founder access"
    heading={anyCardActionable ? 'Founder access.' : 'Founder access: planned, and switched off.'}
    lede={anyCardActionable
      ? 'Founder access lets you register early interest in a product and keep a founder benefit. Each card states exactly what it does.'
      : 'Founder access is a planned way to register early interest in a product and keep a founder benefit. No product is finished, no price or reservation terms are approved, and checkout is switched off in the website configuration.'}
  />

  <section class="section" aria-labelledby="benefit-heading">
    <div class="wrap split">
      <div class="prose">
        <h2 id="benefit-heading">The planned founder benefit is two separate things.</h2>
        <ol class="benefits">
          <li>{FOUNDER_BENEFIT_PRICE}</li>
          <li>{FOUNDER_BENEFIT_ENTITLEMENT}</li>
        </ol>
        <p>
          They do not add up to 20% off. One is a discount on price. The other is more of whatever the
          product measures. {FOUNDER_ENTITLEMENT_UNDEFINED_NOTE}
        </p>
      </div>
      <div class="prose">
        <h2>What a reservation would be.</h2>
        <p>
          A reservation would record that you want a product and which founder offer you accepted. It
          would not be a subscription, an account or product access, and it would not guarantee a
          launch date.
        </p>
        <p>
          Before anything could ever be charged, you would be shown the exact amount, billing
          interval, first charge date, renewal and cancellation terms, and you would have to confirm
          it yourself. The reservation flow that exists in the website's code would save a payment
          method with Stripe for a later, separately confirmed charge. Whether reservations open at all,
          and on what terms, has not been decided, and the reservation terms are not yet written.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="cards-heading">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="cards-heading">Products and their commercial state.</h2>
        {!anyCardActionable && (
          <p class="lede">Every control below is switched off.</p>
        )}
      </div>
      <div class="card-grid">
        {founderCards.map((card, cardIndex) => (
          <article class="founder-card">
            <h3>{card.title}</h3>
            <p>{card.what}</p>
            <p class="small-print">{card.actionable ? actionableStateFor(card) : card.state}</p>
            <p class="founder-kind">{card.kind === 'reservation' ? 'Physical product reservation' : `Subscription, billed per ${card.interval}`}</p>
            {card.actionable ? (
              <button type="button" class="button button-primary founder-button" data-plan={card.planKey}>{actionLabelFor(card)}</button>
            ) : (
              <button type="button" class="button founder-button" disabled aria-describedby={`founder-card-reason-${cardIndex}`}>Not available</button>
            )}
            {!card.actionable && (
              <p class="small-print" id={`founder-card-reason-${cardIndex}`}>Switched off until a price and terms are approved.</p>
            )}
            <a class="text-link" href={card.href}>What this is<span class="visually-hidden">: {card.title}</span> &rarr;</a>
          </article>
        ))}
      </div>
      <p class="form-status" role="status" id="founder-status"></p>
      <p class="after-cards">
        To be told if founder access ever opens, <a href="/contact">contact {COMPANY_NAME}</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  const founderStatus = document.getElementById('founder-status');
  document.querySelectorAll<HTMLButtonElement>('.founder-button[data-plan]').forEach((button) => {
    button.addEventListener('click', async () => {
      const planKey = button.dataset.plan;
      if (!planKey) return;
      button.disabled = true;
      if (founderStatus) founderStatus.textContent = 'Opening secure checkout...';
      try {
        const response = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ planKey }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.url) throw new Error(result.error || 'Checkout could not be started.');
        window.location.assign(result.url);
      } catch (error) {
        if (founderStatus) founderStatus.textContent = error instanceof Error ? error.message : 'Checkout could not be started.';
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .benefits { padding-left: 1.5rem; display: grid; gap: var(--space-2); color: var(--color-ink); font-weight: 600; }
  .founder-card { display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .founder-card h3 { font-size: var(--text-base); }
  .founder-kind { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.05em; text-transform: uppercase; color: var(--color-ink-subtle); }
  .founder-button { width: 100%; margin-top: auto; }
  .after-cards { margin-top: var(--space-5); }
</style>
