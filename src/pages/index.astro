---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StatusBadge from '../components/StatusBadge.astro';
import SeasonalBanner from '../components/SeasonalBanner.astro';
import { ALL_TECHNOLOGIES, CORDEL_PLAY, CORDEL_CONNECT } from '../data/projects';

const TECH_MARKS: Record<string, string> = {
  bytelite: '/technologies/bytelite-technology-mark.webp',
  bytesight: '/technologies/bytesight-technology-mark.webp',
  byteflow: '/technologies/byteflow-technology-mark.webp',
  bytecost: '/technologies/bytecost-technology-mark.webp',
};
---

<Layout
  title="ByteLite LLC | Deterministic Structure for Digital Information, Vision, and Reasoning"
  description="ByteLite LLC develops a layered deterministic architecture for digital information, visual evidence, relational reasoning, and human-facing interaction — powering public products including Cordel Play and Cordel Connect."
  keywords="ByteLite LLC, deterministic systems, ByteLite, ByteSight, Deep Kore, AIya, ByteOracle, Cordel Play, Cordel Connect, Helena Montana"
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">ByteLite LLC</p>
      <h1>Deterministic systems that preserve what matters.</h1>
      <p class="hero-sub">
        ByteLite LLC develops exact digital-structure technology, inspectable visual and
        reasoning systems, and the Cordel consumer ecosystem.
      </p>
      <div class="hero-cta-row">
        <a href="/technologies" class="btn btn-primary">Explore the Technology</a>
        <a href="#products" class="btn btn-outline">Explore Cordel</a>
        <a href="/progress/validation-evidence" class="btn btn-ghost">Review Validation Evidence</a>
      </div>
    </div>
  </section>

  <!-- Audience paths -->
  <section class="section audience-section" id="audience-paths">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Where to start</p>
      <h2 style="text-align:center;margin-bottom:2.5rem;">Three ways into ByteLite LLC.</h2>
      <div class="audience-grid">
        <div class="audience-col">
          <h3 class="audience-heading">For People</h3>
          <p class="audience-sub">The consumer products, available to try or reserve today.</p>
          <ul class="audience-list">
            <li><a href="/products/cordel-play">Cordel Play</a><span>Consent-forward adult board game — founder reservation open, no charge.</span></li>
            <li><a href="/products/cordel-connect">Cordel Connect</a><span>Privacy-first compatibility app — private Android test builds.</span></li>
          </ul>
        </div>
        <div class="audience-col">
          <h3 class="audience-heading">For Organizations</h3>
          <p class="audience-sub">Partnership, licensing, and investment inquiries, routed directly.</p>
          <ul class="audience-list">
            <li><a href="/contact?type=validation-partnership">Technical validation</a><span>Submits a validation-specific inquiry.</span></li>
            <li><a href="/contact?type=licensing">Licensing</a><span>Submits a licensing-specific inquiry.</span></li>
            <li><a href="/contact?type=manufacturing">Manufacturing</a><span>Submits a manufacturing-specific inquiry.</span></li>
            <li><a href="/contact?type=distribution">Distribution</a><span>Submits a distribution-specific inquiry.</span></li>
            <li><a href="/products/cordel-connect/date-planning/restaurants/partner-program">Restaurant partnerships</a><span>Goes to the live $20 pilot signup (Stripe test mode).</span></li>
            <li><a href="/company/investors">Investment</a><span>Evidence first, then a routed investor inquiry.</span></li>
          </ul>
        </div>
        <div class="audience-col">
          <h3 class="audience-heading">For Technical Reviewers</h3>
          <p class="audience-sub">The architecture and the evidence behind every status claim.</p>
          <ul class="audience-list">
            <li><a href="/architecture">Architecture</a><span>The seven-layer deterministic structure stack.</span></li>
            <li><a href="/progress">Current status</a><span>Canonical status for every technology and product.</span></li>
            <li><a href="/progress/validation-evidence">Validation evidence</a><span>What has and has not been validated, per project.</span></li>
            <li><a href="/progress/development-timeline">Development timeline</a><span>What has already happened, with no future dates promised.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Technology architecture -->
  <section class="section section-alt" id="technologies">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">The Architecture</p>
      <h2 style="text-align:center;margin-bottom:.75rem;">A deterministic structure stack, not one autonomous agent.</h2>
      <p style="text-align:center;max-width:680px;margin:0 auto 3rem;color:#7b829e;">
        Each layer earns scope only after lower layers prove preservation, closure, permission, and
        auditability. Status and proof level are shown honestly — planned layers are labeled as planned.
      </p>
      <div class="arch-diagram">
        <img src="/architecture/bytelite-home-architecture-hierarchy.svg" alt="Diagram of ByteLite LLC branching into two groups: Consumer Products (Cordel Play, Cordel Connect, Restaurant Partner Program) and Technologies (ByteLite, ByteSight, Deep Kore, AIya, Genesis Goalkeeper, ByteOracle, ByteFlow, ByteCost), each labeled with its current canonical status." width="1600" height="980" loading="lazy" />
      </div>
      <div class="tech-grid">
        {ALL_TECHNOLOGIES.map((tech) => (
          <a href={tech.routes[0]} class="tech-card" style={`--accent:${tech.accentColor}`}>
            <div class="tech-card-head">
              {TECH_MARKS[tech.slug] && <img src={TECH_MARKS[tech.slug]} alt="" width="28" height="28" class="tech-card-mark" loading="lazy" />}
              <span class="tech-card-name">{tech.name}</span>
              <StatusBadge status={tech.status} />
            </div>
            <p class="tech-card-role">{tech.category.replace(/^Technology · /, '')}</p>
            <p class="tech-card-desc">{tech.shortDescription}</p>
            <span class="tech-card-link">Learn more &rarr;</span>
          </a>
        ))}
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/architecture" class="btn btn-outline">See the Complete Architecture &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Proof and claim posture -->
  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Proof and Claim Posture</p>
      <h2 style="margin-bottom:1.5rem;">Proof before claim.</h2>
      <div class="posture-grid">
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Claims are tied to evidence, not aspiration.</div>
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Exact reconstruction precedes any compression claim.</div>
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Determinism is internally verified before it is stated publicly.</div>
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Provenance is retained wherever applicable.</div>
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Public readiness is never claimed before proof gates close.</div>
        <div class="posture-item"><span class="posture-icon">&#9632;</span>Current capability and end-game architecture are always shown separately.</div>
      </div>
      <p style="margin-top:1.75rem;font-size:.9375rem;color:#555e7a;">
        This is not a claim that finished AGI exists, that every file compresses, or that a production
        compression product is complete. <a href="/architecture" style="color:#818cf8;">Read the full architecture &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Public product ecosystem -->
  <section class="section section-alt" id="products">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Public Products</p>
      <h2 style="text-align:center;margin-bottom:.75rem;">Built by ByteLite LLC, for people.</h2>
      <p style="text-align:center;max-width:680px;margin:0 auto 3rem;color:#7b829e;">
        Cordel Play and Cordel Connect are ByteLite LLC's public-facing products —
        where the deterministic architecture above meets real consumer experiences.
      </p>
      <SeasonalBanner style="width:100%;max-width:900px;display:block;margin:0 auto 2.5rem;border-radius:1rem;object-fit:cover;aspect-ratio:16/9;" />
      <div class="product-grid">
        <a href={CORDEL_PLAY.routes[0]} class="product-card product-card-play">
          <img src="/cordel/cordel-play-group-lifestyle-scene.webp" alt="Friends gathered around a table for a private Cordel Play session" class="product-card-img" width="960" height="540" loading="lazy" />
          <div class="product-card-inner">
            <div class="product-eyebrow">Cordel Play</div>
            <StatusBadge status={CORDEL_PLAY.status} />
            <p class="product-desc">{CORDEL_PLAY.shortDescription}</p>
            <span class="product-arrow">Explore Cordel Play &rarr;</span>
          </div>
        </a>
        <a href={CORDEL_CONNECT.routes[0]} class="product-card product-card-connect">
          <img src="/cordel-connect/cordel-connect-aiya-aion-paired-portrait.webp" alt="AIya and Aion, the Cordel Connect wingman companions" class="product-card-img" style="height:180px;object-fit:cover;" loading="lazy" />
          <div class="product-card-inner">
            <div class="product-eyebrow product-eyebrow-connect">Cordel Connect</div>
            <StatusBadge status={CORDEL_CONNECT.status} />
            <p class="product-desc">{CORDEL_CONNECT.shortDescription}</p>
            <span class="product-arrow product-arrow-connect">Explore Cordel Connect &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Founder preorder -->
  <section class="section">
    <div class="container cta-block">
      <p class="eyebrow" style="justify-content:center;display:flex;">Founder Access</p>
      <h2>Founder preorder: 10% lower price, plus 10% more.</h2>
      <p>
        Eligible products carry a founder benefit — 10% below the eventual public launch price,
        plus 10% additional entitlement (service days, usage, or an equivalent digital benefit).
        Not a flat "20% off" — two distinct benefits, disclosed before purchase.
      </p>
      <a href="/preorder" class="btn btn-primary">See Eligible Products</a>
    </div>
  </section>

  <!-- Partnerships and company -->
  <section class="section section-alt">
    <div class="container" style="max-width:900px;">
      <p class="eyebrow" style="text-align:center;">Company</p>
      <h2 style="text-align:center;margin-bottom:2.5rem;">Get in touch.</h2>
      <div class="inquiry-grid">
        <a href="/contact?type=validation-partnership" class="inquiry-card">Technical validation partnerships</a>
        <a href="/contact?type=licensing" class="inquiry-card">Licensing inquiries</a>
        <a href="/contact?type=manufacturing" class="inquiry-card">Manufacturing inquiries</a>
        <a href="/contact?type=distribution" class="inquiry-card">Distribution inquiries</a>
        <a href="/products/cordel-connect/date-planning/restaurants/partner-program" class="inquiry-card">Restaurant partnerships</a>
        <a href="/company/investors" class="inquiry-card">Investor conversations</a>
      </div>
      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/contact" class="btn btn-primary">General Contact</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>

/* Hero */
.hero {
  padding: 7rem 0 5rem;
  background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(99,102,241,.1) 0%, transparent 70%);
}
.hero h1 { max-width: 760px; }
.hero-sub {
  max-width: 640px; font-size: 1.125rem; margin-top: 1.5rem;
  color: #a0a8c0; line-height: 1.75;
}
.hero-cta-row { display: flex; gap: .875rem; flex-wrap: wrap; margin-top: 2.25rem; }
@media (max-width: 540px) { .hero { padding: 4.5rem 0 3.5rem; } }

/* Audience paths */
.audience-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; max-width: 1100px; margin: 0 auto; }
@media (max-width: 900px) { .audience-grid { grid-template-columns: 1fr; } }
.audience-col { background: #07090f; border: 1px solid #1a2235; border-radius: .875rem; padding: 1.75rem; }
.audience-heading { font-size: 1.0625rem; color: #e4e7f2; margin-bottom: .5rem; }
.audience-sub { font-size: .8125rem; color: #7b829e; margin: 0 0 1.25rem; line-height: 1.6; }
.audience-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 1rem; }
.audience-list li { display: flex; flex-direction: column; gap: .2rem; padding-top: 1rem; border-top: 1px solid #1a2235; }
.audience-list li:first-child { padding-top: 0; border-top: none; }
.audience-list a { font-size: .9375rem; font-weight: 500; color: #818cf8; }
.audience-list a:hover, .audience-list a:focus-visible { color: #a5b4fc; }
.audience-list a:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }
.audience-list span { font-size: .8125rem; color: #7b829e; line-height: 1.5; }

/* Architecture diagram */
.arch-diagram {
  max-width: 1100px; margin: 0 auto 3rem; border-radius: 1rem; overflow: hidden;
  border: 1px solid #1a2235; background: #111318;
}
.arch-diagram img { display: block; width: 100%; height: auto; }
.tech-card-mark { border-radius: .25rem; flex-shrink: 0; }

/* Technology grid */
.tech-grid {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem;
}
@media (max-width: 1000px) { .tech-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .tech-grid { grid-template-columns: 1fr; } }
.tech-card {
  display: flex; flex-direction: column; gap: .625rem;
  background: #07090f; border: 1px solid #1a2235; border-left: 3px solid var(--accent);
  border-radius: .75rem; padding: 1.5rem;
  transition: border-color .2s, transform .2s;
}
.tech-card:hover { transform: translateY(-2px); border-color: #2a3350; }
.tech-card-head { display: flex; align-items: center; justify-content: space-between; gap: .5rem; flex-wrap: wrap; }
.tech-card-name { font-size: 1.0625rem; font-weight: 700; color: #e4e7f2; }
.tech-card-role { font-size: .6875rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #555e7a; margin: 0; }
.tech-card-desc { font-size: .875rem; color: #7b829e; line-height: 1.6; margin: 0; flex: 1; }
.tech-card-link { font-size: .8125rem; font-weight: 500; color: var(--accent); margin-top: .25rem; }

/* Proof posture */
.posture-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: .875rem; }
@media (max-width: 640px) { .posture-grid { grid-template-columns: 1fr; } }
.posture-item { display: flex; gap: .75rem; align-items: flex-start; font-size: .9375rem; color: #a0a8c0; line-height: 1.6; }
.posture-icon { color: #6366f1; font-size: .5rem; flex-shrink: 0; margin-top: .4rem; }

/* Product grid */
.product-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;
  max-width: 960px; margin: 0 auto;
}
@media (max-width: 767px) { .product-grid { grid-template-columns: 1fr; } }
.product-card {
  display: block; border-radius: 1rem; overflow: hidden;
  transition: transform .2s, box-shadow .2s;
}
.product-card:hover { transform: translateY(-2px); }
.product-card-play {
  background: linear-gradient(135deg, #100d16 0%, #160b1a 100%);
  border: 1px solid rgba(244,114,182,.2);
}
.product-card-connect {
  background: linear-gradient(135deg, #090d14 0%, #0b0f1c 100%);
  border: 1px solid rgba(99,102,241,.2);
}
.product-card-img { width: 100%; height: 180px; object-fit: cover; display: block; }
.product-card-inner { padding: 2rem; display: flex; flex-direction: column; gap: .875rem; align-items: flex-start; height: 100%; }
.product-eyebrow { font-size: 1.0625rem; font-weight: 700; color: #f472b6; }
.product-eyebrow-connect { color: #818cf8; }
.product-desc { font-size: .9375rem; color: #7b829e; line-height: 1.7; margin: 0; flex: 1; }
.product-arrow { font-size: .875rem; font-weight: 500; color: #f472b6; }
.product-arrow-connect { color: #818cf8; }

/* CTA block */
.cta-block {
  background: #0d1120; border: 1px solid #1a2235;
  border-radius: 1rem; padding: 3.5rem; text-align: center;
}
.cta-block h2 { margin-bottom: 1rem; }
.cta-block p { max-width: 560px; margin: 0 auto 2rem; font-size: 1.0625rem; }

/* Inquiry grid */
.inquiry-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
@media (max-width: 700px) { .inquiry-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) { .inquiry-grid { grid-template-columns: 1fr; } }
.inquiry-card {
  background: #07090f; border: 1px solid #1a2235; border-radius: .625rem;
  padding: 1.25rem; font-size: .875rem; color: #a0a8c0; text-align: center;
  transition: border-color .2s, color .2s;
}
.inquiry-card:hover { border-color: #6366f1; color: #e4e7f2; }

</style>
