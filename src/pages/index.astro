---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ByteLiteFlow from '../components/bytelite/ByteLiteFlow.astro';
import CurrentStatusBox from '../components/bytelite/CurrentStatusBox.astro';
import CurrentVsFinal from '../components/bytelite/CurrentVsFinal.astro';
import ExactRoundtrip from '../components/bytelite/ExactRoundtrip.astro';
import WhatItIsNot from '../components/bytelite/WhatItIsNot.astro';
import PricingModels from '../components/bytelite/PricingModels.astro';
import ValidationDashboard from '../components/bytelite/ValidationDashboard.astro';
import {
  BYTELITE_LAW_PRIMARY,
  BYTELITE_LAW_SECONDARY,
  BYTELITE_HERO_WHAT,
  BYTELITE_HERO_TARGET,
  PROOF_STATEMENT,
} from '../data/bytelite';
---

<Layout
  title="ByteLite | Exact reconstruction. Smaller representation."
  description="ByteLite is developing a deterministic lossless representation architecture designed to reconstruct the exact original while reducing the complete information required to represent it. Its target is a smaller self-contained representation for every eligible source file."
  keywords="ByteLite, deterministic lossless representation, exact reconstruction, self-contained artifact, compression research, ByteLite LLC"
  canonical="https://www.thebytelite.com/"
>
  <Header slot="header" />

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">ByteLite</p>
      <h1 class="hero-law">
        <span>{BYTELITE_LAW_PRIMARY}</span>
        <span class="hero-law-2">{BYTELITE_LAW_SECONDARY}</span>
      </h1>
      <p class="hero-sub">{BYTELITE_HERO_WHAT}</p>
      <p class="hero-sub hero-sub-target">{BYTELITE_HERO_TARGET}</p>
      <div class="hero-cta">
        <a href="/how-it-works" class="btn btn-primary">How it works</a>
        <a href="/validation" class="btn btn-outline">See validation</a>
        <a href="/licensing" class="btn btn-ghost">Licensing</a>
      </div>
    </div>
  </section>

  <!-- GRAPHIC 1: the target -->
  <section class="section-sm">
    <div class="container narrow">
      <ByteLiteFlow />
    </div>
  </section>

  <!-- CURRENT STATUS -->
  <section class="section-sm">
    <div class="container narrow">
      <CurrentStatusBox />
    </div>
  </section>

  <!-- GRAPHIC 2: development vs final target -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow">Where ByteLite is</p>
      <h2>Today's proof scaffold is not the final artifact.</h2>
      <CurrentVsFinal />
    </div>
  </section>

  <!-- GRAPHIC 3: exactness -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">The precondition</p>
      <h2>The original comes back exactly.</h2>
      <p class="lede">Not "looks identical". The same bytes, or the attempt failed.</p>
      <ExactRoundtrip />
    </div>
  </section>

  <!-- GRAPHIC 6: what it is not -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow">Boundaries</p>
      <h2>What ByteLite is not.</h2>
      <WhatItIsNot />
    </div>
  </section>

  <!-- ECONOMIC MODEL -->
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Planned commercial model</p>
      <h2>Two pricing models.</h2>
      <p class="lede">
        Personal use is a flat subscription with no percentage-of-savings fee. Business and
        enterprise licensing shares verified qualifying savings 50/50.
      </p>
      <PricingModels />
      <p class="after-visual"><a href="/licensing">See pricing and licensing &rarr;</a></p>
    </div>
  </section>

  <!-- PROOF STATUS -->
  <section class="section section-alt">
    <div class="container narrow">
      <p class="eyebrow">Proof status</p>
      <h2>Target, and proof, kept apart.</h2>
      <p class="lede claim-proof-line">{PROOF_STATEMENT}</p>
      <ValidationDashboard variant="compact" />
      <p class="after-visual"><a href="/validation">See the full evidence &rarr;</a></p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container narrow final-cta">
      <h2>Where to next.</h2>
      <div class="final-cta-row">
        <a href="/how-it-works" class="btn btn-outline">How it works</a>
        <a href="/validation" class="btn btn-outline">Validation</a>
        <a href="/licensing" class="btn btn-outline">Licensing</a>
        <a href="/contact" class="btn btn-primary">Contact</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.narrow { max-width: 780px; }

.hero { padding: 6rem 0 3.5rem; background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(99,102,241,.1) 0%, transparent 70%); }
.hero-inner { max-width: 780px; }
.hero-law {
  display: flex; flex-direction: column;
  font-size: clamp(2rem, 6vw, 3.5rem); line-height: 1.08; letter-spacing: -.02em;
}
.hero-law-2 { color: #818cf8; }
.hero-sub { max-width: 640px; font-size: 1.0625rem; margin-top: 1.25rem; color: #a0a8c0; line-height: 1.75; }
.hero-sub-target { color: #7b829e; font-size: 1rem; margin-top: .875rem; }
.hero-cta { display: flex; gap: .875rem; flex-wrap: wrap; margin-top: 2.25rem; }
@media (max-width: 540px) { .hero { padding: 3.5rem 0 2.5rem; } }

h2 { margin-bottom: 1rem; }
.lede { font-size: 1.0625rem; color: #a0a8c0; line-height: 1.8; margin-bottom: 1.75rem; max-width: 640px; }
.after-visual { margin-top: 1.25rem; font-size: .9375rem; }
.after-visual a { color: #818cf8; font-weight: 500; }
.after-visual a:hover, .after-visual a:focus-visible { color: #a5b4fc; }

.claim-proof-line { border-left: 3px solid #fbbf24; padding-left: 1rem; color: #c4c8f0; }

.final-cta { text-align: center; }
.final-cta-row { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem; }
</style>
