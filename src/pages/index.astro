---
import Layout from '../layouts/Layout.astro';
import ProgramCard from '../components/site/ProgramCard.astro';
import ProofTile from '../components/site/ProofTile.astro';
import ArtFigure from '../components/site/ArtFigure.astro';
import ResearchRelationshipDiagram from '../components/site/ResearchRelationshipDiagram.astro';
import { RESEARCH_PROGRAMS } from '../data/research-programs';
import { HOME_PAGE_CAPABILITIES } from '../data/established-capabilities';
import { CONSUMER_PRODUCTS, PRODUCT_AVAILABILITY_LABEL } from '../data/products';
import { COMPANY_NAME, COMPANY_LOCATION } from '../data/company';
---

<Layout
  title="ByteLite LLC | Exact data, traceable knowledge"
  description="ByteLite LLC builds computing systems you can check: data that rebuilds byte for byte, and machine cognition designed to answer only from knowledge it can trace. Every result is labelled with its evidence."
  path="/"
>
  <section class="hero band-dark">
    <div class="wrap hero-inner">
      <div class="hero-copy">
      <p class="eyebrow">{COMPANY_NAME} &middot; Research and development &middot; {COMPANY_LOCATION}</p>
      <h1>Exact data.<br />Traceable knowledge.<br /><span class="hero-accent">Designed to distinguish evidence from uncertainty.</span></h1>
      <p class="hero-lede">
        We build computing you can check: data that rebuilds byte for byte, and machine cognition
        designed to answer only from knowledge it can trace.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="#proven">See the internal results</a>
        <a class="button button-secondary" href="/research/milestones">Track every milestone</a>
      </div>
      </div>
      <ArtFigure image={{ classification: 'Conceptual illustration', src: '/art/home-information-flow.webp', alt: 'Ribbons of blue light flowing through a transparent lattice of glass panels.', width: 1672, height: 941, caption: 'An impression of ordered information. It is not a working system.', loadsAboveTheFold: true }} />
      <p class="hero-status">
        Evidence to date is internal. Nothing has been independently verified. No product is on sale,
        and checkout is switched off. <a href="/validation">How we label evidence</a>
      </p>
    </div>
  </section>

  <section class="section" id="proven" aria-labelledby="proven-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Tested in-house</p>
        <h2 id="proven-heading">Tested internally, and what is still design.</h2>
        <p class="lede">Measured results from our own automated test runs. Each figure says exactly what it covers.</p>
      </div>
      <ul class="proof-grid">
        {HOME_PAGE_CAPABILITIES.map((capability) => <ProofTile capability={capability} />)}
      </ul>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="programs-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Research programs</p>
        <h2 id="programs-heading">Three programs. One standard: show the evidence.</h2>
      </div>
      <div class="summary-grid">
        {RESEARCH_PROGRAMS.map((program) => <ProgramCard program={program} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="vision-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Where it is going</p>
        <h2 id="vision-heading">How the programs fit together.</h2>
      </div>
      <ResearchRelationshipDiagram />
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="products-heading">
    <div class="wrap">
      <div class="products-head">
        <h2 id="products-heading">Products</h2>
        <a class="text-link" href="/products">All products &rarr;</a>
      </div>
      <ul class="product-list">
        {CONSUMER_PRODUCTS.map((product) => (
          <li>
            <a class="product-tile" href={product.href}>
              <span class="product-name">{product.displayName}</span>
              <span class="product-line">{product.oneLine}</span>
              <span class="status-badge tone-neutral">{PRODUCT_AVAILABILITY_LABEL[product.availability]}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section band-dark cta" aria-labelledby="cta-heading">
    <div class="wrap cta-inner">
      <h2 id="cta-heading">Test our claims.</h2>
      <p>Independent evaluators, research partners and licensees: pick a result and check it under your own conditions.</p>
      <div class="button-row">
        <a class="button button-primary" href="/contact?type=validation-partnership">Propose an evaluation</a>
        <a class="button button-secondary" href="/licensing">Licensing and partnerships</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero { padding-block: var(--space-9) var(--space-7); }
  .hero-inner { display: grid; gap: var(--space-6); align-items: center; }
  .hero-copy { display: grid; gap: var(--space-5); min-width: 0; }
  @media (min-width: 64rem) { .hero-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); } .hero-status { grid-column: 1 / -1; } }
  .hero h1 { font-size: clamp(2.5rem, 1.6rem + 3.2vw, 4.25rem); line-height: 1.02; letter-spacing: -0.035em; max-width: 16ch; }
  .hero-accent { display: block; margin-top: 0.3em; font-size: 0.5em; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-accent); }
  .hero-lede { font-size: var(--text-lg); max-width: 40rem; color: var(--color-ink-muted); }
  .hero-status { margin-top: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-line); font-size: var(--text-sm); color: var(--color-ink-subtle); max-width: 48rem; }
  .hero-status a { font-weight: 600; }
  @media (max-width: 63.99rem) {
    .hero-inner :global(.art-figure) { order: 2; }
    .hero-status { order: 1; margin-top: 0; }
  }
  @media (max-width: 47.99rem) { .hero { padding-block: var(--space-8) var(--space-6); } }

  .products-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); margin-bottom: var(--space-5); }
  .product-list { list-style: none; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
  .product-tile { height: 100%; display: grid; gap: var(--space-2); align-content: start; justify-items: start; padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); text-decoration: none; }
  .product-tile:hover { border-color: var(--color-ink); }
  .product-name { font-weight: 700; font-size: var(--text-lg); color: var(--color-ink); }
  .product-line { font-size: var(--text-sm); color: var(--color-ink-muted); }

  .cta { border-top: 0 !important; }
  .cta-inner { display: grid; gap: var(--space-4); justify-items: start; }
  .cta-inner p { max-width: 40rem; font-size: var(--text-md); }
</style>
