---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { COMPANY_NAME } from '../data/company';
import { PERSONAL_REPRESENTATION_SERVICE_NAME } from '../data/products';

const PARTNERSHIP_ROUTES = [
  {
    title: 'Independent evaluation',
    body: 'Reproduce or test a specific published claim under conditions you control. Evaluations never require disclosure of proprietary methods.',
    href: '/contact?type=validation-partnership',
    action: 'Propose an evaluation',
  },
  {
    title: 'Research collaboration',
    body: 'Bounded collaboration on a defined question, with clear ownership of results.',
    href: '/contact?type=technology-partnership',
    action: 'Discuss a collaboration',
  },
  {
    title: 'Licensing interest',
    body: 'Register interest in licensing once a technology has measured, validated results. Nothing is available to license today.',
    href: '/contact?type=licensing',
    action: 'Register licensing interest',
  },
  {
    title: 'Business and investor inquiries',
    body: 'General conversations about the company and its direction. This website does not offer or sell securities.',
    href: '/contact?type=investor',
    action: 'Send a business inquiry',
  },
];
---

<Layout
  title={`Licensing and Partnerships | ${COMPANY_NAME}`}
  description="Proposed commercial models and partnership routes for ByteLite LLC. Nothing is available to license or buy today."
  path="/licensing"
>
  <PageIntro
    eyebrow="Licensing and partnerships"
    heading="Proposed commercial models, and how to work together."
    lede="Nothing is available to license or buy today. This page describes the commercial models the company proposes to use once a technology has measured, validated results, and the ways to work with the company now."
  />

  <section class="section" aria-labelledby="models-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Proposed models</p>
        <h2 id="models-heading">Two models for two kinds of use.</h2>
        <p class="lede">
          These apply to the data representation research. They are proposals, not offers, and both
          depend on measured net reduction, which has not been demonstrated.
        </p>
      </div>
      <div class="card-grid">
        <article class="panel model">
          <p class="eyebrow">Personal use</p>
          <h3>{PERSONAL_REPRESENTATION_SERVICE_NAME}: a flat subscription.</h3>
          <p>
            A predictable flat subscription for personal use, with no percentage-of-savings fee, so a
            single large file can never become an unexpected bill. Use would be subject to reasonable
            personal-use and service-capacity limits.
          </p>
          <p class="small-print">No price is published while the underlying research has no working product.</p>
        </article>
        <article class="panel model">
          <p class="eyebrow">Business use</p>
          <h3>Value-based licensing.</h3>
          <p>
            For commercial workloads, the proposed model is a share of verified savings: {COMPANY_NAME}
            would receive 50% of verified qualifying savings, and the customer would keep the other 50%.
            No verified saving would mean no fee for that saving.
          </p>
          <p class="small-print">This is a split of measured savings. It is not a promise that costs fall by half.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="partnership-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Partnerships</p>
        <h2 id="partnership-heading">Ways to work with {COMPANY_NAME} now.</h2>
      </div>
      <div class="card-grid">
        {PARTNERSHIP_ROUTES.map((route) => (
          <article class="panel route">
            <h3>{route.title}</h3>
            <p>{route.body}</p>
            <a class="text-link" href={route.href}>{route.action} &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="boundaries-heading">
    <div class="wrap prose">
      <h2 id="boundaries-heading">Boundaries.</h2>
      <ul class="fact-list fact-list-plain">
        <li>No technology described on this website is available to license, and none is production qualified.</li>
        <li>No price, savings figure or return is promised anywhere on this website.</li>
        <li>Nothing on this website is an offer of securities or an investment opportunity.</li>
        <li>Any license would require a separate written agreement.</li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .model, .route { display: grid; gap: var(--space-3); align-content: start; }
  .model h3, .route h3 { font-size: var(--text-lg); }
</style>
