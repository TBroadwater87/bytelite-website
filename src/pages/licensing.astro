---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PricingModels from '../components/bytelite/PricingModels.astro';
import {
  LICENSING_HEADLINE,
  LICENSING_CORE,
  LICENSING_NO_SAVING_RULE,
  PERSONAL_PLAN,
  PERSONAL_USAGE_WORDING,
  BUSINESS_SETTLEMENT_OPTIONS,
} from '../data/bytelite';

const money = (n: number) => '$' + n.toFixed(2);
---

<Layout
  title="ByteLite Pricing and Licensing | Two pricing models"
  description="Personal ByteLite is a flat subscription at $9.99 a month or $99.99 a year, with no percentage-of-savings fee. Business and enterprise licensing is a 50/50 share of verified qualifying savings."
  keywords="ByteLite pricing, personal plan, verified savings licensing, shared savings model"
  canonical="https://www.thebytelite.com/licensing/"
>
  <Header slot="header" />

  <section class="page-hero">
    <div class="container narrow">
      <p class="planned"><span class="planned-dot" aria-hidden="true"></span>Planned commercial model</p>
      <p class="eyebrow">Pricing and licensing</p>
      <h1>{LICENSING_HEADLINE}</h1>
      <p class="hero-sub">{LICENSING_CORE}</p>
    </div>
  </section>

  <!-- The two billing models, before any figure that belongs to only one of them -->
  <section class="section-sm">
    <div class="container narrow">
      <PricingModels headingLevel={2} />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2>Personal use is a flat subscription.</h2>
      <p class="lede">
        {money(PERSONAL_PLAN.monthly)} a month, or {money(PERSONAL_PLAN.annual)} a year. That is
        the whole price.
      </p>
      <p class="body">
        A personal workload can be a single very large file. Billing a percentage of savings on
        that could turn one ordinary afternoon into an unexpectedly large charge, so personal
        accounts are not billed that way at all. There is no savings-share fee on a personal
        subscription, and the price does not move with how much ByteLite saves.
      </p>
      <p class="body">
        The annual plan replaces twelve monthly payments of {money(PERSONAL_PLAN.monthly)}, which
        total {money(PERSONAL_PLAN.twelveMonthsOfMonthly)}, and so saves
        {money(PERSONAL_PLAN.annualSaving)}.
      </p>
      <p class="body-note">{PERSONAL_USAGE_WORDING}</p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>Business licensing shares verified savings.</h2>
      <p class="lede">
        For commercial workloads, ByteLite receives 50% of verified qualifying savings and the
        customer retains the other 50%.
      </p>
      <p class="body">
        The split is of the savings, not of your costs. If a workload saves you money against an
        agreed baseline, we take half of that measured saving and you keep the other half. If it
        saves you nothing, the fee is nothing.
      </p>
      <p class="body">
        This page used to carry a worked example with dollar figures in it. I removed it. Every
        number in it was invented, and an invented number laid out like an invoice reads as
        something ByteLite has already done for somebody. It has not. When there is a real measured
        result, it will appear here with the measurement behind it.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2>The rule that matters most.</h2>
      <p class="rule">{LICENSING_NO_SAVING_RULE}</p>
      <p class="body">
        The fee is a share of savings that were measured against an agreed baseline. If a workload
        produces no verified qualifying saving, that workload produces no savings-share fee. This
        is deliberately the opposite of paying for a promise.
      </p>
      <p class="body">
        It also means the model only makes sense once ByteLite can actually be measured in a real
        environment &mdash; which is a validation question, not a pricing one.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <h2>How a savings-share account would settle.</h2>
      <p class="body">{BUSINESS_SETTLEMENT_OPTIONS}</p>
      <p class="body">
        There is no live billing on this site. Founder reservations record interest and do not
        charge anything. See <a href="/founder-access">founder access</a> for the current state of
        each product.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <h2>Availability.</h2>
      <p class="body">
        ByteLite is research under validation. It is not production-qualified, and no technology on
        this site is available to license today. The model above describes how licensing is
        intended to work when it is.
      </p>
      <p class="body">
        Organizations who want to be part of that conversation early &mdash; particularly anyone
        able to independently validate a specific claim &mdash; are the most useful people to hear
        from.
      </p>
      <div class="cta-row">
        <a href="/validation" class="btn btn-outline">See the current evidence</a>
        <a href="/contact?type=licensing" class="btn btn-primary">Licensing inquiry</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.narrow { max-width: 780px; }
.page-hero { padding: 3.5rem 0 2.5rem; }
.planned {
  display: inline-flex; align-items: center; gap: .5rem;
  font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: #fbbf24; background: rgba(251,191,36,.08); border: 1px solid rgba(251,191,36,.3);
  border-radius: 9999px; padding: .25rem .75rem; margin-bottom: 1.25rem;
}
.planned-dot { width: .4rem; height: .4rem; border-radius: 50%; background: #fbbf24; }
.hero-sub { max-width: 640px; font-size: 1.0625rem; margin-top: 1rem; color: #a0a8c0; line-height: 1.8; }
h2 { margin-bottom: .75rem; }
.lede { font-size: 1.0625rem; color: #a0a8c0; line-height: 1.75; margin-bottom: 1.5rem; }
.rule {
  font-size: 1.125rem; font-weight: 600; color: #c4c8f0; line-height: 1.6;
  background: rgba(52,211,153,.06); border: 1px solid rgba(52,211,153,.26);
  border-radius: .625rem; padding: 1.125rem 1.25rem; margin-bottom: 1.5rem;
}
.body { font-size: 1rem; color: #a0a8c0; line-height: 1.8; margin-top: 1rem; }
.body-note { font-size: .875rem; color: #7b829e; line-height: 1.7; margin-top: 1rem; }
.cta-row { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.75rem; }
</style>
