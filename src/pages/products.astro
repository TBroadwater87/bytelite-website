---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { CONSUMER_PRODUCTS, PRODUCT_AVAILABILITY_LABEL } from '../data/products';
import { COMPANY_NAME } from '../data/company';
---

<Layout
  title={`Products | ${COMPANY_NAME}`}
  description="Consumer products and applications from ByteLite LLC, with their real availability. Nothing is on sale today."
  path="/products"
>
  <PageIntro
    eyebrow="Products"
    heading="Products, and exactly where each one stands."
    lede={`Consumer products are separate from the research programs. None of the products below is available today, and checkout is switched off.`}
  />

  <section class="section" aria-labelledby="product-list-heading">
    <div class="wrap">
      <h2 id="product-list-heading" class="visually-hidden">Product list</h2>
      <div class="product-grid">
        {CONSUMER_PRODUCTS.map((product) => (
          <article class="product-card">
            <div class="product-card-top">
              <p class="eyebrow">{product.category}</p>
              <h3><a href={product.href}>{product.displayName}</a></h3>
              <span class="status-badge tone-neutral">{PRODUCT_AVAILABILITY_LABEL[product.availability]}</span>
              {product.audienceNotice && <p class="audience-notice">{product.audienceNotice}</p>}
            </div>
            <p class="product-one-line">{product.oneLine}</p>
            <p>{product.availabilityDetail}</p>
            <div class="product-columns">
              <div>
                <p class="column-label">Exists today</p>
                <ul class="fact-list fact-list-yes">{product.whatExistsToday.map((item) => <li>{item}</li>)}</ul>
              </div>
              <div>
                <p class="column-label">Does not exist yet</p>
                <ul class="fact-list fact-list-no">{product.whatDoesNotExist.map((item) => <li>{item}</li>)}</ul>
              </div>
            </div>
            <a class="text-link product-more" href={product.href}>Details<span class="visually-hidden"> about {product.displayName}</span> &rarr;</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="interest-heading">
    <div class="wrap split">
      <div class="prose">
        <h2 id="interest-heading">Founder access and support.</h2>
        <p>
          <a href="/founder-access">Founder access</a> describes the founder benefit and shows that
          reservations are not open.
          The <a href="/support">Supporter Pack</a> is likewise not on sale.
        </p>
      </div>
      <div class="prose">
        <h2>Ask about a product.</h2>
        <p>Questions about any product reach {COMPANY_NAME} directly.</p>
        <div class="button-row"><a class="button button-secondary" href="/contact">Contact {COMPANY_NAME}</a></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-grid { display: grid; gap: var(--space-5); grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .product-card { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .product-card-top { display: grid; gap: var(--space-2); justify-items: start; }
  .product-card h3 a { color: var(--color-ink); text-decoration: none; }
  .product-card h3 a:hover { text-decoration: underline; }
  .product-one-line { color: var(--color-ink); }
  .audience-notice { font-weight: 700; color: var(--color-ink); font-size: var(--text-sm); }
  .product-columns { display: grid; gap: var(--space-4); }
  .product-more { margin-top: auto; }
  .column-label { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-subtle); margin-bottom: var(--space-2); }
</style>
