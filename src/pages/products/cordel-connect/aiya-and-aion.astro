---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';
import SeasonalBanner from '../../../components/SeasonalBanner.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'ByteOracle Horoscopes', href: '/products/cordel-connect/byteoracle-horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  title="AIya & Aion | Cordel Connect | ByteLite LLC"
  description="AIya and Aion are Cordel Connect's research-preview wingman characters, built on ByteLite LLC's Deep Kore reasoning substrate. Not a production AI system."
  keywords="AIya, Aion, Cordel Connect wingman"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'AIya and Aion' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="ay-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">AIya &amp; Aion</p>
      <span class="badge badge-research" style="margin-bottom:1rem;display:inline-block;">Research Preview &mdash; Not Production AI</span>
      <h1>A friendly guide, not a real person pretending to be one.</h1>
      <p class="ay-p">
        AIya is Cordel Connect's research-preview wingman interface, built on
        <a href="/technologies/deep-kore" style="color:#818cf8;">Deep Kore</a> and described in
        full on the <a href="/technologies/deep-kore/aiya" style="color:#818cf8;">AIya technology page</a>.
        It is designed to help and encourage you — never to trick you or pretend to be a real
        person.
      </p>
      <p class="ay-p" style="margin-top:1rem;">
        Aion appears alongside AIya as a companion character in Cordel Connect's visual
        assets. A distinct functional role for Aion, separate from AIya's wingman interface, is
        not yet documented — this page will be updated once that distinction is confirmed.
      </p>
      <p class="ay-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
        No live AI companion, automated matching system, or production guidance system is
        deployed. This is in-development research only.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="ay-grid">
        <figure><SeasonalBanner type="aiya" style="width:100%;border-radius:.75rem;" loading="eager" /><figcaption>AIya</figcaption></figure>
        <figure><SeasonalBanner type="aion" style="width:100%;border-radius:.75rem;" loading="eager" /><figcaption>Aion</figcaption></figure>
        <figure><SeasonalBanner type="duo" style="width:100%;border-radius:.75rem;" loading="eager" /><figcaption>AIya and Aion, together</figcaption></figure>
        <figure><img src="/cordel/screenshots/09_settings.png" alt="A settings screen from the current private-test Cordel Connect app interface" style="aspect-ratio:9/16;width:100%;object-fit:cover;border-radius:.75rem;" loading="lazy" /><figcaption>Private-test app interface — a clean, AIya-free screen has not yet been captured without personal account data</figcaption></figure>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.ay-hero { padding: 4.5rem 0 3.5rem; }
.ay-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.ay-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; max-width: 900px; margin: 0 auto; }
@media (max-width: 700px) { .ay-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px) { .ay-grid { grid-template-columns: 1fr; } }
.ay-grid img { width: 100%; height: auto; border-radius: 1rem; border: 1px solid #1a2235; }
.ay-grid figcaption { text-align: center; font-size: .8125rem; color: #7b829e; margin-top: .625rem; }
</style>
