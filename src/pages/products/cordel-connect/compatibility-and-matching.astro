---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'Horoscopes', href: '/products/cordel-connect/horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  title="Compatibility & Matching | Cordel Connect | ByteLite LLC"
  description="Cordel Connect's compatibility questionnaire goes deeper than a swipe — from about 75 starter questions up to hundreds covering values, emotional style, and intimacy preferences."
  keywords="Cordel Connect matching, compatibility questionnaire"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Compatibility and Matching' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="cd-hero">
    <div class="container cd-hero-layout">
    <div style="max-width:820px;">
      <p class="eyebrow">Compatibility &amp; Matching</p>
      <h1>Matching that goes deeper than a swipe.</h1>
      <p class="cd-p">
        A compatibility questionnaire that starts short — about 75 questions — and can go as deep
        as you want, all the way up to hundreds of questions covering your values, how you handle
        emotions, your lifestyle, your plans for the future, and your intimacy preferences.
        Cordel Connect uses your answers to surface people you are genuinely compatible with.
      </p>
      <ul class="cd-points">
        <li>Respects your dealbreakers both ways: if something is a hard no, it won't match you with someone who fails it — and it won't match you to someone whose hard no is you.</li>
        <li>Figures out your love language, and your zodiac sign from your birthday.</li>
        <li>Gives you a daily horoscope — see <a href="/products/cordel-connect/horoscopes" style="color:#818cf8;">Horoscopes</a>.</li>
      </ul>
    </div>
    <img src="/cordel-connect/icons/compatibility-heart-checkgrid.svg" alt="" class="cd-hero-icon" width="120" height="120" loading="eager" />
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.cd-hero { padding: 4.5rem 0 3.5rem; }
.cd-hero-layout { display: flex; align-items: center; gap: 2.5rem; justify-content: space-between; }
.cd-hero-icon { flex-shrink: 0; opacity: .9; }
@media (max-width: 800px) { .cd-hero-layout { flex-direction: column-reverse; } }
.cd-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.cd-points { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
.cd-points li { position: relative; padding-left: 1.5rem; color: #7b829e; font-size: .9375rem; line-height: 1.7; }
.cd-points li::before { content: "\2192"; position: absolute; left: 0; color: #818cf8; }
</style>
