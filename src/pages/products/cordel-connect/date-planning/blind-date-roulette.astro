---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
---

<Layout
  title="Blind Date Roulette | Cordel Connect | ByteLite LLC"
  description="Cordel Connect's Blind Date Roulette pairs people spontaneously for a meal date, with a Treater/Treatie/Dutch role selection. In development."
  keywords="Blind Date Roulette, Cordel Connect"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Date Planning', href: '/products/cordel-connect/date-planning' }, { label: 'Blind Date Roulette' }]} /></div></section>

  <section class="br-hero">
    <div class="container br-hero-layout">
    <div style="max-width:820px;">
      <p class="eyebrow">Blind Date Roulette</p>
      <span class="badge badge-planned" style="margin-bottom:1rem;display:inline-block;">In development</span>
      <h1>Meet by chance, over a meal.</h1>
      <p class="br-p">
        Jump into a pool and get spontaneously paired with someone, for when you'd rather leave it
        to chance than keep scrolling. Blind Date Roulette is designed around a real-world meal
        date, with a simple role selection for who's paying:
      </p>
      <div class="br-roles">
        <div class="br-role"><h2>Treater</h2><p>You're covering the meal for your date.</p></div>
        <div class="br-role"><h2>Treatie</h2><p>Your date is covering the meal for you.</p></div>
        <div class="br-role"><h2>Dutch</h2><p>You split the bill.</p></div>
      </div>
      <p class="br-p" style="margin-top:1.5rem;color:#555e7a;font-size:.9375rem;">
        Role selection is designed to set expectations before the date, not to pressure either
        side. Safety controls (see the <a href="/products/cordel-connect/safety" style="color:#818cf8;">Safety</a> page) apply the same way to a Blind Date Roulette
        match as to any other match. Restaurant participation connects to the
        <a href="/products/cordel-connect/date-planning/restaurants" style="color:#818cf8;">restaurant suggestions</a> feature.
        This feature is in development; the pairing pool, role selection, and restaurant
        integration described above have not shipped as a complete end-to-end flow yet.
      </p>
    </div>
    <img src="/cordel-connect/icons/schedule-calendar-heart.svg" alt="" class="br-hero-icon" width="120" height="120" loading="eager" />
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.br-hero { padding: 4.5rem 0 3.5rem; }
.br-hero-layout { display: flex; align-items: center; gap: 2.5rem; justify-content: space-between; }
.br-hero-icon { flex-shrink: 0; opacity: .9; }
@media (max-width: 800px) { .br-hero-layout { flex-direction: column-reverse; } }
.br-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.br-roles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 1.75rem; }
@media (max-width: 640px) { .br-roles { grid-template-columns: 1fr; } }
.br-role { background: #0d1120; border: 1px solid #1a2235; border-radius: .625rem; padding: 1.25rem; }
.br-role h2 { font-size: 1.125rem; font-weight: 600; color: #e4e7f2; margin-bottom: .5rem; }
.br-role p { font-size: .875rem; color: #7b829e; margin: 0; }
</style>
