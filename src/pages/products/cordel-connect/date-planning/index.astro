---
import Layout from '../../../../layouts/Layout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'Horoscopes', href: '/products/cordel-connect/horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  title="Date Planning | Cordel Connect | ByteLite LLC"
  description="Cordel Connect's date-planning features: Blind Date Roulette and the restaurant suggestion program."
  keywords="Cordel Connect date planning, Blind Date Roulette, restaurants"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Date Planning' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="dp-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Date Planning</p>
      <h1>From match to meeting, without the guesswork.</h1>
      <p class="dp-p">
        Date Planning covers two related features: Blind Date Roulette for people who'd rather
        leave the pairing to chance, and real-world restaurant suggestions for planning where to
        actually go.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="dp-grid">
        <a href="/products/cordel-connect/date-planning/blind-date-roulette" class="card dp-card">
          <img src="/cordel-connect/icons/schedule-calendar-heart.svg" alt="" class="dp-card-icon" width="48" height="48" loading="lazy" />
          <h2>Blind Date Roulette</h2>
          <p>Jump into a pool and get spontaneously paired with someone, with Treater / Treatie / Dutch role selection for the meal.</p>
        </a>
        <a href="/products/cordel-connect/date-planning/restaurants" class="card dp-card">
          <img src="/cordel-connect/icons/discover-compass-heart.svg" alt="" class="dp-card-icon" width="48" height="48" loading="lazy" />
          <h2>Restaurants</h2>
          <p>Real-world date and meet-up location suggestions, honestly labeled when featured.</p>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.dp-hero { padding: 4.5rem 0 3.5rem; }
.dp-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.dp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
@media (max-width: 700px) { .dp-grid { grid-template-columns: 1fr; } }
.dp-card-icon { margin-bottom: .875rem; }
.dp-card h2 { font-weight: 600; color: #818cf8; margin-bottom: .625rem; font-size: 1.125rem; }
.dp-card p { font-size: .9375rem; color: #7b829e; margin: 0; }
</style>
