---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
---

<Layout
  noindex={true}
  title="Restaurants | Cordel Connect | ByteLite LLC"
  description="Cordel Connect suggests real-world date and meet-up locations. Featured restaurants are always honestly labeled as paid placements."
  keywords="Cordel Connect restaurants, date locations"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Date Planning', href: '/products/cordel-connect/date-planning' }, { label: 'Restaurants' }]} /></div></section>

  <section class="rs-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Restaurants</p>
      <span class="badge badge-prelaunch" style="margin-bottom:1rem;display:inline-block;">Pilot preparation · test-mode checkout</span>
      <h1>Real suggestions for where to actually go.</h1>
      <p class="rs-p">
        Cordel Connect suggests real-world date and meet-up locations to people planning to
        meet — including matches made through <a href="/products/cordel-connect/date-planning/blind-date-roulette" style="color:#818cf8;">Blind Date Roulette</a>.
        When a restaurant genuinely fits what two people are looking for, Cordel Connect can
        surface it as a <em>Featured</em> suggestion with a discount or perk the restaurant chose
        to offer — always labeled honestly as a paid placement, never disguised as a neutral pick.
      </p>
      <p class="rs-p" style="margin-top:1rem;font-size:.9375rem;color:#7b829e;">
        The Restaurant Partner Program is in pilot preparation. Its signup workflow exists and runs
        a real Stripe Checkout flow in test mode, so no real charge is processed and no real listing
        is created yet. No external restaurant has been verified as a completed pilot participant.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="asset-ph-grid" style="grid-template-columns:2fr 1fr;align-items:center;max-width:820px;margin:0 auto;">
        <img src="/marketing/restaurant-card-mockup.png" alt="How a featured restaurant appears in the Cordel Connect app, with a Featured badge and honest paid-placement disclosure" style="width:100%;border-radius:.75rem;border:1px solid #1a2235;" loading="lazy" />
        <img src="/marketing/featured-label.png" alt="The gold star Featured badge shown on paid placements" style="width:100%;max-width:220px;margin:0 auto;" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px;text-align:center;">
      <p class="rs-p" style="margin-bottom:1.5rem;">Own a restaurant and want to be featured?</p>
      <a href="/products/cordel-connect/date-planning/restaurants/partner-program" class="btn btn-primary">See the Restaurant Partner Program</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.rs-hero { padding: 4.5rem 0 3.5rem; }
.rs-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.rs-hero .badge { white-space: normal; }
.btn { white-space: normal; text-align: center; }
</style>
