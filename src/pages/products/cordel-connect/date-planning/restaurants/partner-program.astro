---
import Layout from '../../../../../layouts/Layout.astro';
import Header from '../../../../../components/Header.astro';
import Footer from '../../../../../components/Footer.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';

// No Offer/InStock structured data while Stripe checkout runs in test mode: the workflow does
// not process a real charge or create a real listing, so marking it as purchasable would be
// false to a crawler even though the $20 pilot price itself is decided.
---

<Layout
  noindex={true}
  title="Restaurant Partner Program | Cordel Connect | ByteLite LLC"
  description="Become a featured date and meet-up location inside Cordel Connect. Pilot preparation with a working test-mode signup: the $20 one-time pilot price is set, but Stripe checkout is in test mode and no real charge is processed yet."
  keywords="Cordel restaurant promotion, featured date location, restaurant marketing pilot, thebytelite"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Date Planning', href: '/products/cordel-connect/date-planning' }, { label: 'Restaurants', href: '/products/cordel-connect/date-planning/restaurants' }, { label: 'Restaurant Partner Program' }]} /></div></section>

  <!-- Hero -->
  <section class="mk-hero">
    <div class="container">
      <p class="eyebrow">Cordel Restaurant Partner Program</p>
      <h1>Be the place their date happens.</h1>
      <p class="mk-sub">
        Cordel Connect suggests real-world date and meet-up locations to people planning to
        meet. Join the program and your restaurant can be featured as one of those suggestions —
        with a deal you set, shown to people actively choosing where to go.
      </p>
      <div class="mk-cta-row">
        <a href="/marketing/signup" class="btn btn-primary">Try the pilot signup</a>
        <a href="#how" class="btn btn-outline">How it works</a>
      </div>
      <p class="mk-fineprint">
        Honest pilot pricing: <strong>$20 one-time</strong> — less than $1/day for the pilot window.
        That is the planned pilot price, and it is the only price we have set.
      </p>
      <p class="mk-fineprint">
        <strong>Pilot preparation, currently on Stripe test-mode checkout:</strong> signup runs
        through a real Stripe Checkout flow, but Stripe is in test mode — no real payment is
        processed and no real listing is created yet. This is a working demonstration of the pilot
        signup, not a public commercial launch, and no external restaurant has yet been verified as
        a completed pilot participant.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <img
        src="/marketing/date-night-table.png"
        alt="A couple sharing a candlelit dinner at a featured restaurant"
        width="1672" height="941" loading="lazy"
        style="width:100%;max-width:960px;margin:0 auto;border-radius:.75rem;border:1px solid #1a2235;aspect-ratio:16/9;object-fit:cover;display:block;"
      />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">The program</p>
      <h2>A featured spot in the moment that matters</h2>
      <div class="mk-grid">
        <div class="card">
          <h3>Featured, and labeled as such</h3>
          <p>When your restaurant genuinely fits what two people are looking for, Cordel Connect can surface it as a <em>Featured</em> suggestion. It is always labeled honestly as a paid placement — never disguised as a neutral pick.</p>
        </div>
        <div class="card">
          <h3>You set the deal</h3>
          <p>Being featured requires a real offer for Cordel users — a discount or perk you choose from a set of templated deal types. That offer becomes a redeemable code the app can present.</p>
        </div>
        <div class="card">
          <h3>No app download, no waiting on an update</h3>
          <p>Everything happens here on the web. Once approved, your restaurant flows straight into the app's suggestions — no app-store update required.</p>
        </div>
      </div>
      <div class="asset-ph-grid" style="grid-template-columns:2fr 1fr;align-items:center;margin-top:2rem;">
        <img src="/marketing/restaurant-card-mockup.png" alt="How a featured restaurant appears in the Cordel app" width="995" height="760" loading="lazy" style="width:100%;max-width:520px;height:auto;border-radius:.75rem;border:1px solid #1a2235;display:block;" />
        <img src="/marketing/featured-label.png" alt="The gold star Featured badge" width="265" height="88" loading="lazy" style="width:100%;max-width:265px;height:auto;margin:0 auto;display:block;" />
      </div>
    </div>
  </section>

  <section id="how" class="section">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>Five honest steps</h2>
      <ol class="mk-steps">
        <li><span>1</span><div><strong>Create an account</strong><p>An email and password — that is your restaurant portal login.</p></div></li>
        <li><span>2</span><div><strong>Fill a templated profile</strong><p>Name, cuisine, price tier, area, hours, dietary options, vibe, contact — plus your logo and photos.</p></div></li>
        <li><span>3</span><div><strong>Set your deal</strong><p>Choose a templated offer and the value you commit to. A discount is required to be featured.</p></div></li>
        <li><span>4</span><div><strong>Go through the $20 pilot checkout</strong><p>A one-time Stripe Checkout flow, currently running in test mode — no live charge is made. Your restaurant then enters <em>pending review</em>.</p></div></li>
        <li><span>5</span><div><strong>We review, then you go live</strong><p>An approval step we control flips your paid restaurant into a live, featured suggestion. Paid does not mean auto-published.</p></div></li>
      </ol>
      <img src="/marketing/approval-flow.png" alt="Signup-to-live approval flow" width="1672" height="941" loading="lazy" style="width:100%;max-width:1000px;height:auto;margin:2rem auto 0;border-radius:.75rem;border:1px solid #1a2235;display:block;" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow">Pricing</p>
      <h2>One decided price. The rest is coming soon.</h2>
      <div class="mk-price-grid">
        <div class="card mk-price mk-price-live">
          <span class="badge badge-prelaunch">Pilot preparation &middot; test checkout</span>
          <h3>Pilot placement</h3>
          <p class="mk-amount">$20<span>one-time</span></p>
          <p class="mk-price-note">Less than $1/day for the pilot window. Signup currently runs on a Stripe test-mode checkout — no real charge is made yet. The only price we have set.</p>
          <a href="/marketing/signup" class="btn btn-primary btn-sm">Try the pilot signup</a>
        </div>
        <div class="card mk-price mk-price-soon">
          <span class="badge badge-planned">Coming soon</span>
          <h3>Ongoing placement</h3>
          <p class="mk-amount mk-amount-tbd">To be set</p>
          <p class="mk-price-note">Monthly featured placement pricing is not decided yet. No number is implied here.</p>
        </div>
        <div class="card mk-price mk-price-soon">
          <span class="badge badge-planned">Coming soon</span>
          <h3>Premium / multi-location</h3>
          <p class="mk-amount mk-amount-tbd">To be set</p>
          <p class="mk-price-note">Premium tiers, ROI figures, and volume options are still being researched.</p>
        </div>
      </div>
      <p class="mk-fineprint mk-center">We do not invent prices or savings claims. Every value beyond the $20 pilot is marked "to be set" until it is real.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">The pilot, plainly</p>
      <h2>What the $20 pilot includes</h2>
      <p class="mk-sub">
        One-time $20, not a subscription. It is intended to cover a pilot featured-placement window
        for one restaurant: your templated profile, one committed deal, and — after you pass our
        manual review — a labeled <em>Featured</em> suggestion inside Cordel Connect. It is the
        only price we have set; ongoing placement pricing is still "to be set." Checkout is in
        Stripe test mode today, so the current signup demonstrates that flow rather than selling it.
      </p>
      <div class="mk-faq">
        <div class="mk-faq-item"><h3>Do I need the app?</h3><p>No. Everything happens here on the web. You never download Cordel Connect to sign up, set your deal, or go live.</p></div>
        <div class="mk-faq-item"><h3>Can I edit my deal?</h3><p>Before you pay, you can change your profile and deal freely. Once your listing is live, contact us and we will update it for you — self-serve editing after go-live is not open yet.</p></div>
        <div class="mk-faq-item"><h3>When do I go live?</h3><p>After checkout your restaurant enters <em>pending review</em>. It appears in the app only once we manually approve it. Completing checkout does not auto-publish your listing. While Stripe is in test mode, no real listing is created at all.</p></div>
        <div class="mk-faq-item"><h3>Can I cancel?</h3><p>The pilot is designed as a single $20 charge, so there is nothing recurring to cancel — and while checkout is in test mode, no charge is made in the first place. If you want your listing paused or removed once the pilot is real, contact us and we will take it down.</p></div>
        <div class="mk-faq-item"><h3>What photos do I need?</h3><p>Your logo and at least one photo of your space or food. You add them during signup. Paid placement is always shown as a labeled <em>Featured</em> suggestion — never disguised as a neutral pick.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container mk-final">
      <h2>Ready to be a featured date spot?</h2>
      <p>Try the pilot signup demonstration. You can build your profile and deal all the way through &mdash; checkout is currently Stripe test-mode, so no live charge is made and no real listing is created.</p>
      <a href="/marketing/signup" class="btn btn-primary">Try the pilot signup</a>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .mk-hero { padding: 5rem 0 3rem; background: radial-gradient(1200px 500px at 50% -10%, rgba(236,72,153,.10), transparent 60%); }
  .mk-sub { color: #a0a8c0; font-size: 1.125rem; line-height: 1.8; max-width: 720px; margin-top: 1rem; }
  .mk-cta-row { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .mk-fineprint { color: #7b829e; font-size: .9rem; margin-top: 1.25rem; max-width: 640px; }
  .mk-fineprint strong { color: #f472b6; }
  .mk-center { margin-left: auto; margin-right: auto; text-align: center; }
  .mk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 1.75rem; }
  .mk-grid h3 { margin-bottom: .5rem; color: #e4e7f2; }
  .mk-steps { list-style: none; margin-top: 1.75rem; display: grid; gap: 1rem; max-width: 780px; }
  .mk-steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .mk-steps li span { flex: 0 0 auto; width: 2rem; height: 2rem; border-radius: 9999px; background: rgba(99,102,241,.15); color: #818cf8; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .mk-steps li strong { color: #e4e7f2; }
  .mk-steps li p { margin-top: .15rem; }
  .mk-price-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; margin-top: 1.75rem; }
  .mk-price { display: flex; flex-direction: column; gap: .6rem; }
  .mk-price h3 { color: #e4e7f2; }
  .mk-price-live { border-color: rgba(236,72,153,.3); }
  .mk-amount { font-size: 2.25rem; font-weight: 800; color: #e4e7f2; line-height: 1; }
  .mk-amount span { font-size: .85rem; font-weight: 500; color: #7b829e; margin-left: .4rem; }
  .mk-amount-tbd { font-size: 1.5rem; color: #7b829e; }
  .mk-price-note { font-size: .9rem; }
  .mk-price .btn { margin-top: auto; align-self: flex-start; }
  .mk-final { text-align: center; }
  .mk-final p { max-width: 560px; margin: .75rem auto 1.5rem; }
  .mk-faq { display: grid; gap: 1.25rem; margin-top: 1.75rem; }
  .mk-faq-item h3 { color: #e4e7f2; margin-bottom: .35rem; }
  .mk-faq-item p { color: #a0a8c0; line-height: 1.7; }
</style>
