---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'Horoscopes', href: '/products/cordel-connect/horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  noindex={true}
  title="Games & Shared Activities | Cordel Connect | ByteLite LLC"
  description="Cordel Connect's Game Room lets matches play together — truth-or-dare, would-you-rather, chess, and trivia — as a low-pressure way to get to know each other."
  keywords="Cordel Connect game room, shared activities"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Games and Shared Activities' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="ga-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Games &amp; Shared Activities</p>
      <h1>Getting to know someone, made playful.</h1>
      <p class="ga-p">
        Once you've matched, Cordel Connect is designed to be genuinely fun to use together
        — not just another inbox. The Game Room offers games you can play with a match, from
        truth-or-dare and would-you-rather to chess and trivia, as a low-pressure way to get to
        know each other.
      </p>
      <p class="ga-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
        These features are in active development inside private test builds; availability and the
        final game list are not finalized.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="asset-ph-grid" style="grid-template-columns:1fr;max-width:340px;margin:0 auto;">
        <img src="/cordel/screenshots/23_game_room.png" alt="Cordel Connect game room screen" style="width:100%;border-radius:1.25rem;border:1px solid #1a2235;" loading="lazy" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.ga-hero { padding: 4.5rem 0 3.5rem; }
.ga-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
</style>
