---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'Horoscopes', href: '/products/cordel-connect/horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  title="Horoscopes | Cordel Connect | ByteLite LLC"
  description="Cordel Connect's daily horoscope and zodiac features: original, deterministic astronomical-interpretation content generated locally."
  keywords="Cordel Connect horoscope, zodiac compatibility"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Horoscopes' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="bo-hero">
    <div class="container bo-hero-layout">
    <div style="max-width:820px;">
      <p class="eyebrow">Daily Horoscopes</p>
      <h1>Your sign, your daily reading.</h1>
      <p class="bo-p">
        Cordel Connect derives your zodiac sign from your birthday and can surface a daily
        horoscope and ordered compatibility readings — original, deterministic astronomical
        interpretation content, calculated and generated locally rather than scraped from a
        third party or produced by a hosted language model.
      </p>
      <p class="bo-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
        The calculation engine and this integration are implemented and internally tested.
        Integration parity with the configuration the app currently deploys has not yet been
        qualified, so this is not being claimed as live for every user today.
      </p>
    </div>
    <img src="/technologies/deterministic-orbit-diagram.svg" alt="Geometric diagram of calculated celestial positions on concentric rings" class="bo-hero-icon" width="240" height="160" loading="eager" />
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.bo-hero { padding: 4.5rem 0 3.5rem; }
.bo-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.bo-hero-layout { display: flex; align-items: center; gap: 2.5rem; justify-content: space-between; }
.bo-hero-icon { flex-shrink: 0; border-radius: .75rem; border: 1px solid #1a2235; max-width: 280px; width: 100%; height: auto; }
@media (max-width: 800px) { .bo-hero-layout { flex-direction: column-reverse; } }
</style>
