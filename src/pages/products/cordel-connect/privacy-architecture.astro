---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-connect' },
  { label: 'Compatibility & Matching', href: '/products/cordel-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/cordel-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/cordel-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/cordel-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/cordel-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/cordel-connect/games-and-shared-activities' },
  { label: 'Horoscopes', href: '/products/cordel-connect/horoscopes' },
  { label: 'Date Planning', href: '/products/cordel-connect/date-planning' },
];
---

<Layout
  title="Privacy Architecture | Cordel Connect | ByteLite LLC"
  description="Cordel Connect splits sensitive survey answers into two scrambled halves sent to two separate places, so no single party — including Cordel itself — can read them."
  keywords="Cordel Connect privacy, secret sharing, data privacy"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Connect', href: '/products/cordel-connect' }, { label: 'Privacy Architecture' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="pa-hero">
    <div class="container pa-hero-layout">
      <div class="pa-hero-text">
        <p class="eyebrow">Privacy Architecture</p>
        <h1>Private answers protected by real cryptography.</h1>
        <p class="pa-p">
          When you finish the survey, your answers are mathematically split into two scrambled
          halves that are sent to two separate places — and neither half means anything on its own.
          Even Cordel's own servers can't read what you actually answered, so your most
          personal information never sits anywhere readable.
        </p>
        <p class="pa-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
          Most apps say "we protect your data." This one is built so it literally can't see it.
        </p>
      </div>
      <img src="/cordel-connect/icons/privacy-lock-heart.svg" alt="" class="pa-hero-icon" width="120" height="120" loading="eager" />
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <h2 style="margin-bottom:1.5rem;">Privacy principles.</h2>
      <div class="pa-list">
        <div class="pa-item"><span>&#10003;</span>Doesn't sell your data.</div>
        <div class="pa-item"><span>&#10003;</span>Doesn't use your private dating life to target ads.</div>
        <div class="pa-item"><span>&#10003;</span>No manipulative tricks designed to keep you hooked.</div>
        <div class="pa-item"><span>&#10003;</span>Built to be honest: no fake matches, no fake urgency.</div>
        <div class="pa-item"><span>&#10003;</span>Private test builds are not connected to advertising networks.</div>
        <div class="pa-item"><span>&#10003;</span>A full app-specific privacy policy will be published before any public launch or broader beta release.</div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.pa-hero { padding: 4.5rem 0 3.5rem; }
.pa-hero-layout { display: flex; align-items: center; gap: 2.5rem; justify-content: space-between; }
.pa-hero-text { flex: 1; min-width: 280px; }
.pa-hero-icon { flex-shrink: 0; opacity: .9; }
@media (max-width: 800px) { .pa-hero-layout { flex-direction: column-reverse; } }
.pa-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.pa-list { display: flex; flex-direction: column; gap: 1rem; }
.pa-item { display: flex; align-items: flex-start; gap: .875rem; font-size: 1rem; color: #a0a8c0; }
.pa-item span { color: #34d399; flex-shrink: 0; }
</style>
