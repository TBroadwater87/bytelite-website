---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/heartstrings-connect' },
  { label: 'Compatibility & Matching', href: '/products/heartstrings-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/heartstrings-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/heartstrings-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/heartstrings-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/heartstrings-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/heartstrings-connect/games-and-shared-activities' },
  { label: 'ByteOracle Horoscopes', href: '/products/heartstrings-connect/byteoracle-horoscopes' },
  { label: 'Date Planning', href: '/products/heartstrings-connect/date-planning' },
];
---

<Layout
  title="Safety | HeartStrings Connect | ByteLite LLC"
  description="HeartStrings Connect safety features: live location check-ins, emergency contacts, and a spoken safety phrase for real-world dates."
  keywords="HeartStrings Connect safety, date safety, emergency contacts"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'HeartStrings Connect', href: '/products/heartstrings-connect' }, { label: 'Safety' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="sf-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Safety</p>
      <h1>Safety treated as a core feature, not an afterthought.</h1>
      <p class="sf-p">
        Meeting a stranger in person is the risky part of online dating, so before or during a
        date you can share your live location with people you trust and drop check-in pins on a
        real map as the night goes — "I'm leaving now," "I've arrived," "I'm back at my car" — so
        your trusted contacts know you're okay.
      </p>
      <ul class="sf-points">
        <li>Set up emergency contacts, plus a spoken safety phrase you can say if you ever feel unsafe.</li>
        <li>Honest by design: it tells you plainly when it's contacting someone.</li>
        <li>It never pretends to be the police or 911, and it never secretly records anyone.</li>
      </ul>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="asset-ph-grid" style="grid-template-columns:1fr;max-width:340px;margin:0 auto;">
        <img src="/heartstrings/screenshots/15_safety_hub.png" alt="HeartStrings Connect safety hub screen" style="width:100%;border-radius:1.25rem;border:1px solid #1a2235;" loading="lazy" />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.sf-hero { padding: 4.5rem 0 3.5rem; }
.sf-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.sf-points { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-direction: column; gap: .875rem; }
.sf-points li { position: relative; padding-left: 1.5rem; color: #7b829e; font-size: .9375rem; line-height: 1.7; }
.sf-points li::before { content: "\2192"; position: absolute; left: 0; color: #818cf8; }
</style>
