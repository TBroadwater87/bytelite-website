---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/heartstrings-play' },
  { label: 'How It Plays', href: '/products/heartstrings-play/how-it-plays' },
  { label: 'Editions', href: '/products/heartstrings-play/editions' },
  { label: 'Components', href: '/products/heartstrings-play/components' },
  { label: 'Consent Architecture', href: '/products/heartstrings-play/consent-architecture' },
  { label: 'Development Status', href: '/products/heartstrings-play/development-status' },
  { label: 'Preorder', href: '/products/heartstrings-play/preorder' },
];
---

<Layout
  title="Components | HeartStrings Play | ByteLite LLC"
  description="What's confirmed inside the HeartStrings Play box: 350 cards across six tier decks and a Decree deck, three board configurations, the Consent Cup, and play tokens."
  keywords="HeartStrings Play components, what's in the box"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'HeartStrings Play', href: '/products/heartstrings-play' }, { label: 'Components' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="cm-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Components</p>
      <h1>350 cards, six tiers, three boards.</h1>
      <p class="cm-p">
        This page lists only components confirmed in current product documentation. Final
        manufacturing materials, a rulebook insert, and any additional accessories are not yet
        finalized and are intentionally not listed here until confirmed.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="mech-grid">
        <div class="card">
          <h3>Six tier decks (300 cards)</h3>
          <p>One 50-card deck for each escalation tier: Initiate, Connect, Seduce, Stimulate, Edge, and Climax.</p>
          <img src="/heartstrings/tier-deck-backs.jpg" alt="HeartStrings Play tier deck card backs" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Decree deck (50 cards)</h3>
          <p>A separate 50-card deck. Decree cards let any player skip, redraw, or redirect play at any time.</p>
          <img src="/heartstrings/heartstrings-play-decree-card-product.webp" alt="HeartStrings Play Decree card: purple card face with a gold infinity-heart mark" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>The board (three configurations)</h3>
          <p>A 20x20 board, a larger 20x40 board, and an Ultimate double-sided board. See <a href="/products/heartstrings-play/editions" style="color:#818cf8;">Editions</a>.</p>
          <img src="/heartstrings/heartstrings-play-board-20-space-complete.webp" alt="Complete HeartStrings Play 20-space board layout showing the tier deck strip, Decree card, and player path" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>The Consent Cup</h3>
          <p>A physical component available at any time for any player to pause or end the session. Exact unit count not yet confirmed.</p>
          <img src="/heartstrings/heartstrings-play-consent-cup-affirm.webp" alt="HeartStrings Play Consent Cup: black cylindrical cup with a clear dome lid and a pink consent sphere labeled Affirm" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Play tokens</h3>
          <p>Player tokens/movers used on the board, tracked with A/B player chips for up to 18 players. Exact material not yet confirmed.</p>
          <img src="/heartstrings/heartstrings-play-ab-player-chips.webp" alt="HeartStrings Play A/B player chips: 18 pairs of numbered snap-fit chips in distinct colors" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Dice</h3>
          <p>Six black dice with golden dots, plus red, pink, and purple Mischief dice for tier-linked prompts.</p>
          <img src="/heartstrings/heartstrings-play-black-gold-dice-product.webp" alt="Six black HeartStrings Play dice with golden pip dots" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Mischief Handbook</h3>
          <p>A companion handbook of prompts and twists that pairs with the Mischief dice.</p>
          <img src="/heartstrings/heartstrings-play-mischief-handbook-product.webp" alt="Two leather-bound HeartStrings Play Mischief Handbooks with red, pink, and purple numbered dice" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
      </div>

      <div class="mischief-icons">
        <h3>Mischief dice categories</h3>
        <p class="cm-p" style="max-width:640px;">Each Mischief die face maps to one of six prompt categories.</p>
        <div class="mischief-icon-row">
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-drink.webp" alt="Drink category icon: a cocktail glass" loading="lazy" />
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-halo.webp" alt="Halo category icon: a halo and crescent moons" loading="lazy" />
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-hands.webp" alt="Hands category icon: an open hand" loading="lazy" />
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-hearts.webp" alt="Hearts category icon: two interlocking hearts" loading="lazy" />
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-social.webp" alt="Social category icon: a party popper" loading="lazy" />
          <img src="/heartstrings/tiers/heartstrings-play-mischief-icon-strip.webp" alt="Strip category icon: a zipper" loading="lazy" />
        </div>
      </div>

      <figure class="gameflow-figure">
        <img src="/heartstrings/gameflow.jpg" alt="HeartStrings Play gameflow — how to play, step by step." loading="lazy" />
      </figure>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.cm-hero { padding: 4.5rem 0 3.5rem; }
.cm-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.mech-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 900px) { .mech-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .mech-grid { grid-template-columns: 1fr; } }
.mech-grid h3 { margin-bottom: .875rem; color: #e4e7f2; }
.gameflow-figure { max-width: 760px; margin: 2.5rem auto 0; }
.gameflow-figure img { width: 100%; height: auto; display: block; border: 1px solid #1a2235; border-radius: 14px; }
.mischief-icons { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #1a2235; }
.mischief-icons h3 { color: #e4e7f2; margin-bottom: .5rem; }
.mischief-icon-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.25rem; }
.mischief-icon-row img { width: 88px; height: 88px; border-radius: .75rem; border: 1px solid #1a2235; }
</style>
