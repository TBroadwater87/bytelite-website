---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-play' },
  { label: 'How It Plays', href: '/products/cordel-play/how-it-plays' },
  { label: 'Editions', href: '/products/cordel-play/editions' },
  { label: 'Components', href: '/products/cordel-play/components' },
  { label: 'Consent Architecture', href: '/products/cordel-play/consent-architecture' },
  { label: 'Development Status', href: '/products/cordel-play/development-status' },
  { label: 'Preorder', href: '/products/cordel-play/preorder' },
];
---

<Layout
  title="Components | Cordel Play | ByteLite LLC"
  description="What's confirmed inside the Cordel Play box: 350 cards across six tier decks and a Decree deck, three board configurations, the Consent Cup, and play tokens."
  keywords="Cordel Play components, what's in the box"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Play', href: '/products/cordel-play' }, { label: 'Components' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="cm-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Components</p>
      <h1>350 cards, six tiers, three boards.</h1>
      <p class="cm-p">
        This page lists only components confirmed in current product documentation. Final
        manufacturing materials, a rulebook insert, and any additional accessories are not yet
        finalized and are intentionally not listed here until confirmed.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="mech-grid">
        <div class="card">
          <h2>Six tier decks (300 cards)</h2>
          <p>One 50-card deck for each escalation tier: Initiate, Connect, Seduce, Stimulate, Edge, and Climax.</p>
          <img src="/cordel/cordel-play-tier-deck-backs-final.webp" alt="Cordel Play tier deck card backs: silver infinity-heart marks on Initiate, Connect, Seduce, Stimulate, Edge, Climax, and Decree" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>Decree deck (50 cards)</h2>
          <p>A separate 50-card deck of fantasy prompts. 30 of the 50 cards also carry a PASS or REDRAW symbol, and those are the cards with the best fantasies on them. Spending the symbol costs you that fantasy — escape is a real, limited resource, not a free pass. See <a href="/products/cordel-play/consent-architecture" style="color:#818cf8;">Consent Architecture</a>.</p>
          <img src="/cordel/tiers/cordel-play-decree-card-final.webp" alt="Cordel Play Decree card: purple card face with a silver infinity-heart mark" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>The board (three configurations)</h2>
          <p>A 20x20 board, a larger 20x40 board, and an Ultimate double-sided board. See <a href="/products/cordel-play/editions" style="color:#818cf8;">Editions</a>.</p>
          <img src="/cordel/cordel-play-board-20x40-final.webp" alt="Complete Cordel Play board layout showing the tier deck strip, Decree card, and player path" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>The Consent Cup</h2>
          <p>Brought out only when a landed-on activity needs another participant. Interested players place a Consent Sphere into the cup; the cup then selects one. Holds up to 18 spheres. See <a href="/products/cordel-play/consent-architecture" style="color:#818cf8;">Consent Architecture</a>.</p>
          <img src="/cordel/cordel-play-consent-cup-final.webp" alt="Cordel Play Consent Cup: matte black cup with engraved silver Cordel Play wordmark and a clear dome lid capturing a consent sphere" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>Play tokens</h2>
          <p>Player tokens/movers used on the board, tracked with A/B player chips for up to 18 players. Exact material not yet confirmed.</p>
          <img src="/cordel/cordel-play-ab-player-chips.webp" alt="Cordel Play A/B player chips: 18 pairs of numbered snap-fit chips in distinct colors" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>Dice</h2>
          <p>Six black dice with golden dots, plus red, pink, and purple Mischief dice for tier-linked prompts.</p>
          <img src="/cordel/cordel-play-black-gold-dice-product.webp" alt="Six black Cordel Play dice with golden pip dots" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h2>Mischief Handbook</h2>
          <p>A companion handbook of prompts and twists that pairs with the Mischief dice.</p>
          <img src="/cordel/cordel-play-mischief-handbook-product.webp" alt="Two leather-bound Cordel Play Mischief Handbooks with red, pink, and purple numbered dice" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
      </div>

      <div class="mischief-icons">
        <h2>Mischief dice categories</h2>
        <p class="cm-p" style="max-width:640px;">Each Mischief die face maps to one of six prompt categories.</p>
        <div class="mischief-icon-row">
          <img src="/cordel/tiers/cordel-play-mischief-icon-drink.webp" alt="Drink category icon: a cocktail glass" loading="lazy" />
          <img src="/cordel/tiers/cordel-play-mischief-icon-halo.webp" alt="Halo category icon: a halo and crescent moons" loading="lazy" />
          <img src="/cordel/tiers/cordel-play-mischief-icon-hands.webp" alt="Hands category icon: an open hand" loading="lazy" />
          <img src="/cordel/tiers/cordel-play-mischief-icon-hearts.webp" alt="Hearts category icon: two interlocking hearts" loading="lazy" />
          <img src="/cordel/tiers/cordel-play-mischief-icon-social.webp" alt="Social category icon: a party popper" loading="lazy" />
          <img src="/cordel/tiers/cordel-play-mischief-icon-strip.webp" alt="Strip category icon: a zipper" loading="lazy" />
        </div>
      </div>

      <figure class="gameflow-figure">
        <img src="/cordel/cordel-play-board-20x20-final.webp" alt="The complete Cordel Play 20x20 board layout: the player path, tier decks, Decree deck, and the AIya and Aion host cards" style="width:100%;object-fit:cover;border-radius:.75rem;" loading="lazy" />
      </figure>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.cm-hero { padding: 4.5rem 0 3.5rem; }
.cm-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.mech-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 900px) { .mech-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .mech-grid { grid-template-columns: 1fr; } }
.mech-grid h2 { font-size: clamp(1.1rem, 2.2vw, 1.5rem); font-weight: 600; margin-bottom: .875rem; color: #e4e7f2; }
.gameflow-figure { max-width: 760px; margin: 2.5rem auto 0; }
.gameflow-figure img { width: 100%; height: auto; display: block; border: 1px solid #1a2235; border-radius: 14px; }
.mischief-icons { margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #1a2235; }
.mischief-icons h2 { font-size: clamp(1.1rem, 2.2vw, 1.5rem); font-weight: 600; color: #e4e7f2; margin-bottom: .5rem; }
.mischief-icon-row { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 1.25rem; }
.mischief-icon-row img { width: 88px; height: 88px; border-radius: .75rem; border: 1px solid #1a2235; }
</style>
