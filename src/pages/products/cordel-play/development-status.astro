---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';
import ProjectPageHero from '../../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../../components/ProjectDetailSections.astro';
import { CORDEL_PLAY } from '../../../data/projects';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-play' },
  { label: 'How It Plays', href: '/products/cordel-play/how-it-plays' },
  { label: 'Editions', href: '/products/cordel-play/editions' },
  { label: 'Components', href: '/products/cordel-play/components' },
  { label: 'Consent Architecture', href: '/products/cordel-play/consent-architecture' },
  { label: 'Development Status', href: '/products/cordel-play/development-status' },
  { label: 'Preorder', href: '/products/cordel-play/preorder' },
];
---

<Layout
  noindex={true}
  title="Development Status | Cordel Play | ByteLite LLC"
  description="Current development status of Cordel Play: product design is complete, manufacturing is in preparation, no retail release date has been announced."
  keywords="Cordel Play status, manufacturing, pre-launch"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Play', href: '/products/cordel-play' }, { label: 'Development Status' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <ProjectPageHero project={CORDEL_PLAY} displayName="Cordel Play — Development Status" />

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <div class="hs-status-box">
        <p>Cordel Play has not been released for retail sale. No purchase date has been
        announced. Product design is complete. Manufacturing is in preparation.</p>
        <a href="/products/cordel-play/preorder" class="btn btn-pink btn-sm" style="margin-top:1.25rem;">Founder Reservation</a>
      </div>
    </div>
  </section>

  <ProjectDetailSections project={CORDEL_PLAY} />

  <Footer slot="footer" />
</Layout>

<style>
.hs-status-box { background: #0d1120; border: 1px solid #24304a; border-radius: .875rem; padding: 2rem; }
.hs-status-box p { font-size: .9375rem; line-height: 1.7; color: #a0a8c0; }
</style>
