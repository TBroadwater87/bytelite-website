---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/heartstrings-play' },
  { label: 'How It Plays', href: '/products/heartstrings-play/how-it-plays' },
  { label: 'Editions', href: '/products/heartstrings-play/editions' },
  { label: 'Components', href: '/products/heartstrings-play/components' },
  { label: 'Consent Architecture', href: '/products/heartstrings-play/consent-architecture' },
  { label: 'Development Status', href: '/products/heartstrings-play/development-status' },
  { label: 'Preorder', href: '/products/heartstrings-play/preorder' },
];
---

<Layout
  title="Editions | HeartStrings Play | ByteLite LLC"
  description="The three HeartStrings Play board configurations: 20x20, 20x40, and the double-sided Ultimate board."
  keywords="HeartStrings Play editions, board configurations"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'HeartStrings Play', href: '/products/heartstrings-play' }, { label: 'Editions' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="ed-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Editions</p>
      <h1>Three board configurations, one core game.</h1>
      <p class="ed-p">
        HeartStrings Play currently ships as one core game with three interchangeable board
        configurations, rather than separate intimate/party product editions. If distinct packaged
        editions are introduced later, this page will be updated to reflect that — nothing beyond
        the three board configurations below is currently confirmed.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="ed-grid">
        <div class="card ed-card">
          <img src="/heartstrings/board-20x20.jpg" alt="HeartStrings Play 20x20 board" loading="lazy" />
          <h3>20x20 Board</h3>
          <p>The standard board configuration — a compact, focused session layout.</p>
        </div>
        <div class="card ed-card">
          <img src="/heartstrings/board-20x40.jpg" alt="HeartStrings Play 20x40 board" loading="lazy" />
          <h3>20x40 Board</h3>
          <p>A larger layout for bigger groups or longer sessions.</p>
        </div>
        <div class="card ed-card">
          <img src="/heartstrings/board-ultimate.jpg" alt="HeartStrings Play Ultimate double-sided board" loading="lazy" />
          <h3>Ultimate Board</h3>
          <p>A double-sided board that unfolds and flips, with a different layout on each side to change how the game is played.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.ed-hero { padding: 4.5rem 0 3.5rem; }
.ed-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.ed-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 900px) { .ed-grid { grid-template-columns: 1fr; } }
.ed-card img { width: 100%; height: auto; border-radius: .5rem; margin-bottom: 1.25rem; }
.ed-card h3 { color: #f472b6; margin-bottom: .5rem; }
.ed-card p { font-size: .9375rem; color: #7b829e; }
</style>
