---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-play' },
  { label: 'How It Plays', href: '/products/cordel-play/how-it-plays' },
  { label: 'Editions', href: '/products/cordel-play/editions' },
  { label: 'Components', href: '/products/cordel-play/components' },
  { label: 'Consent Architecture', href: '/products/cordel-play/consent-architecture' },
  { label: 'Development Status', href: '/products/cordel-play/development-status' },
  { label: 'Preorder', href: '/products/cordel-play/preorder' },
];
---

<Layout
  title="How It Plays | Cordel Play | ByteLite LLC"
  description="How a Cordel Play session works: action squares, the six escalation tiers, and player scaling from 2 to 18 players."
  keywords="Cordel Play rules, how to play, escalation tiers"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Cordel Play', href: '/products/cordel-play' }, { label: 'How It Plays' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="hp-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">How It Plays</p>
      <h1>One shared session, set by the group.</h1>
      <p class="hp-p">
        Players take turns moving around the board and landing on action squares that trigger
        game actions. Cards are drawn from the six escalation tier decks, and the group moves up
        the tiers together, at whatever pace everyone agrees to.
      </p>
      <p class="hp-p" style="margin-top:1rem;">
        There is no fixed script and no forced escalation. A Decree card or the Consent Cup is
        always within reach, so any player can redirect or pause the session at any time.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <p class="eyebrow" style="text-align:center;">On the Board</p>
      <h2 style="text-align:center;margin-bottom:1.5rem;">Action squares drive each turn.</h2>
      <p class="hp-p" style="text-align:center;">
        As players move around the board they land on action squares that trigger game actions.
        The action squares are a board mechanic, separate from the six escalation tiers, and they
        keep each turn varied without a fixed script.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Six Escalation Tiers</p>
      <h2 style="margin-bottom:2.5rem;">Progress at your pace.</h2>
      <div class="tiers-grid">
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-initiate-graphic.webp" alt="Initiate tier card, pale pink with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">1</span><span class="tier-name">Initiate</span><span class="tier-desc">Entry. Low stakes. Setting the tone.</span></div>
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-connect-graphic.webp" alt="Connect tier card, rose pink with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">2</span><span class="tier-name">Connect</span><span class="tier-desc">Building rapport. Shared presence.</span></div>
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-seduce-graphic.webp" alt="Seduce tier card, magenta with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">3</span><span class="tier-name">Seduce</span><span class="tier-desc">Intentional flirtation. Energy shifts.</span></div>
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-stimulate-graphic.webp" alt="Stimulate tier card, amber orange with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">4</span><span class="tier-name">Stimulate</span><span class="tier-desc">Heightened engagement. Closer attention.</span></div>
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-edge-graphic.webp" alt="Edge tier card, deep red with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">5</span><span class="tier-name">Edge</span><span class="tier-desc">Near the limit. High intention required.</span></div>
        <div class="tier-card"><img src="/cordel/tiers/cordel-play-tier-card-climax-graphic.webp" alt="Climax tier card, dark crimson with a gold infinity-heart mark" width="300" height="420" loading="lazy" /><span class="tier-num">6</span><span class="tier-name">Climax</span><span class="tier-desc">Full escalation. For groups who have agreed.</span></div>
      </div>
      <p class="hp-p" style="margin-top:1.5rem;">
        Tier selection carries a consent ceiling: a group only draws from tiers everyone present
        has agreed to reach. See <a href="/products/cordel-play/consent-architecture" style="color:#f472b6;">Consent Architecture</a> for how tier pacing, Decree cards, and the Consent Cup work together.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <p class="eyebrow">Player Scaling</p>
      <h2 style="margin-bottom:1.25rem;">From two players to eighteen.</h2>
      <p class="hp-p">
        Cordel Play is built for private groups of 2 to 18 players — an intimate session for
        a couple or a larger gathering of friends who have agreed to play together.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.hp-hero { padding: 4.5rem 0 3.5rem; }
.hp-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.tiers-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
@media (max-width: 900px) { .tiers-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 480px) { .tiers-grid { grid-template-columns: repeat(2, 1fr); } }
.tier-card { display: flex; flex-direction: column; gap: .375rem; }
.tier-card img { width: 100%; height: auto; border-radius: .5rem; border: 1px solid #1a2235; }
.tier-num { font-size: .75rem; font-weight: 600; color: #4a5068; }
.tier-name { font-size: .9375rem; font-weight: 600; color: #e4e7f2; }
.tier-desc { font-size: .8125rem; color: #7b829e; line-height: 1.4; }
</style>
