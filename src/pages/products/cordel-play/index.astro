---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import { CORDEL_PLAY } from '../../../data/projects';

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Cordel Play',
  description: CORDEL_PLAY.shortDescription,
  category: 'Board Game',
  brand: { '@type': 'Organization', name: 'ByteLite LLC' },
};

const SUBNAV = [
  { label: 'Overview', href: '/products/cordel-play' },
  { label: 'How It Plays', href: '/products/cordel-play/how-it-plays' },
  { label: 'Editions', href: '/products/cordel-play/editions' },
  { label: 'Components', href: '/products/cordel-play/components' },
  { label: 'Consent Architecture', href: '/products/cordel-play/consent-architecture' },
  { label: 'Development Status', href: '/products/cordel-play/development-status' },
  { label: 'Preorder', href: '/products/cordel-play/preorder' },
];
---

<Layout
  title="Cordel Play | Consent-Forward Adult Board Game | ByteLite LLC"
  description="Cordel Play is ByteLite LLC's premium consent-first adult social board game for private groups of 2 to 18 players."
  keywords="Cordel Play, adult social board game, consent-first, ByteLite LLC"
>
  <Header slot="header" />
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Cordel Play' }]} /></div>
  </section>

  <ProductSubNav items={SUBNAV} />

  <!-- Hero -->
  <section class="hs-hero">
    <div class="container">
      <p class="eyebrow">Cordel Play</p>
      <h1>A consent-first social board game<br/>for private groups.</h1>
      <p class="hs-hero-sub">
        Premium adult social play built around intentional connection, shared agency, and
        escalating card-based experiences. For private groups of two to eighteen players.
      </p>
      <div class="hs-hero-badges">
        <StatusBadge status={CORDEL_PLAY.status} />
        <span class="hs-badge-detail">Manufacturing preparation underway</span>
      </div>
      <div style="display:flex;gap:.875rem;flex-wrap:wrap;margin-top:2rem;">
        <a href="/products/cordel-play/preorder" class="btn btn-pink">Founder Reservation</a>
        <a href="/products/cordel-play/how-it-plays" class="btn btn-outline btn-sm" style="align-self:center;">How It Plays</a>
      </div>
    </div>
  </section>

  <!-- Quick specs -->
  <section class="section-sm section-alt">
    <div class="container hs-specs-row">
      <div class="hs-spec"><span class="hs-spec-num">2–18</span><span class="hs-spec-label">Players</span></div>
      <div class="hs-spec-div"></div>
      <div class="hs-spec"><span class="hs-spec-num">350</span><span class="hs-spec-label">Cards</span></div>
      <div class="hs-spec-div"></div>
      <div class="hs-spec"><span class="hs-spec-num">6</span><span class="hs-spec-label">Escalation tiers</span></div>
      <div class="hs-spec-div"></div>
      <div class="hs-spec"><span class="hs-spec-num">3</span><span class="hs-spec-label">Board versions</span></div>
    </div>
  </section>

  <!-- About the game -->
  <section class="section">
    <div class="container" style="max-width:760px;">
      <p class="eyebrow">The Game</p>
      <h2 style="margin-bottom:1.25rem;">Designed for intentional play.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;margin-bottom:1.5rem;">
        Cordel Play is a premium adult social board game where players move across a board
        of action squares and draw from six escalating tier decks as the session builds. Each
        session is shaped by the players in it — not by a fixed script.
      </p>
      <p style="font-size:1.0625rem;line-height:1.8;">
        Decree cards allow any player to skip or redraw at any time. Consent is built into the
        game structure, not handled separately. The Consent Cup is available at any time for any
        player to end or pause play gracefully. See the full
        <a href="/products/cordel-play/consent-architecture" style="color:#f472b6;">Consent Architecture</a> page.
      </p>
    </div>
  </section>

  <!-- The Components -->
  <section class="section section-alt">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">The Components</p>
      <h2 style="text-align:center;margin-bottom:2.5rem;">Figural token tops.</h2>
      <p style="text-align:center;color:#555e7a;font-size:.875rem;margin:-1.5rem 0 2rem;">Box front and back art is still in production — shown here are the physical player tokens.</p>
      <div class="asset-ph-grid" style="grid-template-columns:repeat(2,minmax(0,1fr));max-width:820px;margin:0 auto;">
        <img src="/cordel/cordel-tokens-1.png" alt="Cordel Play figural token tops — tie, dice, and playing-card designs" style="aspect-ratio:1/1;width:100%;object-fit:cover;border-radius:.75rem;" loading="lazy" />
        <img src="/cordel/cordel-tokens-2.png" alt="Cordel Play figural token tops — zipper, heel, and lipstick designs" style="aspect-ratio:1/1;width:100%;object-fit:cover;border-radius:.75rem;" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Section links -->
  <section class="section">
    <div class="container">
      <p class="eyebrow" style="text-align:center;">Explore Cordel Play</p>
      <div class="hs-explore-grid">
        <a href="/products/cordel-play/how-it-plays" class="card hs-explore-card">
          <h3>How It Plays</h3><p>Action squares, the six escalation tiers, and player scaling.</p>
        </a>
        <a href="/products/cordel-play/editions" class="card hs-explore-card">
          <h3>Editions</h3><p>The three board configurations and how they change the game.</p>
        </a>
        <a href="/products/cordel-play/components" class="card hs-explore-card">
          <h3>Components</h3><p>What's confirmed to ship in the box today.</p>
        </a>
        <a href="/products/cordel-play/consent-architecture" class="card hs-explore-card">
          <h3>Consent Architecture</h3><p>Decree cards, the Consent Cup, and tier-based pacing.</p>
        </a>
        <a href="/products/cordel-play/development-status" class="card hs-explore-card">
          <h3>Development Status</h3><p>What's finished, what's in progress, and what's next.</p>
        </a>
        <a href="/products/cordel-play/preorder" class="card hs-explore-card">
          <h3>Preorder</h3><p>Founder reservation terms ahead of retail release.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- App companion -->
  <section class="section section-alt">
    <div class="container hs-app-companion">
      <div class="hs-app-text">
        <p class="eyebrow">Digital Companion</p>
        <h2>Built alongside Cordel Connect.</h2>
        <p style="margin-top:1rem;font-size:1.0625rem;line-height:1.8;">
          Cordel Connect is ByteLite LLC's private companion app, in active Android test
          development alongside Cordel Play.
        </p>
        <a href="/products/cordel-connect" class="btn btn-outline btn-sm" style="margin-top:1.5rem;display:inline-flex;">See Cordel Connect &rarr;</a>
      </div>
      <div class="hs-app-screens" aria-hidden="true">
        <div class="hs-phone-mini">
          <img src="/cordel/screenshots/29_discover_carousel.png" alt="Cordel Connect discover carousel — private development" loading="lazy" />
        </div>
        <div class="hs-phone-mini hs-phone-offset">
          <img src="/cordel/screenshots/06_matches.png" alt="Cordel Connect matches screen — private development" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Ecosystem note -->
  <section class="section-sm">
    <div class="container" style="max-width:760px;text-align:center;">
      <p style="font-size:.875rem;color:#4a5068;">Part of the ByteLite LLC technology portfolio.</p>
      <p style="font-size:.875rem;color:#4a5068;margin-top:.375rem;">
        Cordel Play is a flagship public product built on ByteLite LLC's deterministic
        architecture. <a href="/technologies" style="color:#555e7a;">See the Technologies &rarr;</a>
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.hs-hero { padding: 4.5rem 0 4rem; background: radial-gradient(ellipse 70% 50% at 50% -5%, rgba(236,72,153,.07) 0%, transparent 70%); }
.hs-hero h1 { max-width: 680px; }
.hs-hero-sub { max-width: 560px; margin-top: 1.25rem; font-size: 1.0625rem; color: #7b829e; line-height: 1.75; }
.hs-hero-badges { display: flex; align-items: center; gap: 1rem; margin-top: 1.5rem; flex-wrap: wrap; }
.hs-badge-detail { font-size: .8125rem; color: #555e7a; }
.hs-specs-row { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
.hs-spec { text-align: center; flex: 1; min-width: 80px; }
.hs-spec-num { display: block; font-size: 2rem; font-weight: 700; color: #f472b6; letter-spacing: -.04em; line-height: 1; }
.hs-spec-label { font-size: .75rem; color: #7b829e; margin-top: .25rem; }
.hs-spec-div { width: 1px; height: 2.5rem; background: #1a2235; flex-shrink: 0; }
@media (max-width: 640px) { .hs-spec-div { display: none; } }
.hs-explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 900px) { .hs-explore-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 560px) { .hs-explore-grid { grid-template-columns: 1fr; } }
.hs-explore-card h3 { color: #f472b6; margin-bottom: .5rem; font-size: 1.0625rem; }
.hs-explore-card p { font-size: .875rem; color: #7b829e; margin: 0; }
.hs-app-companion { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 3rem; align-items: center; }
@media (max-width: 767px) { .hs-app-companion { grid-template-columns: 1fr; } .hs-app-screens { display: none; } }
.hs-app-screens { display: flex; gap: 1.25rem; justify-content: center; align-items: flex-start; }
.hs-phone-mini { width: 140px; flex-shrink: 0; border-radius: 1.5rem; border: 1px solid #24304a; box-shadow: 0 8px 28px rgba(0,0,0,.45); overflow: hidden; background: #0d1120; }
.hs-phone-mini img { width: 100%; height: auto; display: block; }
.hs-phone-offset { margin-top: 2rem; }
</style>
