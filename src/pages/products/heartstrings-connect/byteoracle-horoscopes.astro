---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/heartstrings-connect' },
  { label: 'Compatibility & Matching', href: '/products/heartstrings-connect/compatibility-and-matching' },
  { label: 'Privacy Architecture', href: '/products/heartstrings-connect/privacy-architecture' },
  { label: 'Safety', href: '/products/heartstrings-connect/safety' },
  { label: 'Cartoonized Profiles', href: '/products/heartstrings-connect/cartoonized-profiles' },
  { label: 'AIya & Aion', href: '/products/heartstrings-connect/aiya-and-aion' },
  { label: 'Games & Activities', href: '/products/heartstrings-connect/games-and-shared-activities' },
  { label: 'ByteOracle Horoscopes', href: '/products/heartstrings-connect/byteoracle-horoscopes' },
  { label: 'Date Planning', href: '/products/heartstrings-connect/date-planning' },
];
---

<Layout
  title="ByteOracle Horoscopes | HeartStrings Connect | ByteLite LLC"
  description="HeartStrings Connect's daily horoscope and zodiac features, powered by ByteOracle — ByteLite LLC's deterministic astronomical-interpretation concept."
  keywords="HeartStrings Connect horoscope, ByteOracle, zodiac compatibility"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'HeartStrings Connect', href: '/products/heartstrings-connect' }, { label: 'ByteOracle Horoscopes' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="bo-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Powered by ByteOracle</p>
      <h1>Your sign, your daily reading.</h1>
      <p class="bo-p">
        HeartStrings Connect derives your zodiac sign from your birthday and surfaces a daily
        horoscope inside the app. This feature is powered by
        <a href="/technologies/byteoracle" style="color:#a78bfa;">ByteOracle</a>, ByteLite LLC's
        concept for deterministic, locally-calculated astronomical interpretation.
      </p>
      <p class="bo-p" style="margin-top:1rem;color:#555e7a;font-size:.9375rem;">
        Today this means a sign and a daily reading. The fuller design — a full ordered
        compatibility matrix across all sign pairs, generated deterministically rather than
        scraped or templated — is a target architecture, not a current feature. See the
        <a href="/technologies/byteoracle" style="color:#818cf8;">ByteOracle technology page</a>
        for the honest current-vs-target breakdown.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.bo-hero { padding: 4.5rem 0 3.5rem; }
.bo-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
</style>
