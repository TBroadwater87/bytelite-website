---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductSubNav from '../../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Overview', href: '/products/heartstrings-play' },
  { label: 'How It Plays', href: '/products/heartstrings-play/how-it-plays' },
  { label: 'Editions', href: '/products/heartstrings-play/editions' },
  { label: 'Components', href: '/products/heartstrings-play/components' },
  { label: 'Consent Architecture', href: '/products/heartstrings-play/consent-architecture' },
  { label: 'Development Status', href: '/products/heartstrings-play/development-status' },
  { label: 'Preorder', href: '/products/heartstrings-play/preorder' },
];
---

<Layout
  title="Components | HeartStrings Play | ByteLite LLC"
  description="What's confirmed inside the HeartStrings Play box: 350 cards across six tier decks and a Decree deck, three board configurations, the Consent Cup, and play tokens."
  keywords="HeartStrings Play components, what's in the box"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'HeartStrings Play', href: '/products/heartstrings-play' }, { label: 'Components' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="cm-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Components</p>
      <h1>350 cards, six tiers, three boards.</h1>
      <p class="cm-p">
        This page lists only components confirmed in current product documentation. Final
        manufacturing materials, a rulebook insert, and any additional accessories are not yet
        finalized and are intentionally not listed here until confirmed.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="mech-grid">
        <div class="card">
          <h3>Six tier decks (300 cards)</h3>
          <p>One 50-card deck for each escalation tier: Initiate, Connect, Seduce, Stimulate, Edge, and Climax.</p>
          <img src="/heartstrings/tier-deck-backs.jpg" alt="HeartStrings Play tier deck card backs" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Decree deck (50 cards)</h3>
          <p>A separate 50-card deck. Decree cards let any player skip, redraw, or redirect play at any time.</p>
        </div>
        <div class="card">
          <h3>The board (three configurations)</h3>
          <p>A 20x20 board, a larger 20x40 board, and an Ultimate double-sided board. See <a href="/products/heartstrings-play/editions" style="color:#818cf8;">Editions</a>.</p>
        </div>
        <div class="card">
          <h3>The Consent Cup</h3>
          <p>A physical component available at any time for any player to pause or end the session. Exact unit count not yet confirmed.</p>
          <img src="/heartstrings/consent-cup.jpg" alt="HeartStrings Play Consent Cup component" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
        <div class="card">
          <h3>Play tokens</h3>
          <p>Player tokens/movers used on the board. Exact material and count not yet confirmed.</p>
          <img src="/heartstrings/token-cutaway.jpg" alt="HeartStrings Play token cutaway detail" loading="lazy" style="margin-top:1rem;border-radius:.5rem;" />
        </div>
      </div>

      <figure class="gameflow-figure">
        <img src="/heartstrings/gameflow.jpg" alt="HeartStrings Play gameflow — how to play, step by step." loading="lazy" />
      </figure>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.cm-hero { padding: 4.5rem 0 3.5rem; }
.cm-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.mech-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 900px) { .mech-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .mech-grid { grid-template-columns: 1fr; } }
.mech-grid h3 { margin-bottom: .875rem; color: #e4e7f2; }
.gameflow-figure { max-width: 760px; margin: 2.5rem auto 0; }
.gameflow-figure img { width: 100%; height: auto; display: block; border: 1px solid #1a2235; border-radius: 14px; }
</style>
