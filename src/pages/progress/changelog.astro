---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
  { label: 'Development Timeline', href: '/progress/development-timeline' },
  { label: 'Changelog', href: '/progress/changelog' },
];
---

<Layout
  title="Changelog | Progress | ByteLite LLC"
  description="Dated changes to ByteLite LLC's public website and product positioning."
  keywords="ByteLite LLC changelog"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Progress', href: '/progress' }, { label: 'Changelog' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="cl-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Changelog</p>
      <h1>Dated changes to this website and its positioning.</h1>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <div class="cl-list">
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(167,139,250,.15);color:#a78bfa;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/></svg></span>2026-07-26</span>
          <h3>ByteLite LLC technology-first site rearchitecture</h3>
          <p>Homepage rebuilt around ByteLite LLC's deterministic-technology portfolio rather than Cordel Play. Added full Technologies, Architecture, Progress, Preorder, and Company sections; split Cordel Play and Cordel Connect into per-topic subpages; added a canonical project-data model driving status across the site.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(236,72,153,.15);color:#ec4899;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M4 7h16M4 12h16M4 17h10"/></svg></span>2026-07-17</span>
          <h3>Cordel Connect renamed</h3>
          <p>"Cordel App" formally renamed to Cordel Connect across the site.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(129,140,248,.15);color:#818cf8;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M4 21V9l8-6 8 6v12"/></svg></span>2026-07-09</span>
          <h3>Restaurant Partner Program pilot launched</h3>
          <p>Self-serve restaurant signup portal at /marketing, with Stripe test-mode payment and a manual admin review gate before any listing goes live.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(52,211,153,.15);color:#34d399;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg></span>2026-05-13</span>
          <h3>Proof-gated claim audit</h3>
          <p>Removed patent-status framing, specific compression-ratio claims, and AGI-adjacent language from the public site. Rebuilt homepage, Cordel Play, Cordel Connect, Research, Status, About, Contact, Privacy, and Terms pages around a consistent proof-gated claim structure.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(236,72,153,.15);color:#ec4899;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M4 21V9l8-6 8 6v12"/></svg></span>2026-04-17</span>
          <h3>Cordel Play established as first public product</h3>
          <p>Site pivoted to lead with Cordel Play as the first public-facing consumer product, with ByteLite research positioned as a secondary path.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(52,211,153,.15);color:#34d399;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><rect x="4" y="9" width="16" height="11" rx="1.5"/><path d="M8 9V6a4 4 0 018 0v3"/></svg></span>2025-11-14</span>
          <h3>Security, testing, and tooling remediation</h3>
          <p>Zero npm audit vulnerabilities, working test suite, ESLint/Prettier configuration, production security headers, and documentation accuracy pass.</p>
        </div>
        <div class="cl-entry">
          <span class="cl-date"><span class="cl-icon" style="background:rgba(251,191,36,.15);color:#fbbf24;" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 21V3l14 9-14 9z"/></svg></span>2024</span>
          <h3>ByteLite LLC founded</h3>
          <p>Founded by Tash Broadwater in Helena, Montana.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.cl-hero { padding: 4.5rem 0 3.5rem; }
.cl-list { display: flex; flex-direction: column; gap: 2rem; }
.cl-entry { padding-bottom: 2rem; border-bottom: 1px solid #1a2235; }
.cl-entry:last-child { border-bottom: none; padding-bottom: 0; }
.cl-date { display: inline-flex; align-items: center; gap: .5rem; font-size: .75rem; font-weight: 700; color: #818cf8; font-family: monospace; background: rgba(99,102,241,.08); border: 1px solid rgba(99,102,241,.18); border-radius: .375rem; padding: .2rem .625rem .2rem .3rem; margin-bottom: .75rem; }
.cl-icon { display: flex; align-items: center; justify-content: center; width: 1.375rem; height: 1.375rem; border-radius: 50%; flex-shrink: 0; }
.cl-entry h3 { color: #e4e7f2; margin-bottom: .625rem; }
.cl-entry p { font-size: .9375rem; color: #7b829e; line-height: 1.7; margin: 0; }
</style>
