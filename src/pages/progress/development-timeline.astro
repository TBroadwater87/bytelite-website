---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';

const SUBNAV = [
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
  { label: 'Development Timeline', href: '/progress/development-timeline' },
  { label: 'Changelog', href: '/progress/changelog' },
];
---

<Layout
  title="Development Timeline | Progress | ByteLite LLC"
  description="ByteLite LLC's development timeline to date. No future release dates are promised."
  keywords="ByteLite LLC timeline, development progress"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Progress', href: '/progress' }, { label: 'Development Timeline' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="tl-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Development Timeline</p>
      <h1>Where things stand, in order.</h1>
      <p class="tl-p">This timeline covers what has already happened. It does not promise future release dates.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <div class="tl-list">
        <div class="tl-item"><span class="tl-date">2024</span><p>ByteLite LLC founded by Tash Broadwater in Helena, Montana.</p></div>
        <div class="tl-item"><span class="tl-date">2026-04</span><p>HeartStrings Play established as the first public-facing product direction; HeartStrings Connect development begins alongside it.</p></div>
        <div class="tl-item"><span class="tl-date">2026-05</span><p>Public site content audit: overclaiming language (patent-status framing, specific compression ratios, AGI-adjacent claims) removed in favor of proof-gated status reporting.</p></div>
        <div class="tl-item"><span class="tl-date">2026-07</span><p>HeartStrings Restaurant Partner Program pilot launched (self-serve signup, Stripe test-mode payment, manual review gate). "HeartStrings App" formally renamed to HeartStrings Connect.</p></div>
        <div class="tl-item"><span class="tl-date">2026-07</span><p>Site rearchitected around the ByteLite LLC technology portfolio (Technologies, Architecture, Products, Progress, Preorder, Company), with HeartStrings Play and HeartStrings Connect presented as flagship products within that portfolio.</p></div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.tl-hero { padding: 4.5rem 0 3.5rem; }
.tl-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.tl-list { display: flex; flex-direction: column; gap: 0; border-left: 2px solid #1a2235; padding-left: 1.75rem; }
.tl-item { position: relative; padding-bottom: 1.75rem; }
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before { content: ""; position: absolute; left: -2.15rem; top: .3rem; width: .625rem; height: .625rem; border-radius: 50%; background: #6366f1; }
.tl-date { display: block; font-size: .8125rem; font-weight: 700; color: #818cf8; font-family: monospace; margin-bottom: .375rem; }
.tl-item p { font-size: .9375rem; color: #a0a8c0; line-height: 1.7; margin: 0; }
</style>
