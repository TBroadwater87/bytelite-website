---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { ALL_PROJECTS, PUBLIC_PROJECT_COUNT_WORD } from '../../data/projects';
import {
  COMPANY_NAME,
  COMPANY_LOCATION,
  COMPANY_STRUCTURE,
  RESEARCH_BEGAN_YEAR,
  LEGAL_FORMATION_YEAR,
} from '../../data/company';

// Literal string constant, not derived from the system clock - a deliberate human
// project audit. Edit this one line when the canonical model is next reviewed.
const STATUS_LAST_REVIEWED = 'August 1, 2026';

const STATUS_LEGEND = [
  { status: 'Functional Prototype', text: 'The primary mechanism operates, but substantial refinement or integration remains.' },
  { status: 'Advanced Prototype', text: 'Most planned product structure exists and is being prepared for comprehensive validation.' },
  { status: 'Integrated Prototype', text: 'The system operates through another canonical platform or engine.' },
  { status: 'Internal Validation', text: 'Implementation exists and is undergoing repeatable internal correctness and integration testing.' },
  { status: 'Private Alpha', text: 'A restricted application build exists for controlled functionality and stability testing.' },
  { status: 'Pilot Preparation', text: 'The program is being prepared for participation but is not yet operating as a public beta.' },
];

const SUBNAV = [
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
  { label: 'Development Timeline', href: '/progress/development-timeline' },
  { label: 'Changelog', href: '/progress/changelog' },
];
---

<Layout
  title="Progress | Current Status | ByteLite LLC"
  description="Canonical, current status for every ByteLite LLC technology and product — rendered from one data source so it can't drift between pages."
  keywords="ByteLite LLC status, Cordel status, product status"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Progress' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="st-hero">
    <div class="container">
      <p class="eyebrow">ByteLite LLC</p>
      <p class="st-audit">Status last reviewed: {STATUS_LAST_REVIEWED}</p>
      <h1>Current Status</h1>
      <p class="st-sub">Canonical status for every ByteLite LLC technology and product. Status is separated from claims.</p>
      <p class="st-disclaimer">Research status does not equal production readiness.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:1100px;">
      <div class="pg-diagram">
        <img src="/architecture/bytelite-home-architecture-hierarchy.svg" alt="ByteLite LLC project-status hierarchy showing Cordel Play, Cordel Connect, the Restaurant Partner Program, ByteLite, Deep Kore, ByteSight, AIya, Genesis Goalkeeper, and Revelation Vanguard." width="1440" height="1620" loading="lazy" class="max-h-[85vh] w-auto mx-auto object-contain" />
      </div>
    </div>
  </section>
  <style>.pg-diagram { border-radius: 1rem; overflow: hidden; border: 1px solid #1a2235; background: #111318; } .pg-diagram img { display: block; width: 100%; height: auto; }</style>

  <section class="section section-alt">
    <div class="container">
      <div class="st-table">
        <div class="st-row st-header"><span>Project</span><span>Status</span><span>Availability</span></div>
        {ALL_PROJECTS.map((p) => (
          <div class="st-row">
            <span class="st-name"><a href={p.routes[0]}>{p.name}</a></span>
            <span><StatusBadge status={p.status} /></span>
            <span class="st-notes">{p.availability}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:760px;">
      <h2 style="margin-bottom:1.5rem;">Status Legend</h2>
      <p style="margin-bottom:1.75rem;font-size:1.0625rem;color:#a0a8c0;">Covers only the statuses currently in active use across the {PUBLIC_PROJECT_COUNT_WORD} canonical projects above.</p>
      <div class="st-legend">
        {STATUS_LEGEND.map((item) => (
          <div class="st-legend-item">
            <span class="st-legend-status">{item.status}</span>
            <span class="st-legend-text">{item.text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <h2 style="margin-bottom:1.5rem;">Not Yet Available</h2>
      <p style="margin-bottom:1.75rem;font-size:1.0625rem;color:#a0a8c0;">The following do not exist as public products or services. They are explicitly not claimed.</p>
      <div class="st-unavailable">
        <div class="st-un-item">&#10005; Public retail purchase of Cordel Play</div>
        <div class="st-un-item">&#10005; Cordel Connect on any public app store</div>
        <div class="st-un-item">&#10005; A public API of any kind</div>
        <div class="st-un-item">&#10005; Published independent verification of research results</div>
        <div class="st-un-item">&#10005; A public Deep Kore / AIya AI product</div>
        <div class="st-un-item">&#10005; A public ByteSight product</div>
        <div class="st-un-item">&#10005; Public mechanism disclosure for ByteLite</div>
        <div class="st-un-item">&#10005; A production compression product</div>
        <div class="st-un-item">&#10005; A finished AGI product</div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container" style="max-width:760px;">
      <h2 style="margin-bottom:1.5rem;">Company Information</h2>
      <div class="st-table">
        <div class="st-row"><span class="st-name">Company</span><span style="grid-column:span 2;color:#a0a8c0;">{COMPANY_NAME}</span></div>
        <div class="st-row"><span class="st-name">Location</span><span style="grid-column:span 2;color:#a0a8c0;">{COMPANY_LOCATION}</span></div>
        <div class="st-row"><span class="st-name">Research began</span><span style="grid-column:span 2;color:#a0a8c0;">{RESEARCH_BEGAN_YEAR}</span></div>
        <div class="st-row"><span class="st-name">LLC formed</span><span style="grid-column:span 2;color:#a0a8c0;">{LEGAL_FORMATION_YEAR}</span></div>
        <div class="st-row"><span class="st-name">Structure</span><span style="grid-column:span 2;color:#a0a8c0;">{COMPANY_STRUCTURE}</span></div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.st-hero { padding: 4.5rem 0 3.5rem; }
.st-hero h1 { max-width: 480px; }
.st-sub { max-width: 560px; margin-top: 1rem; font-size: 1.0625rem; color: #7b829e; line-height: 1.7; }
.st-audit { font-size: .8125rem; color: #555e7a; margin-bottom: .5rem; }
.st-disclaimer { max-width: 560px; margin-top: .75rem; font-size: .875rem; color: #7b829e; font-style: italic; }
.st-legend { display: flex; flex-direction: column; gap: 1rem; background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.75rem; }
.st-legend-item { display: flex; flex-direction: column; gap: .25rem; }
.st-legend-status { font-size: .8125rem; font-weight: 700; letter-spacing: .04em; color: #a78bfa; }
.st-legend-text { font-size: .9375rem; color: #a0a8c0; line-height: 1.6; }
.st-table { background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; overflow: hidden; }
.st-row { display: grid; grid-template-columns: 1.5fr 1fr 1.5fr; gap: 1.5rem; padding: 1.125rem 1.5rem; border-bottom: 1px solid #1a2235; align-items: center; }
.st-row:last-child { border-bottom: none; }
.st-header { background: #111828; font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #4a5068; }
.st-name { font-size: .9375rem; font-weight: 500; color: #e4e7f2; }
.st-name a { color: #818cf8; }
.st-name a:hover { color: #a5b4fc; }
.st-notes { font-size: .875rem; color: #7b829e; }
.st-unavailable { background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.75rem; display: flex; flex-direction: column; gap: .75rem; }
.st-un-item { font-size: .9375rem; color: #555e7a; }
@media (max-width: 700px) { .st-row { grid-template-columns: 1fr; gap: .625rem; } .st-header { display: none; } }
</style>
