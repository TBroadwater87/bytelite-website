---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { ALL_PROJECTS } from '../../data/projects';

const SUBNAV = [
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
  { label: 'Development Timeline', href: '/progress/development-timeline' },
  { label: 'Changelog', href: '/progress/changelog' },
];
---

<Layout
  title="Validation Evidence | Progress | ByteLite LLC"
  description="What has and has not been validated across every ByteLite LLC technology and product, aggregated from the canonical project records."
  keywords="ByteLite LLC validation, proof evidence"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Progress', href: '/progress' }, { label: 'Validation Evidence' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="ve-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Validation Evidence</p>
      <h1>What's actually been validated.</h1>
      <p class="ve-p">Pulled directly from each project's own record, so this page can't say something a technology page doesn't already say.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="ve-stats">
        <div class="ve-stat"><span class="ve-stat-num">{ALL_PROJECTS.length}</span><span class="ve-stat-label">Projects tracked</span></div>
        <div class="ve-stat"><span class="ve-stat-num">{ALL_PROJECTS.filter((p) => p.status === 'Internal Validation').length}</span><span class="ve-stat-label">Internal Validation</span></div>
        <div class="ve-stat"><span class="ve-stat-num">{ALL_PROJECTS.reduce((n, p) => n + p.currentCapabilities.length, 0)}</span><span class="ve-stat-label">Evidenced capabilities</span></div>
        <div class="ve-stat"><span class="ve-stat-num">{ALL_PROJECTS.reduce((n, p) => n + p.validation.length, 0)}</span><span class="ve-stat-label">Validation statements</span></div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="ve-list">
        {ALL_PROJECTS.map((p) => (
          <div class="ve-row" style={`--accent:${p.accentColor}`}>
            <h3>
              <span class="ve-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
              </span>
              <a href={p.routes[0]}>{p.name}</a>
            </h3>
            <ul>{p.validation.map((v) => <li>{v}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.ve-hero { padding: 4.5rem 0 3.5rem; }
.ve-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.ve-list { display: flex; flex-direction: column; gap: 1.5rem; }
.ve-row { background: #07090f; border: 1px solid #1a2235; border-left: 3px solid var(--accent); border-radius: .75rem; padding: 1.5rem 1.75rem; }
.ve-row h3 { margin-bottom: .875rem; display: flex; align-items: center; gap: .625rem; }
.ve-row h3 a { color: #e4e7f2; }
.ve-row h3 a:hover { color: #818cf8; }
.ve-icon { display: flex; align-items: center; justify-content: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: rgba(52,211,153,.12); color: #34d399; flex-shrink: 0; }
.ve-row ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
.ve-row li { font-size: .9375rem; color: #7b829e; line-height: 1.65; }
.ve-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.ve-stat { text-align: center; padding: 1.5rem 1rem; border: 1px solid #1a2235; border-radius: .75rem; }
.ve-stat-num { display: block; font-size: 2rem; font-weight: 700; color: #34d399; font-family: monospace; }
.ve-stat-label { display: block; font-size: .75rem; color: #7b829e; margin-top: .375rem; text-transform: uppercase; letter-spacing: .06em; }
@media (max-width: 700px) { .ve-stats { grid-template-columns: repeat(2, 1fr); } }
</style>
