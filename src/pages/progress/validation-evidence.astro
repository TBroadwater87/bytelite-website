---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import { ALL_PROJECTS } from '../../data/projects';

const SUBNAV = [
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
  { label: 'Development Timeline', href: '/progress/development-timeline' },
  { label: 'Changelog', href: '/progress/changelog' },
];
---

<Layout
  title="Validation Evidence | Progress | ByteLite LLC"
  description="What has and has not been validated across every ByteLite LLC technology and product, aggregated from the canonical project records."
  keywords="ByteLite LLC validation, proof evidence"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Progress', href: '/progress' }, { label: 'Validation Evidence' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <section class="ve-hero">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Validation Evidence</p>
      <h1>What's actually been validated.</h1>
      <p class="ve-p">Pulled directly from each project's own record, so this page can't say something a technology page doesn't already say.</p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="ve-list">
        {ALL_PROJECTS.map((p) => (
          <div class="ve-row" style={`--accent:${p.accentColor}`}>
            <h3><a href={p.routes[0]}>{p.name}</a></h3>
            <ul>{p.validation.map((v) => <li>{v}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.ve-hero { padding: 4.5rem 0 3.5rem; }
.ve-p { font-size: 1.0625rem; line-height: 1.8; color: #a0a8c0; }
.ve-list { display: flex; flex-direction: column; gap: 1.5rem; }
.ve-row { background: #07090f; border: 1px solid #1a2235; border-left: 3px solid var(--accent); border-radius: .75rem; padding: 1.5rem 1.75rem; }
.ve-row h3 { margin-bottom: .875rem; }
.ve-row h3 a { color: #e4e7f2; }
.ve-row h3 a:hover { color: #818cf8; }
.ve-row ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
.ve-row li { font-size: .9375rem; color: #7b829e; line-height: 1.65; }
</style>
