---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import MilestoneSummary from '../../components/site/MilestoneSummary.astro';
import ProofTile from '../../components/site/ProofTile.astro';
import ClaimBoundaries from '../../components/site/ClaimBoundaries.astro';
import ClassifiedFigure from '../../components/site/ClassifiedFigure.astro';
import ArtFigure from '../../components/site/ArtFigure.astro';
import { milestonesFor } from '../../data/milestones';
import { researchProgram } from '../../data/research-programs';
import { establishedCapabilitiesFor } from '../../data/established-capabilities';
import { COUNTING_LIMIT_STATEMENT, DETERMINISM_STATEMENT, CURRENT_REDUCTION_STATEMENT } from '../../data/bytelite';
import { COMPANY_NAME } from '../../data/company';

const program = researchProgram('data-representation');
const representationMilestones = milestonesFor('data-representation');
const provenCapabilities = establishedCapabilitiesFor('data-representation');

const ACCEPTANCE_STEPS = [
  { title: 'Declare', body: 'Record the input and its size before anything runs.' },
  { title: 'Represent', body: 'Count everything needed to rebuild it. Nothing held outside.' },
  { title: 'Rebuild', body: 'Decode and compare with the original, byte for byte.' },
  { title: 'Report', body: 'Publish a size only if the rebuild was exact.' },
];
---

<Layout
  title={`Data Representation Research | ${COMPANY_NAME}`}
  description="ByteLite LLC data representation research: deterministic, lossless representation with byte-exact reconstruction. Every one of 4,515 test encodings rebuilt exactly in internal tests. Net size reduction has not been demonstrated."
  path="/research/data-representation"
>
  <PageIntro eyebrow="Research program" heading="Exact, deterministic data representation." lede={program.pitch} art={{ classification: 'Conceptual illustration', src: '/art/data-flow.webp', alt: 'Streams of light passing through a tall lattice of glass panels.', width: 1672, height: 941, caption: 'An impression of structured data. It does not show compression or a real format.' }} />

  <section class="section" aria-labelledby="proven-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Tested in-house</p>
        <h2 id="proven-heading">Tested internally, and what is still design.</h2>
      </div>
      <ul class="proof-grid">
        {provenCapabilities.map((capability) => <ProofTile capability={capability} />)}
      </ul>
      <p class="status-strip"><strong>{CURRENT_REDUCTION_STATEMENT}</strong></p>
    </div>
  </section>

  <section class="section" aria-labelledby="boundaries-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Reading these results</p>
        <h2 id="boundaries-heading">Shown, possible, still to do.</h2>
      </div>
      <ClaimBoundaries program={program} />
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="acceptance-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">The rule every result must pass</p>
        <h2 id="acceptance-heading">Exact, or it does not count.</h2>
      </div>
      <ClassifiedFigure
        classification="Conceptual illustration"
        caption="How results are checked, not how a representation is produced. The methods are proprietary."
      >
        <ol class="acceptance">
          {ACCEPTANCE_STEPS.map((step, index) => (
            <li>
              <span class="acceptance-number" aria-hidden="true">{index + 1}</span>
              <span class="acceptance-title">{step.title}</span>
              <span class="acceptance-body">{step.body}</span>
            </li>
          ))}
        </ol>
      </ClassifiedFigure>
      <div class="art-pair">
        <ArtFigure image={{ classification: 'Conceptual illustration', src: '/art/data-exact-rebuild.webp', alt: 'Two identical glass cubes joined by a band of light, one on each side.', width: 1672, height: 941, caption: 'A round trip: what is rebuilt is identical to the original. It does not show any size reduction.' }} />
        <ArtFigure image={{ classification: 'Conceptual illustration', src: '/art/data-whole-artifact.webp', alt: 'A clear glass block holding stacked, glowing layers.', width: 1536, height: 1024, caption: 'The goal of counting the whole artifact. Complete accounting is not yet established for every output form.' }} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="limit-heading">
    <div class="wrap facts-pair">
      <div class="fact-block">
        <p class="eyebrow">Deterministic, not predictive</p>
        <p>{DETERMINISM_STATEMENT}</p>
      </div>
      <div class="fact-block">
        <p class="eyebrow" id="limit-heading">A mathematical limit we respect</p>
        <p>{COUNTING_LIMIT_STATEMENT}</p>
        <p>Earlier versions of this website described universal reduction as the goal. That was wrong and has been withdrawn.</p>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="milestones-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Milestones</p>
        <h2 id="milestones-heading">Every gate, and where it stands.</h2>
      </div>
      <ul class="summary-grid milestone-list">
        {representationMilestones.map((milestone) => <MilestoneSummary milestone={milestone} />)}
      </ul>
    </div>
  </section>

  <section class="section band-dark" aria-labelledby="next-heading">
    <div class="wrap cta-inner">
      <h2 id="next-heading">Check a result yourself.</h2>
      <p>Nothing is available to license yet. Proposals to evaluate a specific result are welcome.</p>
      <div class="button-row">
        <a class="button button-primary" href="/contact?type=validation-partnership">Propose an evaluation</a>
        <a class="button button-secondary" href="/licensing">Licensing models</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .status-strip { margin-top: var(--space-5); padding: var(--space-4) var(--space-5); border-left: 4px solid var(--tone-progress-ink); background: var(--tone-progress-bg); border-radius: var(--radius-md); font-size: var(--text-sm); }
  .status-strip strong { color: var(--tone-progress-ink); }
  .acceptance { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); }
  .acceptance li { display: grid; gap: var(--space-2); padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-canvas); }
  .acceptance-number { display: grid; place-items: center; width: 2rem; height: 2rem; border-radius: 50%; background: var(--color-ink); color: var(--color-canvas); font-family: var(--font-mono); font-weight: 700; font-size: var(--text-sm); }
  .acceptance-title { font-weight: 700; font-size: var(--text-lg); color: var(--color-ink); }
  .acceptance-body { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .art-pair { display: grid; gap: var(--space-5); margin-top: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); align-items: start; }
  .facts-pair { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); }
  .fact-block { display: grid; gap: var(--space-3); align-content: start; }
  .milestone-list { list-style: none; }
  .cta-inner { display: grid; gap: var(--space-4); justify-items: start; }
</style>
