---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import MilestoneCard from '../../components/site/MilestoneCard.astro';
import ClassifiedFigure from '../../components/site/ClassifiedFigure.astro';
import { milestonesFor } from '../../data/milestones';
import {
  DATA_REPRESENTATION_OBJECTIVE,
  COUNTING_LIMIT_STATEMENT,
  DETERMINISM_STATEMENT,
  CURRENT_REDUCTION_STATUS,
  REPRESENTATION_PRINCIPLES,
  WHAT_IT_IS_NOT,
  PROPRIETARY_METHODS_STATEMENT,
} from '../../data/bytelite';
import { COMPANY_NAME } from '../../data/company';

const representationMilestones = milestonesFor('data-representation');

const ACCEPTANCE_STEPS = [
  { title: 'Declared input', body: 'The input and its size are recorded before anything runs.' },
  { title: 'Complete representation', body: 'Everything needed to rebuild the input is counted, with nothing held outside.' },
  { title: 'Exact rebuild', body: 'The rebuilt data is compared with the original byte for byte.' },
  { title: 'Reported result', body: 'Size is reported only when the rebuild is exact, and only for that input.' },
];
---

<Layout
  title={`Data Representation Research | ${COMPANY_NAME}`}
  description="ByteLite LLC data representation research: deterministic, lossless representation aiming at exact reconstruction and complete accounting. Net size reduction has not been demonstrated."
  path="/research/data-representation"
>
  <PageIntro
    eyebrow="Research program"
    heading="Deterministic, lossless data representation."
    lede="The original ByteLite research program. It asks whether data can be represented deterministically, rebuilt exactly, accounted for completely, and made smaller where the data allows it."
  />

  <section class="section" aria-labelledby="objective-heading">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">The objective</p>
        <h2 id="objective-heading">What the research is trying to achieve.</h2>
        <p>{DATA_REPRESENTATION_OBJECTIVE}</p>
        <p>{DETERMINISM_STATEMENT}</p>
      </div>
      <div class="notice">
        <p class="eyebrow">Current status</p>
        <p><strong>{CURRENT_REDUCTION_STATUS}</strong></p>
        <p>
          Exact reconstruction and deterministic operation pass internal tests. Complete accounting is
          measured for the current single-round format only. None of it has been independently verified.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="limit-heading">
    <div class="wrap prose">
      <p class="eyebrow">A mathematical limit</p>
      <h2 id="limit-heading">Why no universal reduction is claimed.</h2>
      <p>{COUNTING_LIMIT_STATEMENT}</p>
      <p>
        Earlier versions of this website described universal reduction as the research target. That
        description was wrong and has been withdrawn. The research looks for representations that
        are exact, deterministic and fully accounted for, and that are smaller where the data and
        the complete representation make that possible.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Principles</p>
        <h2 id="principles-heading">How every result is judged.</h2>
      </div>
      <ul class="principles">
        {REPRESENTATION_PRINCIPLES.map((principle) => (
          <li>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="acceptance-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Acceptance</p>
        <h2 id="acceptance-heading">When a result counts.</h2>
        <p class="lede">{PROPRIETARY_METHODS_STATEMENT}</p>
      </div>
      <ClassifiedFigure
        classification="Conceptual illustration"
        caption="The acceptance rule every reported result must pass. It describes how results are checked, not how a representation is produced."
      >
        <ol class="acceptance">
          {ACCEPTANCE_STEPS.map((step, index) => (
            <li>
              <span class="acceptance-number" aria-hidden="true">{index + 1}</span>
              <span class="acceptance-title">{step.title}</span>
              <span class="acceptance-body">{step.body}</span>
            </li>
          ))}
        </ol>
      </ClassifiedFigure>
    </div>
  </section>

  <section class="section" aria-labelledby="boundaries-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Boundaries</p>
        <h2 id="boundaries-heading">What this research is not.</h2>
      </div>
      <ul class="boundaries">
        {WHAT_IT_IS_NOT.map((boundary) => (
          <li>
            <h3>{boundary.headline}</h3>
            <p>{boundary.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="milestones-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Milestones</p>
        <h2 id="milestones-heading">Where each gate stands.</h2>
        <p class="lede"><a href="/research/milestones">See all research milestones</a>.</p>
      </div>
      <div class="milestone-stack">
        {representationMilestones.map((milestone) => <MilestoneCard milestone={milestone} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="next-heading">
    <div class="wrap prose">
      <h2 id="next-heading">Licensing and evaluation.</h2>
      <p>
        Nothing is available to license today. The proposed commercial models are described on the
        <a href="/licensing">licensing and partnerships page</a>. Proposals to evaluate a specific
        result independently are welcome.
      </p>
      <div class="button-row">
        <a class="button button-primary" href="/contact?type=validation-partnership">Propose an evaluation</a>
        <a class="button button-secondary" href="/validation">How evidence is classified</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .principles, .boundaries { list-style: none; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .principles li, .boundaries li { display: grid; gap: var(--space-2); align-content: start; padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .principles h3, .boundaries h3 { font-size: var(--text-base); }
  .acceptance { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr)); }
  .acceptance li { display: grid; gap: var(--space-1); padding: var(--space-4); border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-canvas); }
  .acceptance-number { font-family: var(--font-mono); font-weight: 700; color: var(--color-ink-subtle); }
  .acceptance-title { font-weight: 600; color: var(--color-ink); }
  .acceptance-body { font-size: var(--text-sm); color: var(--color-ink-muted); }
  .milestone-stack { display: grid; gap: var(--space-4); }
</style>
