---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductSubNav from '../../components/ProductSubNav.astro';
import StructuralProgression from '../../components/research/StructuralProgression.astro';
import DisclosureBoundary from '../../components/research/DisclosureBoundary.astro';
import { RESEARCH_ROUTES, PROGRAM_QUALIFIER, RESEARCH_PUBLICATION } from '../../data/research';
import { TECHNOLOGY_COUNT_WORD } from '../../data/projects';

const SUBNAV = [
  { label: 'Research Overview', href: RESEARCH_ROUTES.landing },
  { label: 'Research Thesis', href: RESEARCH_ROUTES.thesis },
  { label: 'Plain English', href: RESEARCH_ROUTES.plainEnglish },
  { label: 'Architecture', href: '/architecture' },
  { label: 'Current Status', href: '/progress' },
  { label: 'Validation Evidence', href: '/progress/validation-evidence' },
];

const ENTRY_POINTS = [
  {
    title: 'Research Thesis',
    href: RESEARCH_ROUTES.thesis,
    summary: 'The formal conceptual architecture: reversible structure, verified invariant learning, and computational world models.',
    meta: `${RESEARCH_PUBLICATION.publicationType} · Version ${RESEARCH_PUBLICATION.version}`,
  },
  {
    title: 'Plain-English Explanation',
    href: RESEARCH_ROUTES.plainEnglish,
    summary: 'The same program described without requiring any background in AI, compression, or computer science.',
    meta: 'Nontechnical',
  },
  {
    title: 'Architecture & Governance',
    href: '/architecture',
    summary: 'How reasoning, permission, preservation, uncertainty, and action are kept separate, and why no layer gets unlimited authority.',
    meta: `${TECHNOLOGY_COUNT_WORD} technologies, one governance rail`,
  },
  {
    title: 'Current Status',
    href: '/progress',
    summary: 'What actually exists today, per project, rendered from one canonical status record.',
    meta: 'Canonical status',
  },
  {
    title: 'Validation Evidence',
    href: '/progress/validation-evidence',
    summary: 'What has and has not been validated, including known failures and the absence of independent verification.',
    meta: 'Evidence ledger',
  },
];
---

<Layout
  noindex={true}
  title="Research | ByteLite LLC"
  description="ByteLite LLC's public research program: deterministic structure from information to reasoning, including the Deterministic Structural Cognition thesis and a plain-English explanation."
  keywords="ByteLite LLC research, deterministic structural cognition, reversible structure, verified invariant learning, computational world models"
  canonical="https://www.thebytelite.com/research"
>
  <Header slot="header" />
  <section class="section-sm"><div class="container"><Breadcrumbs items={[{ label: 'Research' }]} /></div></section>
  <ProductSubNav items={SUBNAV} />

  <!-- Hero -->
  <section class="rh-hero">
    <div class="container" style="max-width:860px;">
      <p class="eyebrow">ByteLite LLC Research</p>
      <h1>Deterministic structure, from information to reasoning.</h1>
      <p class="rh-lede">
        ByteLite LLC is investigating whether complex information and computation can be
        represented through progressively smaller deterministic structures while preserving the
        information, behavior, provenance, and uncertainty the task actually requires.
      </p>
      <p class="rh-lede">
        The research spans reversible digital structure, visual structure, deterministic
        reasoning, governance, and human interaction. Its central public thesis asks whether
        observation can be turned into explicit relationships, relationships into reusable
        invariants, and verified invariants into increasingly economical models for reasoning,
        prediction, and simulation.
      </p>
      <p class="rh-qualifier">{PROGRAM_QUALIFIER}</p>
      <div class="rh-cta-row">
        <a href={RESEARCH_ROUTES.thesis} class="btn btn-primary">Read the Research Thesis</a>
        <a href={RESEARCH_ROUTES.plainEnglish} class="btn btn-outline">Plain-English Explanation</a>
      </div>
    </div>
  </section>

  <!-- The research question, stated affirmatively -->
  <section class="section">
    <div class="container" style="max-width:860px;">
      <p class="eyebrow">The Research Question</p>
      <h2 style="margin-bottom:1.25rem;">Can better structural understanding require less computation?</h2>
      <div class="rh-question-grid">
        <div class="rh-question-card">
          <h3>What is being asked</h3>
          <p>
            Whether exact relationships, once made explicit, can be reduced into smaller verified
            structures, and whether those structures remain sufficient for the task that needed
            them.
          </p>
        </div>
        <div class="rh-question-card">
          <h3>Why it might matter</h3>
          <p>
            A smaller sufficient description is cheaper to carry, cheaper to reason over, and
            easier to audit. If reduction composes across representation, vision, reasoning, and
            time, the same budget reaches further.
          </p>
        </div>
        <div class="rh-question-card">
          <h3>How it could fail</h3>
          <p>
            If exact reconstruction breaks, if complete representations do not improve under their
            own criterion, or if omitted state turns out to be necessary for the prediction, the
            thesis weakens exactly where it was tested.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Canonical progression figure -->
  <section class="section section-alt">
    <div class="container" style="max-width:960px;">
      <p class="eyebrow">The Progression</p>
      <h2 style="margin-bottom:1.5rem;">One path, nine stages.</h2>
      <StructuralProgression variant="chain" />
      <p class="rh-figure-note">
        Each stage is a separate question with its own evidence standard. Nothing is promoted to
        the next stage because the previous one looked promising.
        <a href={RESEARCH_ROUTES.thesis}>The thesis walks each stage in turn &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Entry points -->
  <section class="section">
    <div class="container" style="max-width:960px;">
      <p class="eyebrow">Where to Read Next</p>
      <h2 style="margin-bottom:2rem;">Five entry points.</h2>
      <div class="rh-entry-grid">
        {ENTRY_POINTS.map((entry) => (
          <a href={entry.href} class="rh-entry">
            <span class="rh-entry-meta">{entry.meta}</span>
            <h3>{entry.title}</h3>
            <p>{entry.summary}</p>
            <span class="rh-entry-arrow">Read &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Disclosure boundary -->
  <section class="section section-alt">
    <div class="container" style="max-width:860px;">
      <DisclosureBoundary variant="short" />
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.rh-hero { padding: 4rem 0 3.5rem; }
.rh-lede { font-size: 1.0625rem; line-height: 1.85; color: #a0a8c0; margin-top: 1.25rem; }
.rh-qualifier {
  margin-top: 1.75rem;
  padding: .875rem 1.125rem;
  background: rgba(251,146,60,.06);
  border: 1px solid rgba(251,146,60,.22);
  border-radius: .5rem;
  font-size: .9375rem;
  color: #c4c8f0;
  line-height: 1.6;
}
.rh-cta-row { display: flex; gap: .875rem; flex-wrap: wrap; margin-top: 2rem; }

.rh-question-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
@media (max-width: 860px) { .rh-question-grid { grid-template-columns: 1fr; } }
.rh-question-card {
  background: #0d1120; border: 1px solid #1a2235; border-radius: .75rem; padding: 1.5rem;
}
.rh-question-card h3 { font-size: .9375rem; color: #e4e7f2; margin-bottom: .625rem; }
.rh-question-card p { font-size: .875rem; color: #7b829e; line-height: 1.7; margin: 0; }

.rh-figure-note { margin-top: 1.25rem; font-size: .9375rem; color: #7b829e; line-height: 1.7; }
.rh-figure-note a { color: #818cf8; margin-left: .375rem; }
.rh-figure-note a:hover, .rh-figure-note a:focus-visible { color: #a5b4fc; }

.rh-entry-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }
.rh-entry {
  display: flex; flex-direction: column; gap: .5rem;
  background: #0d1120; border: 1px solid #1a2235; border-left: 3px solid #6366f1;
  border-radius: .75rem; padding: 1.5rem;
  transition: border-color .2s, transform .2s;
}
.rh-entry:hover, .rh-entry:focus-visible { transform: translateY(-2px); border-color: #2a3350; border-left-color: #818cf8; }
.rh-entry:focus-visible { outline: 2px solid #6366f1; outline-offset: 2px; }
.rh-entry-meta {
  font-size: .6875rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #555e7a;
}
.rh-entry h3 { font-size: 1.0625rem; color: #e4e7f2; margin: 0; }
.rh-entry p { font-size: .875rem; color: #7b829e; line-height: 1.7; margin: 0; flex: 1; }
.rh-entry-arrow { font-size: .8125rem; font-weight: 500; color: #818cf8; margin-top: .25rem; }
</style>
