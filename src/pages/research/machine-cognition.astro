---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import CognitionProcessDiagram from '../../components/site/CognitionProcessDiagram.astro';
import MilestoneSummary from '../../components/site/MilestoneSummary.astro';
import ProofTile from '../../components/site/ProofTile.astro';
import ClaimBoundaries from '../../components/site/ClaimBoundaries.astro';
import ArtFigure from '../../components/site/ArtFigure.astro';
import { milestonesFor } from '../../data/milestones';
import { researchProgram } from '../../data/research-programs';
import { establishedCapabilitiesFor } from '../../data/established-capabilities';
import { COMPANY_NAME } from '../../data/company';

const program = researchProgram('machine-cognition');
const cognitionMilestones = milestonesFor('machine-cognition');
const provenCapabilities = establishedCapabilitiesFor('machine-cognition');

const DESIGN_DIFFERENCES = [
  { title: 'Answers from records', body: 'Designed to hold knowledge as explicit records with their source, not as patterns inside a trained model.' },
  { title: 'Fixed knowledge versions', body: 'Designed so each request runs against one fixed, versioned body of knowledge, so results can be repeated.' },
  { title: 'Taught deliberately', body: 'Designed so new knowledge enters only through explicit operator steps, never from chat.' },
  { title: 'Governed by design', body: 'Designed so requests pass checks at defined points instead of relying on after-the-fact filters.' },
];
---

<Layout
  title={`Machine Cognition Research | ${COMPANY_NAME}`}
  description="ByteLite LLC machine cognition research: AI designed to answer only from traceable knowledge and say when it does not know. What is tested internally, what is only designed, and what comes next."
  path="/research/machine-cognition"
>
  <PageIntro eyebrow="Research program" heading="Governed machine cognition." lede={program.pitch} art={{ classification: 'Conceptual illustration', src: '/art/cognition-structure.webp', alt: 'A symmetrical violet crystalline lattice of connected nodes.', width: 1672, height: 941, caption: 'An abstract impression of connected knowledge. It is not an algorithm or a working system.' }} />

  <section class="section" aria-labelledby="proven-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Tested in-house</p>
        <h2 id="proven-heading">Tested internally, and what is still design.</h2>
      </div>
      <ul class="proof-grid">
        {provenCapabilities.map((capability) => <ProofTile capability={capability} />)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="boundaries-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Reading these results</p>
        <h2 id="boundaries-heading">Shown, possible, still to do.</h2>
      </div>
      <ClaimBoundaries program={program} />
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="process-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">The path of a request</p>
        <h2 id="process-heading">Five stages. One is tested in-house.</h2>
      </div>
      <CognitionProcessDiagram />
    </div>
  </section>

  <section class="section" aria-labelledby="difference-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">A different design</p>
        <h2 id="difference-heading">Not a chatbot built on a trained model.</h2>
        <p class="lede">
          A different set of priorities from mainstream generative AI, traded for much narrower coverage.
          These are design choices. The milestones below show how far each has been tested.
          <a href="/research/approaches-to-ai">Compare the approaches, with sources</a>.
        </p>
      </div>
      <div class="art-lead"><ArtFigure image={{ classification: 'Conceptual illustration', src: '/art/cognition-sources.webp', alt: 'Glass panels linked by thin lines around a central stack of layered records.', width: 1672, height: 941, caption: 'Records, their sources and open questions as an idea. It is not a real trace.' }} /></div>
      <ul class="difference-grid">
        {DESIGN_DIFFERENCES.map((difference) => (
          <li><h3>{difference.title}</h3><p>{difference.body}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="milestones-heading" id="governance">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Milestones</p>
        <h2 id="milestones-heading">Every gate, and where it stands.</h2>
      </div>
      <ul class="summary-grid milestone-list">
        {cognitionMilestones.map((milestone) => <MilestoneSummary milestone={milestone} />)}
      </ul>
      <ul class="limits">
        <li><strong>Not demonstrated end to end.</strong> The full path from a request to a supported answer is still being built.</li>
        <li>Complete governance has not been demonstrated. Public use stays off until it is independently verified.</li>
        <li>There is no public demonstration on this site, and none is simulated.</li>
      </ul>
    </div>
  </section>

  <section class="section band-dark" aria-labelledby="contact-heading">
    <div class="wrap cta-inner">
      <h2 id="contact-heading">Evaluate this work.</h2>
      <div class="button-row">
        <a class="button button-primary" href="/contact?type=validation-partnership">Propose an evaluation</a>
        <a class="button button-secondary" href="/contact?type=technology-partnership">Discuss a collaboration</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .art-lead { max-width: 52rem; margin-bottom: var(--space-6); }
  .difference-grid { list-style: none; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); }
  .difference-grid li { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-4); border-top: 3px solid var(--color-ink); }
  .difference-grid h3 { font-size: var(--text-base); }
  .difference-grid p { font-size: var(--text-sm); }
  .milestone-list { list-style: none; }
  .limits { list-style: none; display: grid; gap: var(--space-2); margin-top: var(--space-6); padding: var(--space-4) var(--space-5); border-left: 4px solid var(--color-ink); background: var(--color-surface); border-radius: var(--radius-md); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .cta-inner { display: grid; gap: var(--space-4); justify-items: start; }
</style>
