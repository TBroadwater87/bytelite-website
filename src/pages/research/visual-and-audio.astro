---
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/site/PageIntro.astro';
import MilestoneSummary from '../../components/site/MilestoneSummary.astro';
import ProofTile from '../../components/site/ProofTile.astro';
import { milestonesFor } from '../../data/milestones';
import { researchProgram } from '../../data/research-programs';
import { establishedCapabilitiesFor } from '../../data/established-capabilities';
import { COMPANY_NAME } from '../../data/company';

const program = researchProgram('visual-and-audio');
const sensoryMilestones = milestonesFor('visual-and-audio');
const provenCapabilities = establishedCapabilitiesFor('visual-and-audio');
---

<Layout
  title={`Visual and Audio Research | ${COMPANY_NAME}`}
  description="ByteLite LLC research into deterministic, structured representations of images and sound: 573 of 573 image checks and 213 of 213 audio architecture tests pass. No visual understanding or speech comprehension is claimed."
  path="/research/visual-and-audio"
>
  <PageIntro eyebrow="Research program" heading="Visual and audio information." lede={program.pitch} />

  <section class="section" aria-labelledby="proven-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Proven in internal tests</p>
        <h2 id="proven-heading">What works today.</h2>
      </div>
      <ul class="proof-grid">
        {provenCapabilities.map((capability) => <ProofTile capability={capability} />)}
      </ul>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="direction-heading">
    <div class="wrap split">
      <div class="direction">
        <p class="eyebrow">Images</p>
        <h2 id="direction-heading">Exact, repeatable image structure.</h2>
        <p>Describe the structure of an image the same way every time, so later systems can rely on it.</p>
        <p class="direction-next"><strong>Next:</strong> results on real-world photographs.</p>
      </div>
      <div class="direction">
        <p class="eyebrow">Sound</p>
        <h2>An audio foundation, ready to build on.</h2>
        <p>The architecture for representing sound and speech is in place and fully tested.</p>
        <p class="direction-next"><strong>Next:</strong> the first audio measurements. No speech recognition, speech comprehension or audio analysis capability is claimed.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="milestones-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Milestones</p>
        <h2 id="milestones-heading">Every gate, and where it stands.</h2>
      </div>
      <ul class="summary-grid milestone-list">
        {sensoryMilestones.map((milestone) => <MilestoneSummary milestone={milestone} />)}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .direction { display: grid; gap: var(--space-3); align-content: start; }
  .direction-next { font-size: var(--text-sm); }
  .milestone-list { list-style: none; }
</style>
