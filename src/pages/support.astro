---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import { SUPPORTER_PACK_ACTIONABLE, SUPPORTER_DISCLOSURE, SUPPORTER_REWARD } from '../data/commerce';
import { COMPANY_NAME } from '../data/company';

const NOT_INCLUDED = [
  'Access to any product, now or later.',
  'Early or beta software access.',
  'Equity, shares, voting rights, revenue share, repayment, interest or profit participation.',
  `Ownership of, or a license to, any ${COMPANY_NAME} intellectual property.`,
  'Any say in what is built or when.',
  'A tax deduction.',
  'A promise that any particular work is finished, or finished by a date.',
];
---

<Layout
  title={`Founder Supporter Pack | ${COMPANY_NAME}`}
  description="A planned one-time purchase of digital items from ByteLite LLC. Not on sale. Not a donation, not tax deductible, and it grants no equity, product access or control over development."
  path="/support"
>
  <PageIntro
    eyebrow="Founder Supporter Pack"
    heading="Supporter Pack: in preparation, not on sale."
    lede="A planned one-time purchase of a specific set of digital items, for people who want to support the company before there is a product to buy. The items do not exist in final form yet, so nothing can be bought."
  />

  <section class="section">
    <div class="wrap wrap-narrow prose">
      <h2>What a supporter would receive.</h2>
      <ul class="fact-list fact-list-yes">{SUPPORTER_REWARD.map((item) => <li>{item}</li>)}</ul>
      <p>That list is complete. Anything not on it is not part of the purchase.</p>

      <h2>What a supporter would not receive.</h2>
      <ul class="fact-list fact-list-no">{NOT_INCLUDED.map((item) => <li>{item}</li>)}</ul>

      <div class="notice notice-caution">
        <h3>Read this before any purchase.</h3>
        <p>{SUPPORTER_DISCLOSURE}</p>
      </div>

      <div class="purchase">
        {SUPPORTER_PACK_ACTIONABLE ? (
          <button type="button" class="button button-primary purchase-button" id="buy-supporter">Buy the Founder Supporter Pack</button>
        ) : (
          <button type="button" class="button purchase-button" disabled aria-describedby="purchase-reason">Not on sale</button>
        )}
        <p class="small-print" id="purchase-reason">
          {SUPPORTER_PACK_ACTIONABLE
            ? 'Payment is handled by Stripe on its own hosted page.'
            : 'The reward files and minimum amount are not final, and the purchase terms are not published. The server refuses this purchase until they are.'}
        </p>
        <p class="form-status" role="status" id="purchase-status"></p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const purchaseButton = document.getElementById('buy-supporter') as HTMLButtonElement | null;
  const purchaseStatus = document.getElementById('purchase-status');
  purchaseButton?.addEventListener('click', async () => {
    purchaseButton.disabled = true;
    if (purchaseStatus) purchaseStatus.textContent = 'Opening secure checkout...';
    try {
      const response = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ planKey: 'founder-supporter-pack' }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.url) throw new Error(result.error || 'Checkout could not be started.');
      window.location.assign(result.url);
    } catch (error) {
      if (purchaseStatus) purchaseStatus.textContent = error instanceof Error ? error.message : 'Checkout could not be started.';
      purchaseButton.disabled = false;
    }
  });
</script>

<style>
  .purchase { display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  .purchase-button { width: 100%; }
</style>
