---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectPageHero from '../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../components/ProjectDetailSections.astro';
import { BYTECOST } from '../../data/projects';
---

<Layout
  title="ByteCost | Burden and Value Layer | ByteLite LLC"
  description="ByteCost is ByteLite LLC's planned cost, value, and burden-accounting layer for verified savings claims. Planned, not implemented."
  keywords="ByteCost, ByteLite LLC architecture, planned layer"
  ogImage="/bytelite-logo.png"
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Technologies', href: '/technologies' }, { label: 'ByteCost' }]} /></div>
  </section>

  <ProjectPageHero project={BYTECOST} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <img src="/technologies/bytecost-technology-mark.webp" alt="ByteCost technology mark" width="200" height="200" style="width:160px;height:auto;margin-bottom:1.75rem;border-radius:1rem;" loading="lazy" />
      <p class="eyebrow">Mission</p>
      <h2 style="margin-bottom:1.25rem;">A savings claim is only real if it is accounted for.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;">{BYTECOST.mission}</p>
    </div>
  </section>

  <ProjectDetailSections project={BYTECOST} />

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Related</p>
      <div class="pd-related-row">
        <a href="/architecture" class="btn btn-outline btn-sm">The Complete Architecture</a>
        <a href="/technologies/byteflow" class="btn btn-outline btn-sm">ByteFlow &rarr;</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.pd-related-row { display: flex; gap: .75rem; flex-wrap: wrap; }
.pd-related-row .btn { white-space: normal; text-align: center; }
</style>
