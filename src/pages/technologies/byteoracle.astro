---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectPageHero from '../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../components/ProjectDetailSections.astro';
import { BYTEORACLE } from '../../data/projects';
---

<Layout
  title="ByteOracle | Deterministic Astronomical Interpretation | ByteLite LLC"
  description="ByteOracle is ByteLite LLC's deterministic astronomical-calculation engine — internally validated, locally calculated, reproducible readings feeding Cordel Connect's horoscope features."
  keywords="ByteOracle, deterministic astronomy, horoscope engine, Cordel Connect, ByteLite LLC"
  noindex={true}
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Technologies', href: '/technologies' }, { label: 'ByteOracle' }]} /></div>
  </section>

  <!-- Retired-listing notice. This route is kept only so existing links resolve; it is not in
       the navigation, the technology portfolio, or the sitemap, and it is served noindex. The
       name below is retained here as historical terminology, not as a current public name. -->
  <section class="section-sm">
    <div class="container" style="max-width:820px;">
      <aside class="retired-notice" aria-labelledby="retired-notice-heading">
        <h2 id="retired-notice-heading">Historical listing</h2>
        <p>
          &ldquo;ByteOracle&rdquo; is retired terminology. This engine is no longer part of the
          public ByteLite LLC technology portfolio, and an internal rename is pending, so no
          replacement name is published yet. This page is kept only so existing links resolve.
        </p>
        <p>
          For the current public technology portfolio see
          <a href="/technologies">Technologies</a>, and for the user-facing capability this engine
          supports see <a href="/products/cordel-connect/horoscopes">Horoscopes in Cordel Connect</a>.
        </p>
      </aside>
    </div>
  </section>

  <ProjectPageHero project={BYTEORACLE} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Mission</p>
      <h2 style="margin-bottom:1.25rem;">Deterministic astronomy, not generic fortune-telling.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;">{BYTEORACLE.mission}</p>
      <p style="font-size:1.0625rem;line-height:1.8;margin-top:1rem;">
        The underlying astronomical calculation is a 9-stage deterministic pipeline, internally
        cross-checked against independent reference libraries across a 200-year date range, and it
        generates 156 records per calendar date — 12 individual sign readings plus 144 ordered
        compatibility pairs. That engine and its Cordel Connect integration exist as tested code
        today. The engine does not yet have its own dedicated repository, and integration parity
        with the configuration the app currently deploys has not yet been qualified — see Current
        Capabilities and Validation and Evidence below for the exact, current picture.
      </p>
    </div>
  </section>

  <ProjectDetailSections project={BYTEORACLE} />

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Related</p>
      <div class="pd-related-row">
        <a href="/products/cordel-connect/horoscopes" class="btn btn-outline btn-sm">Horoscopes in Cordel Connect &rarr;</a>
        <a href="/technologies/deep-kore" class="btn btn-outline btn-sm">Deep Kore &rarr;</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.pd-related-row { display: flex; gap: .75rem; flex-wrap: wrap; }
.pd-related-row .btn { white-space: normal; text-align: center; }
.retired-notice {
  background: rgba(251,146,60,.06);
  border: 1px solid rgba(251,146,60,.25);
  border-radius: .75rem;
  padding: 1.5rem 1.75rem;
}
.retired-notice h2 {
  font-size: .6875rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
  color: #fbbf24; margin-bottom: .875rem;
}
.retired-notice p { font-size: .9375rem; color: #a0a8c0; line-height: 1.75; }
.retired-notice p + p { margin-top: .75rem; }
.retired-notice a { color: #818cf8; }
.retired-notice a:hover, .retired-notice a:focus-visible { color: #a5b4fc; }
</style>
