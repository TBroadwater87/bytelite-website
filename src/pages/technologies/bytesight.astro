---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectPageHero from '../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../components/ProjectDetailSections.astro';
import { BYTESIGHT } from '../../data/projects';
import { RESEARCH_ROUTES } from '../../data/research';
---

<Layout
  noindex={true}
  title="ByteSight | Deterministic Visual Evidence | ByteLite LLC"
  description="ByteSight is ByteLite LLC's deterministic visual-structure and inspection engine for images, regions, boundaries, and provenance — internally validated, with an active desktop workbench."
  keywords="ByteSight, deterministic vision, visual structure, provenance, ByteLite LLC"
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Technologies', href: '/technologies' }, { label: 'ByteSight' }]} /></div>
  </section>

  <ProjectPageHero project={BYTESIGHT} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <img src="/technologies/bytesight-technology-mark.webp" alt="ByteSight technology mark" width="200" height="200" style="width:160px;height:auto;margin-bottom:1.75rem;border-radius:1rem;" loading="lazy" />
      <p class="eyebrow">Mission</p>
      <h2 style="margin-bottom:1.25rem;">Vision that can show its work.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;">{BYTESIGHT.mission}</p>
      <p style="font-size:1.0625rem;line-height:1.8;margin-top:1rem;">
        Where a typical classifier returns a confidence score with no explanation, ByteSight
        represents canonical regions, boundaries, and closure state explicitly, with a desktop
        workbench that lets a person inspect and correct why a region was identified the way it
        was. This is implemented and internally tested today — see Current Capabilities below for
        what's proven and Validation and Evidence for exact scope and known limitations, including
        a documented gap on close-up portrait photos.
      </p>
    </div>
  </section>

  <ProjectDetailSections project={BYTESIGHT} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Research Direction</p>
      <h2 style="margin-bottom:.75rem;">Visual Structure as a Shared Relational Substrate</h2>
      <p class="bs-flag"><span class="badge badge-research">Research hypothesis &mdash; not current capability</span></p>
      <p class="bs-research">
        Everything above this section is what exists and what has been tested, including the
        limitations. This section is not. It describes a question the research is asking.
      </p>
      <p class="bs-research">
        The longer-term question is whether visual relationships derived independently of any
        answer key can be expressed in a structural form that can then be compared against governed
        masks, and later consumed by deterministic cognition alongside structure derived from other
        kinds of input.
      </p>
      <p class="bs-research">
        The order matters more than the result. A representation that is built with knowledge of
        the mask it will be scored against proves nothing about the representation.
        <strong>Observation first. Ground-truth comparison second.</strong>
      </p>
      <p class="bs-research">
        This is not a claim of solved object detection, and it is not a claim that end-to-end
        visual encoding into canonical structural artifacts exists. Neither does.
      </p>
      <div class="pd-related-row" style="margin-top:1.75rem;">
        <a href={RESEARCH_ROUTES.thesis} class="btn btn-outline btn-sm">Read the Research Thesis &rarr;</a>
        <a href="/progress/validation-evidence" class="btn btn-ghost btn-sm">What has actually been validated</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Related</p>
      <div class="pd-related-row">
        <a href="/architecture" class="btn btn-outline btn-sm">The Complete Architecture</a>
        <a href="/technologies/bytelite" class="btn btn-outline btn-sm">ByteLite &rarr;</a>
        <a href="/products/cordel-connect/cartoonized-profiles" class="btn btn-outline btn-sm">Cartoonized Profiles &rarr;</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.pd-related-row { display: flex; gap: .75rem; flex-wrap: wrap; }
.pd-related-row .btn { white-space: normal; text-align: center; }
.bs-flag { margin-bottom: 1.25rem; }
.bs-flag .badge { white-space: normal; }
.bs-research { font-size: 1.0625rem; line-height: 1.85; color: #a0a8c0; margin-bottom: 1rem; }
.bs-research strong { color: #c4c8f0; }
</style>
