---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectPageHero from '../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../components/ProjectDetailSections.astro';
import { DEEP_KORE } from '../../data/projects';
---

<Layout
  title="Deep Kore | Recursive Relational Intelligence | ByteLite LLC"
  description="Deep Kore is ByteLite LLC's private deterministic reasoning substrate — lawful structure, relation edges, and auditability, with AIya as its human-facing layer."
  keywords="Deep Kore, deterministic reasoning, relational intelligence, AIya, ByteLite LLC"
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Technologies', href: '/technologies' }, { label: 'Deep Kore' }]} /></div>
  </section>

  <ProjectPageHero project={DEEP_KORE} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Mission</p>
      <h2 style="margin-bottom:1.25rem;">Reasoning that can preserve, not just predict.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;">{DEEP_KORE.mission}</p>
      <div class="dk-stance">
        <div class="dk-stance-item"><span class="dk-no">&#10005;</span>Not a public AI product</div>
        <div class="dk-stance-item"><span class="dk-no">&#10005;</span>No architecture details are public</div>
        <div class="dk-stance-item"><span class="dk-no">&#10005;</span>Not a public commercial product</div>
        <div class="dk-stance-item"><span class="dk-yes">&#10003;</span>Safety-first and proof-gated principles govern all research</div>
        <div class="dk-stance-item"><span class="dk-yes">&#10003;</span>Internal mechanisms remain private during validation</div>
      </div>
    </div>
  </section>

  <ProjectDetailSections project={DEEP_KORE} />

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Related</p>
      <div class="pd-related-row">
        <a href="/architecture" class="btn btn-outline btn-sm">The Complete Architecture</a>
        <a href="/technologies/deep-kore/aiya" class="btn btn-outline btn-sm">AIya &rarr;</a>
        <a href="/technologies/deep-kore/genesis-goalkeeper" class="btn btn-outline btn-sm">Genesis Goalkeeper &rarr;</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.dk-stance { display: flex; flex-direction: column; gap: .875rem; margin-top: 1.75rem; }
.dk-stance-item { display: flex; align-items: center; gap: .875rem; font-size: .9375rem; color: #a0a8c0; }
.dk-no { color: #f87171; font-size: 1rem; flex-shrink: 0; width: 1.25rem; text-align: center; }
.dk-yes { color: #34d399; font-size: 1rem; flex-shrink: 0; width: 1.25rem; text-align: center; }
.pd-related-row { display: flex; gap: .75rem; flex-wrap: wrap; }
</style>
