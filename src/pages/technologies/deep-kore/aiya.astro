---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProjectPageHero from '../../../components/ProjectPageHero.astro';
import ProjectDetailSections from '../../../components/ProjectDetailSections.astro';
import { AIYA } from '../../../data/projects';
---

<Layout
  title="AIya | Human-Facing Structured Intelligence | ByteLite LLC"
  description="AIya is the human-facing interaction layer built over Deep Kore. Research preview only — not a production AI system."
  keywords="AIya, Deep Kore, human-facing AI interface, ByteLite LLC"
>
  <Header slot="header" />

  <section class="section-sm">
    <div class="container"><Breadcrumbs items={[{ label: 'Technologies', href: '/technologies' }, { label: 'Deep Kore', href: '/technologies/deep-kore' }, { label: 'AIya' }]} /></div>
  </section>

  <ProjectPageHero project={AIYA} />

  <section class="section section-alt">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Mission</p>
      <h2 style="margin-bottom:1.25rem;">The mouth does not rewrite the bones.</h2>
      <p style="font-size:1.0625rem;line-height:1.8;">{AIYA.mission}</p>
      <p style="font-size:1.0625rem;line-height:1.8;margin-top:1rem;">
        Inside Cordel Connect, AIya appears as a research-preview "wingman" surface —
        explicitly labeled and never presented as a real person. It has no production deployment
        anywhere else.
      </p>
    </div>
  </section>

  <ProjectDetailSections project={AIYA} />

  <section class="section">
    <div class="container" style="max-width:820px;">
      <p class="eyebrow">Related</p>
      <div class="pd-related-row">
        <a href="/technologies/deep-kore" class="btn btn-outline btn-sm">Deep Kore &rarr;</a>
        <a href="/products/cordel-connect/aiya-and-aion" class="btn btn-outline btn-sm">AIya &amp; Aion in Cordel Connect &rarr;</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
.pd-related-row { display: flex; gap: .75rem; flex-wrap: wrap; }
.pd-related-row .btn { white-space: normal; text-align: center; }
</style>
