---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/site/PageIntro.astro';
import StatusBadge from '../components/site/StatusBadge.astro';
import { PUBLIC_MILESTONES } from '../data/milestones';
import { researchProgram } from '../data/research-programs';
import { EVIDENCE_STATUS_DEFINITIONS, EVIDENCE_SCOPE_LABEL } from '../data/evidence-status';
import { EVIDENCE_STAGES } from '../data/evidence-stages';
import { COMPANY_NAME } from '../data/company';

const EVALUATION_REQUIREMENTS = [
  'A specific published claim to test, chosen from the milestone record.',
  'Inputs and acceptance criteria agreed in writing before any run.',
  'Conditions controlled by the evaluator, with results reported by the evaluator.',
  'No disclosure of proprietary methods. An evaluation tests observable behaviour.',
];
---

<Layout
  title={`Validation | ${COMPANY_NAME}`}
  description="How ByteLite LLC classifies evidence, the current evidence for every public milestone, and how to propose an independent evaluation. None of it has been independently verified."
  path="/validation"
>
  <PageIntro
    eyebrow="Validation"
    heading="What has been shown, and by whom."
    lede="Every result on this site is labelled with how strong its evidence is, and who produced it."
  >
    <p class="notice"><strong>All evidence to date is internal. None of it has been independently verified.</strong></p>
  </PageIntro>

  <section class="section" aria-labelledby="ladder-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Classifications</p>
        <h2 id="ladder-heading">Five stages. Never merged.</h2>
      </div>
      <ol class="stage-ladder">
        {EVIDENCE_STAGES.map((stageName, stageIndex) => (
          <li><span class="stage-ladder-number" aria-hidden="true">{stageIndex + 1}</span><span>{stageName}</span></li>
        ))}
      </ol>
      <p class="stage-ladder-note">Everything on this site today has reached at most stage 3, tested in-house.</p>
      <dl class="classification-list">
        {EVIDENCE_STATUS_DEFINITIONS.map((definition) => (
          <div class="classification">
            <dt><StatusBadge status={definition.status} /></dt>
            <dd>
              {definition.meaning}
              <span class="classification-scope">{EVIDENCE_SCOPE_LABEL[definition.evidenceScope]}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section-sunken" aria-labelledby="register-heading">
    <div class="wrap">
      <div class="section-heading">
        <p class="eyebrow">Current evidence</p>
        <h2 id="register-heading">Every public milestone at a glance.</h2>
        <p class="lede">Select a milestone for what has and has not been demonstrated.</p>
      </div>
      <table class="data-table data-table-stacked">
        <caption>Public milestones, their status and the scope of their evidence.</caption>
        <thead>
          <tr>
            <th scope="col">Milestone</th>
            <th scope="col">Program</th>
            <th scope="col">Status</th>
            <th scope="col">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {PUBLIC_MILESTONES.map((milestone) => (
            <tr>
              <th scope="row"><a href={`/research/milestones#${milestone.id}`}>{milestone.title}</a></th>
              <td data-label="Program">{researchProgram(milestone.programId).name}</td>
              <td data-label="Status"><StatusBadge status={milestone.status} /></td>
              <td data-label="Evidence">{EVIDENCE_SCOPE_LABEL[milestone.evidenceScope]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="evaluation-heading">
    <div class="wrap split">
      <div class="prose">
        <p class="eyebrow">Independent evaluation</p>
        <h2 id="evaluation-heading">How to evaluate a claim.</h2>
        <p>
          {COMPANY_NAME} wants its claims tested by people outside the company. An evaluation would
          need:
        </p>
        <ul class="fact-list fact-list-plain">{EVALUATION_REQUIREMENTS.map((item) => <li>{item}</li>)}</ul>
        <div class="button-row">
          <a class="button button-primary" href="/contact?type=validation-partnership">Propose an evaluation</a>
        </div>
      </div>
      <div class="prose">
        <p class="eyebrow">What internal evidence means here</p>
        <h2>Internal tests, stated as internal tests.</h2>
        <p>
          It shows something works as designed. It is not a substitute for someone else checking,
          which is why we invite evaluation.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .stage-ladder { list-style: none; display: grid; gap: var(--space-2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr)); margin-bottom: var(--space-3); }
  .stage-ladder li { display: flex; gap: var(--space-3); align-items: center; padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); font-weight: 700; color: var(--color-ink); }
  .stage-ladder li:nth-child(-n+3) { border-color: var(--tone-tested-line); background: var(--tone-tested-bg); color: var(--tone-tested-ink); }
  .stage-ladder-number { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; flex-shrink: 0; border-radius: 50%; border: 2px solid currentColor; font-family: var(--font-mono); font-size: var(--text-sm); }
  .stage-ladder-note { font-size: var(--text-sm); margin-bottom: var(--space-6); }
  .classification-list { display: grid; gap: var(--space-3); margin: 0; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); }
  .classification { display: grid; gap: var(--space-2); padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-md); }
  .classification dd { margin: 0; display: grid; gap: var(--space-1); font-size: var(--text-sm); color: var(--color-ink-muted); }
  .classification-scope { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-ink-subtle); }
  .data-table tbody th a { color: var(--color-ink); }
</style>
