{
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "thebytelite.com" }], "destination": "https://www.thebytelite.com/", "statusCode": 308 },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "thebytelite.com" }], "destination": "https://www.thebytelite.com/:path", "statusCode": 308 },

    { "source": "/how-it-works", "destination": "/research/data-representation", "statusCode": 301 },
    { "source": "/research/deterministic-structural-cognition", "destination": "/research/machine-cognition", "statusCode": 301 },
    { "source": "/research/plain-english", "destination": "/research", "statusCode": 301 },

    { "source": "/architecture", "destination": "/research", "statusCode": 301 },
    { "source": "/architecture/governance-and-intrinsic-halting", "destination": "/research/machine-cognition", "statusCode": 301 },
    { "source": "/architecture/proof-and-claim-posture", "destination": "/validation", "statusCode": 301 },
    { "source": "/architecture/:path*", "destination": "/research", "statusCode": 301 },

    { "source": "/progress", "destination": "/research/milestones", "statusCode": 301 },
    { "source": "/progress/validation-evidence", "destination": "/validation", "statusCode": 301 },
    { "source": "/progress/:path*", "destination": "/research/milestones", "statusCode": 301 },

    { "source": "/company", "destination": "/about", "statusCode": 301 },
