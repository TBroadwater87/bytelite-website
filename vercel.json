    { "source": "/technologies", "destination": "/research", "statusCode": 301 },
    { "source": "/technologies/bytelite", "destination": "/research/data-representation", "statusCode": 301 },

    { "source": "/preorder", "destination": "/founder-access", "statusCode": 301 },
    { "source": "/preorder/:path*", "destination": "/founder-access", "statusCode": 301 },

    { "source": "/cordel-connect", "destination": "/compatibility-app", "statusCode": 301 },
    { "source": "/products/cordel-connect", "destination": "/compatibility-app", "statusCode": 301 },
    { "source": "/products/cordel-connect/:path*", "destination": "/compatibility-app", "statusCode": 301 },
    { "source": "/products/cordel-play", "destination": "/cordel-play", "statusCode": 301 },
    { "source": "/products/cordel-play/:path*", "destination": "/cordel-play", "statusCode": 301 },
    { "source": "/heartstrings", "destination": "/cordel-play", "statusCode": 301 },
    { "source": "/heartstrings-app", "destination": "/compatibility-app", "statusCode": 301 },
    { "source": "/products/heartstrings-play", "destination": "/cordel-play", "statusCode": 301 },
    { "source": "/products/heartstrings-play/:path*", "destination": "/cordel-play", "statusCode": 301 },
    { "source": "/products/heartstrings-connect", "destination": "/compatibility-app", "statusCode": 301 },
    { "source": "/products/heartstrings-connect/:path*", "destination": "/compatibility-app", "statusCode": 301 },

    { "source": "/status", "destination": "/research/milestones", "statusCode": 301 },
    { "source": "/proof", "destination": "/validation", "statusCode": 301 },
    { "source": "/news", "destination": "/research/milestones", "statusCode": 301 },
    { "source": "/technology", "destination": "/research", "statusCode": 301 },
    { "source": "/demo", "destination": "/research", "statusCode": 301 },
    { "source": "/ethics", "destination": "/research/approaches-to-ai", "statusCode": 301 },
    { "source": "/pricing", "destination": "/licensing", "statusCode": 301 },
    { "source": "/subscribe", "destination": "/founder-access", "statusCode": 301 },
    { "source": "/support-us", "destination": "/support", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/technologies/bytesight", "destination": "/api/gone" },
    { "source": "/technologies/deep-kore", "destination": "/api/gone" },
    { "source": "/technologies/deep-kore/:path*", "destination": "/api/gone" },
    { "source": "/deepkore", "destination": "/api/gone" },
    { "source": "/deepkore-lab", "destination": "/api/gone" },
    { "source": "/ai-safety", "destination": "/api/gone" },
    { "source": "/technologies/byteoracle", "destination": "/api/gone" },
    { "source": "/technologies/byteflow", "destination": "/api/gone" },
    { "source": "/technologies/bytecost", "destination": "/api/gone" },
    { "source": "/technologies/:path*", "destination": "/api/gone" },
    { "source": "/marketing", "destination": "/api/gone" },
    { "source": "/marketing/:path*", "destination": "/api/gone" },
    { "source": "/api/deepkore-submit", "destination": "/api/gone" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
