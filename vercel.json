{
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "thebytelite.com" }], "destination": "https://www.thebytelite.com/", "statusCode": 308 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "thebytelite.com" }], "destination": "https://www.thebytelite.com/:path*", "statusCode": 308 },
    { "source": "/heartstrings", "destination": "/products/cordel-play", "statusCode": 301 },
    { "source": "/heartstrings-app", "destination": "/products/cordel-connect", "statusCode": 301 },
    { "source": "/status", "destination": "/progress", "statusCode": 301 },
    { "source": "/technology", "destination": "/technologies", "statusCode": 301 },
    { "source": "/products/cordel-connect/byteoracle-horoscopes", "destination": "/products/cordel-connect/horoscopes", "statusCode": 301 },
    { "source": "/deepkore", "destination": "/technologies/deep-kore", "statusCode": 301 },
    { "source": "/deepkore-lab", "destination": "/technologies/deep-kore", "statusCode": 301 },
    { "source": "/marketing", "destination": "/products/cordel-connect/date-planning/restaurants/partner-program", "statusCode": 301 },
    { "source": "/ethics", "destination": "/architecture/proof-and-claim-posture", "statusCode": 301 },
    { "source": "/ai-safety", "destination": "/architecture/governance-and-intrinsic-halting", "statusCode": 301 },
    { "source": "/news", "destination": "/progress/changelog", "statusCode": 301 },
    { "source": "/subscribe", "destination": "/preorder", "statusCode": 301 },
    { "source": "/demo", "destination": "/how-it-works", "statusCode": 301 },
    { "source": "/pricing", "destination": "/licensing", "statusCode": 301 },
    { "source": "/proof", "destination": "/validation", "statusCode": 301 },
    { "source": "/products/heartstrings-play", "destination": "/products/cordel-play", "statusCode": 301 },
    { "source": "/products/heartstrings-play/:path*", "destination": "/products/cordel-play/:path*", "statusCode": 301 },
    { "source": "/products/heartstrings-connect", "destination": "/products/cordel-connect", "statusCode": 301 },
    { "source": "/products/heartstrings-connect/:path*", "destination": "/products/cordel-connect/:path*", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.thebytelite.com; manifest-src 'self'; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
